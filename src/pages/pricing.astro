---
import Base from '../layouts/Base.astro';
import DownloadBand from '../components/DownloadBand.astro';
import Icon from '../components/Icon.astro';
import CompareTable from '../components/pricing/CompareTable.astro';
import Faq from '../components/pricing/Faq.astro';
import PlanCards from '../components/pricing/PlanCards.astro';
import { site } from '../config/site';
---

<Base
  title="Pricing · Trace"
  description="Trace is free for one project. Pro and Team add unlimited projects, full history, more export formats and team review."
  sheet="pricing"
>
  <section class="pricing" aria-labelledby="pricing-title" data-row>
    <div class="container">
      <div class="grid intro">
        <h1 id="pricing-title" class="intro__title pad">
          Pricing
        </h1>
        <p class="lead intro__lead pad">
          Start free with one project. Pay when you need more projects, the full history or team
          review.
        </p>
      </div>

      <PlanCards />

      <div class="grid enterprise">
        <h2 class="enterprise__name pad">Enterprise</h2>
        <p class="enterprise__text pad">
          Single sign-on, audit log export, private deployment and a named contact for your company.
        </p>
        <div class="enterprise__actions pad">
          <a class="btn btn--secondary btn--sm" href={`mailto:${site.salesEmail}`}>
            <Icon name="mail" size={18} />
            Contact sales
          </a>
          <p class="enterprise__email mono">{site.salesEmail}</p>
        </div>
      </div>
    </div>
  </section>

  <CompareTable />
  <Faq />
  <DownloadBand />
</Base>

<style>
  .pricing {
    padding-block: var(--sp-5) var(--section-pad);
  }

  .intro {
    row-gap: var(--sp-2);
    margin-bottom: var(--sp-5);
  }

  .intro__title,
  .intro__lead {
    grid-column: 1 / -1;
  }

  .intro__title {
    font-size: clamp(2.75rem, 1rem + 5.2vw, var(--s10));
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .intro__lead {
    max-width: 44ch;
  }

  .enterprise {
    row-gap: var(--sp-2);
    margin-top: var(--sp-3);
    padding: var(--sp-3);
    border: 1px solid var(--line-strong);
  }

  .enterprise__name,
  .enterprise__text,
  .enterprise__actions {
    grid-column: 1 / -1;
  }

  .enterprise__name {
    font-family: var(--font-body);
    font-size: var(--s1);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .enterprise__text {
    max-width: 52ch;
    color: var(--text-muted);
  }

  .enterprise__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sp-1) var(--sp-3);
  }

  .enterprise__email {
    font-size: var(--s-1);
    color: var(--text-muted);
    user-select: all;
  }

  /*
   * Desktop: the title sits over zones 1 to 4 and the lead beside it. Under
   * the plans, Enterprise is one more row of the band, on the same zone
   * lines; the next section's rule closes it.
   */
  @media (min-width: 64rem) {
    .pricing {
      padding-block: var(--sp-8) 0;
    }

    .intro {
      align-items: end;
      margin-bottom: var(--sp-8);
    }

    .intro__title {
      grid-column: 1 / span 4;
    }

    .intro__lead {
      grid-column: 5 / span 4;
    }

    .enterprise {
      row-gap: 0;
      margin-top: 0;
      padding: 0;
      border: 0;
    }

    .enterprise__name,
    .enterprise__text,
    .enterprise__actions {
      display: flex;
      align-items: center;
      padding-block: var(--sp-3);
    }

    .enterprise__name {
      grid-column: 1 / span 2;
    }

    .enterprise__text {
      grid-column: 3 / span 4;
      max-width: none;
      border-left: var(--rule) solid var(--text-strong);
    }

    .enterprise__actions {
      grid-column: 7 / span 2;
      justify-content: space-between;
      border-left: var(--rule) solid var(--text-strong);
    }
  }
</style>
