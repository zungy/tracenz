---
/**
 * The sample design document on its own, at full size, for printing. The
 * PDF offered on the home page (public/samples/TR-0142-rev-b.pdf) is this
 * page printed to A4; see "Sample document" in the README.
 */
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/600.css';
import '@fontsource/barlow-semi-condensed/500.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource/ibm-plex-mono/600.css';
import '../../styles/global.css';
import DocPage from '../../components/home/DocPage.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>TR-0142 Rev B · Sample design document · Trace</title>
  </head>
  <body class="print">
    <main class="scheme-paper">
      <DocPage id="print" />
    </main>
  </body>
</html>

<style is:global>
  @page {
    size: A4;
    margin: 0;
  }

  body.print {
    --u: 1px;
    min-height: 0;
    padding: 0;
    background: #fff;
  }
</style>
