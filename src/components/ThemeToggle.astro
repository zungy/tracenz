---
/**
 * Paper / Blueprint switch. Until the visitor picks one, the site follows the
 * system setting and the switch shows whichever is in effect. A choice is
 * remembered in localStorage and applied before first paint (see Base.astro).
 */
interface Props {
  /** Unique per instance on a page, e.g. "header" or "menu". */
  id: string;
}

const { id } = Astro.props;
const options = [
  { value: 'light', label: 'Paper' },
  { value: 'dark', label: 'Blueprint' },
];
---

<fieldset class="theme-toggle" data-theme-toggle>
  <legend class="visually-hidden">View</legend>
  {options.map((option) => (
    <label for={`theme-${id}-${option.value}`}>
      <input
        type="radio"
        id={`theme-${id}-${option.value}`}
        name={`theme-${id}`}
        value={option.value}
        checked={option.value === 'light'}
      />
      <span>{option.label}</span>
    </label>
  ))}
</fieldset>

<style>
  .theme-toggle {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  label {
    position: relative;
    cursor: pointer;
  }

  input {
    position: absolute;
    inset: 0;
    opacity: 0;
    margin: 0;
    cursor: pointer;
  }

  span {
    display: block;
    padding: 0.3rem 0.55rem;
    border-radius: 1px;
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.02em;
    color: var(--text-muted);
  }

  label:hover span {
    color: var(--text-strong);
  }

  input:checked + span {
    background: var(--text-strong);
    color: var(--bg);
  }

  input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
</style>

<script>
  const KEY = 'trace-theme';
  const root = document.documentElement;
  const groups = [...document.querySelectorAll<HTMLElement>('[data-theme-toggle]')];
  const inputs = groups.flatMap((g) => [
    ...g.querySelectorAll<HTMLInputElement>('input[type="radio"]'),
  ]);

  function effectiveTheme(): 'light' | 'dark' {
    const set = root.dataset.theme;
    if (set === 'light' || set === 'dark') return set;
    return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
  }

  function sync() {
    const current = effectiveTheme();
    for (const input of inputs) input.checked = input.value === current;
  }

  for (const input of inputs) {
    input.addEventListener('change', () => {
      root.dataset.theme = input.value;
      try {
        localStorage.setItem(KEY, input.value);
      } catch {
        // Storage can be unavailable; the choice still applies to this page view.
      }
      sync();
    });
  }

  window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', sync);
  sync();
</script>
