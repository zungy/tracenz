---
/** Email account access for the same Supabase project as Trace desktop. */
import Icon from '../Icon.astro';

interface Props {
  mode: 'login' | 'signup';
}

const { mode } = Astro.props;
const isLogin = mode === 'login';
---

<div class="auth">
  <nav class="tabs" aria-label="Log in or sign up">
    <a href="/login" aria-current={isLogin ? 'page' : undefined}>
      Log in
    </a>
    <a href="/signup" aria-current={isLogin ? undefined : 'page'}>
      Sign up
    </a>
  </nav>

  <div class="auth__intro">
    <h1>{isLogin ? 'Log in to Trace' : 'Create your Trace account'}</h1>
    <p>
      {isLogin
        ? 'View the traces saved by your desktop app.'
        : 'One account for Trace on your desktop and the web.'}
    </p>
  </div>

  <form class="form" novalidate data-auth-form data-mode={mode}>
    {!isLogin && (
      <div class="field">
        <label for="name">Full name</label>
        <input
          id="name"
          name="name"
          maxlength="120"
          type="text"
          autocomplete="name"
          required
          data-missing="Enter your name."
        />
        <p class="field__error" id="name-error" hidden />
      </div>
    )}

    <div class="field">
      <label for="email">Email</label>
      <input
        id="email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        spellcheck="false"
        required
        data-missing="Enter your email address."
        data-invalid="Enter an email address like name@company.com."
      />
      <p class="field__error" id="email-error" hidden></p>
    </div>

    <div class="field">
      <div class="field__label-row">
        <label for="password">Password</label>
      </div>
      <div class="field__control">
        <input
          id="password"
          name="password"
          type="password"
          autocomplete={isLogin ? 'current-password' : 'new-password'}
          required
          minlength={isLogin ? undefined : 8}
          aria-describedby={isLogin ? undefined : 'password-hint'}
          data-missing="Enter your password."
          data-short="Use at least 8 characters."
        />
        <button
          class="field__toggle"
          type="button"
          aria-label="Show password"
          aria-controls="password"
          aria-pressed="false"
          data-password-toggle
        >
          <Icon name="eye" size={20} class="toggle-show" />
          <Icon name="eye-off" size={20} class="toggle-hide" />
        </button>
      </div>
      {!isLogin && (
        <p class="field__hint" id="password-hint">
          At least 8 characters.
        </p>
      )}
      <p class="field__error" id="password-error" hidden></p>
    </div>

    {isLogin && (
      <label class="check" for="remember">
        <input id="remember" name="remember" type="checkbox" />
        <span>Keep me logged in on this device</span>
      </label>
    )}

    <noscript>
      <p class="field__hint">Email authentication needs JavaScript enabled.</p>
    </noscript>

    <button class="btn btn--primary btn--block" type="submit" disabled data-auth-submit>
      {isLogin ? 'Log in' : 'Create account'}
    </button>

    <p class="form__status" role="status" aria-live="polite" data-status></p>
  </form>

  <div class="auth__next" data-signup-next hidden>
    <p>Return to the Trace desktop app and log in with these details, or view your traces here.</p>
    <a class="btn btn--primary btn--block" href="/login">
      Log in on the web
    </a>
    <a class="btn btn--secondary btn--block" href="/download">
      Download Trace for Windows
    </a>
  </div>

  <p class="auth__switch">
    {isLogin ? (
      <>
        New to Trace? <a href="/signup">Create an account</a>
      </>
    ) : (
      <>
        Already have an account? <a href="/login">Log in</a>
      </>
    )}
  </p>
</div>

<style>
  .auth {
    display: grid;
    gap: var(--sp-3);
    width: 100%;
    max-width: 26rem;
  }

  /* Log in / Sign up switch */
  .tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    border-bottom: 1px solid var(--line);
  }

  .tabs a {
    padding-block: 0.75rem;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    color: var(--text-muted);
    font-weight: 600;
    text-align: center;
    text-decoration: none;
  }

  .tabs a:hover {
    color: var(--text-strong);
  }

  .tabs a[aria-current='page'] {
    border-bottom-color: var(--text-strong);
    color: var(--text-strong);
  }

  .auth__intro {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-2);
  }

  .auth__intro h1 {
    font-size: clamp(var(--s3), 1.3rem + 1.4vw, 2.378rem);
  }

  .auth__intro p {
    color: var(--text-muted);
  }

  /* Fields */
  .form {
    display: grid;
    gap: var(--sp-3);
  }

  .field {
    display: grid;
    gap: 0.4rem;
  }

  .field label,
  .field__label-row {
    font-weight: 600;
    color: var(--text-strong);
  }

  .field__label-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .field__label-row a {
    font-size: var(--s-1);
    font-weight: 500;
  }

  .field__control {
    position: relative;
  }

  input:not([type='checkbox']) {
    width: 100%;
    min-height: 3rem;
    padding: 0 0.875rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--surface);
    color: var(--text-strong);
    font-size: var(--s0);
  }

  input:not([type='checkbox']):hover {
    border-color: var(--text-muted);
  }

  input:not([type='checkbox']):focus-visible {
    border-color: var(--accent);
    outline: 2px solid var(--focus);
    outline-offset: 1px;
  }

  #password {
    padding-right: 3rem;
  }

  /* Errors use weight and an icon instead of a new hue, to stay in the palette. */
  input[aria-invalid='true'] {
    border: 2px solid var(--text-strong);
  }

  .field__error {
    display: flex;
    gap: 0.4rem;
    align-items: start;
    font-size: var(--s-1);
    font-weight: 600;
    color: var(--text-strong);
  }

  .field__error::before {
    content: '!';
    display: grid;
    place-items: center;
    flex: none;
    width: 1.1rem;
    height: 1.1rem;
    margin-top: 0.1rem;
    border-radius: 50%;
    background: var(--text-strong);
    color: var(--bg);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .field__error[hidden] {
    display: none;
  }

  .field__hint {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .field__toggle {
    position: absolute;
    top: 50%;
    right: 0.25rem;
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 0;
    border-radius: var(--radius);
    background: none;
    color: var(--text-muted);
    transform: translateY(-50%);
  }

  .field__toggle:hover {
    color: var(--text-strong);
  }

  .field__toggle :global(.toggle-hide),
  .field__toggle[aria-pressed='true'] :global(.toggle-show) {
    display: none;
  }

  .field__toggle[aria-pressed='true'] :global(.toggle-hide) {
    display: block;
  }

  /* .form raises specificity above `.field label`, which would make this bold. */
  .form .check {
    display: flex;
    gap: 0.625rem;
    align-items: start;
    font-weight: 400;
    color: var(--text);
    cursor: pointer;
  }

  .form .check input {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin-top: 0.2rem;
    accent-color: var(--accent);
  }

  .form__status:empty {
    display: none;
  }

  .form__status {
    padding: 0.75rem var(--sp-2);
    border: 1px dashed var(--line-strong);
    border-radius: var(--radius);
    background: var(--tint);
    font-size: var(--s-1);
    color: var(--text-strong);
  }

  .auth__next {
    display: grid;
    gap: var(--sp-2);
  }

  .auth__next[hidden],
  .form[hidden] {
    display: none;
  }

  .auth__switch {
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
    color: var(--text-muted);
  }
</style>

<script>
  import '../../scripts/auth';
</script>
