---
/**
 * Log in and sign up share one sheet: the form, and beside it a Paper
 * panel with the housing from the home page, cut open where revision B
 * changed it, over the log entry that recorded the change. On desktop both
 * are cells between the header's and the footer's rules: the form in zones
 * 1 to 4, the panel in zones 5 to 8.
 */
import ModelView from '../ModelView.astro';
import AuthForm from './AuthForm.astro';

interface Props {
  mode: 'login' | 'signup';
}

const { mode } = Astro.props;
---

<section class="account" data-row>
  <div class="container grid account__grid">
    <div class="account__form">
      <AuthForm mode={mode} />
    </div>

    <aside class="panel scheme-paper" aria-label="Example from the change log">
      <p class="panel__label mono">
        <span>Housing, Rev B</span>
        <span>Quarter section</span>
      </p>
      <ModelView
        class="panel__model"
        alt="The sander housing with a quarter cut away. The motor mount wall inside, which changed in revision B, is drawn in red."
        intro
      />
      <div class="panel__foot">
        <p class="entry">
          <time class="entry__time mono num">09:12</time>
          <span class="entry__what">
            <strong>Sketch 4</strong>
            <span>D3</span>
          </span>
          <span class="entry__change mono num">
            <span class="visually-hidden">from </span>
            <del>2.0</del>
            <span class="entry__arrow" aria-hidden="true">
              →
            </span>
            <span class="visually-hidden"> to </span>
            <ins>2.5</ins>
          </span>
        </p>
        <p class="panel__caption">
          Trace logged the thicker wall with its value before and after. The design document cites
          this entry in section 2.1.
        </p>
      </div>
    </aside>
  </div>
</section>

<style>
  .account__grid {
    row-gap: var(--sp-5);
  }

  .account__form {
    grid-column: 1 / -1;
    display: grid;
    justify-items: start;
    padding-block: var(--sp-5) var(--sp-8);
  }

  .panel {
    display: none;
  }

  /*
   * Desktop: the form is centred in zones 1 to 4; the panel fills zones 5 to
   * 8 from the header's rule to the footer's.
   */
  @media (min-width: 64rem) {
    .account__grid {
      align-items: stretch;
    }

    .account__form {
      grid-column: 1 / span 4;
      justify-items: center;
      align-content: center;
      padding: var(--sp-8) var(--pad);
    }

    .panel {
      position: relative;
      isolation: isolate;
      grid-column: 5 / span 4;
      display: grid;
      grid-template-rows: auto 1fr auto;
      gap: var(--sp-3);
      padding: var(--sp-5) var(--pad);
    }
  }

  .panel__label {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.625rem;
    border-bottom: 1px solid var(--line);
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .panel :global(.panel__model) {
    align-self: center;
  }

  .panel__foot {
    display: grid;
    gap: var(--sp-2);
  }

  /* The log entry, as the active row of the hero's log. */
  .entry {
    display: grid;
    grid-template-columns: 2.625rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
    height: 2.75rem;
    padding-inline: var(--sp-2);
    border: 1px solid var(--line);
    background: var(--change-tint);
    box-shadow: inset 2px 0 0 var(--change);
    font-size: var(--s-1);
  }

  .entry__time {
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  .entry__what {
    display: flex;
    gap: 0.4rem;
    color: var(--text-muted);
  }

  .entry__change {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
    font-size: var(--s-2);
  }

  .entry__change del {
    color: var(--text-muted);
    text-decoration-color: var(--change);
    text-decoration-thickness: 1.5px;
  }

  .entry__arrow {
    color: var(--text-faint);
  }

  .entry__change ins {
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
  }

  .panel__caption {
    max-width: 44ch;
    font-size: var(--s-1);
    color: var(--text-muted);
  }
</style>
