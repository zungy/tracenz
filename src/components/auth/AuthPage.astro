---
import AuthForm from './AuthForm.astro';
import PadDrawing from './PadDrawing.astro';

interface Props {
  mode: 'login' | 'signup';
}

const { mode } = Astro.props;
---

<div class="page">
  <div class="container grid page__grid">
    <div class="page__form">
      <AuthForm mode={mode} />
    </div>

    <aside class="panel scheme-blueprint" aria-label="Example from the change log">
      <div class="panel__inner">
        <p class="panel__label label">
          <span>Detail D</span>
          <span>Sanding pad</span>
        </p>
        <PadDrawing />
        <div class="panel__log">
          <span class="panel__mark" aria-hidden="true"></span>
          <time class="num">10:26</time>{' '}
          <span>
            <strong>Hole 3</strong> Diameter
          </span>{' '}
          <span class="panel__change num">
            <span class="visually-hidden">from </span>
            <del class="old-value">Ø8</del>
            <span aria-hidden="true">→</span>
            <span class="visually-hidden"> to </span>
            <ins class="new-value">Ø9</ins>
          </span>
        </div>
        <p class="panel__caption">
          Every dimension you change is logged with its value before and after.
        </p>
      </div>
    </aside>
  </div>
</div>

<style>
  .page {
    padding-block: var(--sp-5) var(--sp-8);
  }

  .page__grid {
    row-gap: var(--sp-5);
    align-items: start;
  }

  .page__form {
    grid-column: 1 / -1;
    display: grid;
    justify-items: start;
  }

  .panel {
    display: none;
  }

  @media (min-width: 64rem) {
    .page {
      padding-block: var(--sp-8);
    }

    .page__form {
      grid-column: 2 / span 6;
    }

    /* Blueprint sheet with a 32px square grid, four 8px units per square. */
    .panel {
      display: block;
      grid-column: 9 / -1;
      border-radius: var(--radius);
      background-image:
        linear-gradient(var(--line-soft) 1px, transparent 1px),
        linear-gradient(90deg, var(--line-soft) 1px, transparent 1px);
      background-size: 32px 32px;
      background-position: -1px -1px;
    }
  }

  .panel__inner {
    position: relative;
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-5);
  }

  .panel__label {
    display: flex;
    justify-content: space-between;
    padding-bottom: 0.6rem;
    border-bottom: 1px solid var(--line);
  }

  .panel__log {
    position: relative;
    display: grid;
    grid-template-columns: 0.5rem 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.6rem var(--sp-2);
    border: 1px solid var(--line);
    background: var(--surface);
    font-size: var(--s-1);
  }

  .panel__mark {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
  }

  .panel__log time {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .panel__log strong {
    margin-right: 0.4rem;
  }

  .panel__change {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
  }

  .panel__caption {
    max-width: 34ch;
    color: var(--text-muted);
  }
</style>
