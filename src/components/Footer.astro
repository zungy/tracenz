---
/**
 * Footer laid out as a drawing's title block, and every cell does a job: the
 * title and sheet number say where you are, the sheet row moves between the
 * site's three sheets, and the view cell switches Paper and Blueprint. On
 * desktop the block sits in the bottom-right corner of the sheet border and
 * shares its lines, as on a real sheet.
 */
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, sheetCount, sheets, site, type SheetKey } from '../config/site';

interface Props {
  sheet: SheetKey | null;
}

const { sheet } = Astro.props;
const current = sheet ? sheets[sheet] : null;
const year = new Date().getFullYear();
const index = (Object.keys(sheets) as SheetKey[]).map((key) => ({ key, ...sheets[key] }));
---

<footer class="footer">
  <div class="container grid footer__grid">
    <div class="footer__about">
      <Brand />
      <p>{site.description}</p>
      <nav class="footer__links" aria-label="Footer">
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
          <li>
            <a href="/login">Log in</a>
          </li>
          <li>
            <a href="/signup">Sign up</a>
          </li>
        </ul>
      </nav>
    </div>

    <div class="titleblock">
      <div class="cell cell--title">
        <p class="label">Title</p>
        <p class="cell__title">{current ? current.title : 'Page not found'}</p>
      </div>
      <div class="cell">
        <p class="label">Sheet</p>
        <p class="cell__value num">
          {current ? `${current.number} of ${sheetCount}` : `– of ${sheetCount}`}
        </p>
      </div>

      <nav class="cell cell--sheets" aria-label="Sheets">
        <ul>
          {index.map((s) => (
            <li>
              <a href={s.href} aria-current={sheet === s.key ? 'page' : undefined}>
                <span class="num">{s.number}</span>
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="cell cell--view">
        <p class="label" aria-hidden="true">
          View
        </p>
        <ThemeToggle id="footer" />
      </div>
      <div class="cell cell--copy">
        <p class="num">© {year} Trace</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--section-pad);
    padding-bottom: var(--sp-5);
    background: var(--bg);
    border-top: 1px solid var(--line-strong);
  }

  .footer__grid {
    row-gap: var(--sp-5);
    align-items: end;
  }

  .footer__about,
  .titleblock {
    grid-column: 1 / -1;
  }

  .footer__about {
    display: grid;
    gap: var(--sp-2);
    justify-items: start;
  }

  .footer__about > p {
    max-width: 38ch;
    color: var(--text-muted);
  }

  .footer__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    margin-top: var(--sp-1);
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    font-size: var(--s-1);
    color: var(--text);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  /* Title block: the 1px gaps over a line-colored ground draw the cell rules. */
  .titleblock {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 2px solid var(--text-strong);
  }

  .cell {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.75rem var(--sp-2) 0.875rem;
    background: var(--bg);
  }

  .cell--title {
    grid-column: span 2;
  }

  .cell__title {
    font-size: var(--s3);
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }

  .cell__value {
    font-family: var(--font-mono);
    font-size: var(--s0);
    font-weight: 500;
    color: var(--text-strong);
  }

  /* The sheet row is navigation; the current sheet is filled. */
  .cell--sheets {
    grid-column: 1 / -1;
    padding: 0;
  }

  .cell--sheets ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    height: 100%;
    padding: 0;
    background: var(--line);
    list-style: none;
  }

  .cell--sheets a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    min-height: 2.75rem;
    padding: 0.5rem var(--sp-2);
    background: var(--bg);
    font-size: var(--s-1);
    font-weight: 500;
    color: var(--text-strong);
    text-decoration: none;
  }

  .cell--sheets a .num {
    font-family: var(--font-mono);
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  .cell--sheets a:hover {
    background: var(--tint);
  }

  .cell--sheets a[aria-current='page'] {
    background: var(--text-strong);
    color: var(--bg);
  }

  .cell--sheets a[aria-current='page'] .num {
    color: inherit;
  }

  .cell--view {
    grid-column: span 2;
    grid-template-columns: auto auto;
    justify-content: space-between;
    align-items: center;
  }

  .cell--copy {
    align-content: center;
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  /*
   * Desktop: the block reaches the sheet border on the right and at the bottom
   * and uses the border as its own right and bottom lines.
   */
  @media (min-width: 64rem) {
    .footer {
      padding-bottom: 0;
    }

    .footer__about {
      grid-column: 1 / span 6;
      padding-bottom: var(--sp-5);
    }

    .titleblock {
      grid-column: 9 / -1;
      margin-right: calc((var(--gutter) / 2 + var(--edge)) * -1);
      border-right: 0;
      border-bottom: 0;
    }
  }
</style>
