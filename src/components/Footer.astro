---
/**
 * Footer laid out as a drawing's title block, bottom right as on a real
 * sheet. Each page is a sheet, so the block states which sheet this is.
 */
import Brand from './Brand.astro';
import { nav, sheetCount, sheets, site, type SheetKey } from '../config/site';

interface Props {
  sheet: SheetKey | null;
}

const { sheet } = Astro.props;
const current = sheet ? sheets[sheet] : null;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container grid footer__grid">
    <div class="footer__about">
      <Brand />
      <p>{site.description}</p>
      <div class="footer__links">
        <nav aria-label="Product">
          <ul>
            {nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <nav aria-label="Account">
          <ul>
            <li>
              <a href="/login">Log in</a>
            </li>
            <li>
              <a href="/signup">Sign up</a>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <dl class="titleblock">
      <div class="cell cell--title">
        <dt class="label">Title</dt>
        <dd>{current ? current.title : 'Not found'}</dd>
      </div>
      <div class="cell cell--company">
        <dt class="label">Company</dt>
        <dd>Trace</dd>
      </div>
      <div class="cell">
        <dt class="label">Sheet</dt>
        <dd class="num">{current ? `${current.number} of ${sheetCount}` : `– of ${sheetCount}`}</dd>
      </div>
      <div class="cell">
        <dt class="label">Rev</dt>
        <dd>A</dd>
      </div>
      <div class="cell">
        <dt class="label">Scale</dt>
        <dd class="num">1:1</dd>
      </div>
      <div class="cell">
        <dt class="label">Units</dt>
        <dd>mm</dd>
      </div>
      <div class="cell cell--copy">
        <dt class="visually-hidden">Copyright</dt>
        <dd class="num">© {year} Trace. All rights reserved.</dd>
      </div>
    </dl>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--sp-8) var(--sp-5);
    background: var(--bg);
    border-top: 1px solid var(--line-strong);
  }

  .footer__grid {
    row-gap: var(--sp-5);
    align-items: end;
  }

  .footer__about,
  .titleblock {
    grid-column: 1 / -1;
  }

  .footer__about {
    display: grid;
    gap: var(--sp-2);
    justify-items: start;
  }

  .footer__about > p {
    max-width: 36ch;
    color: var(--text-muted);
  }

  .footer__links {
    display: flex;
    gap: var(--sp-8);
    margin-top: var(--sp-1);
  }

  .footer__links ul {
    display: grid;
    gap: var(--sp-1);
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    color: var(--text);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  /* Title block: the 1px gaps over a line-colored ground draw the cell rules. */
  .titleblock {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1.5px solid var(--text-strong);
  }

  .cell {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.625rem 0.875rem 0.75rem;
    background: var(--bg);
  }

  .cell dd {
    font-family: var(--font-mono);
    font-size: var(--s0);
    font-weight: 500;
    color: var(--text-strong);
  }

  .cell--title,
  .cell--copy {
    grid-column: 1 / -1;
  }

  .cell--title dd {
    font-family: var(--font-display);
    font-size: var(--s3);
    font-weight: 760;
    font-stretch: 112%;
    line-height: 1.15;
  }

  .cell--copy dd {
    font-size: var(--s-2);
    font-weight: 400;
    color: var(--text-muted);
  }

  @media (min-width: 40rem) {
    .titleblock {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .cell--title {
      grid-column: span 3;
    }

    .cell--company {
      grid-column: span 1;
    }
  }

  @media (min-width: 64rem) {
    .footer__about {
      grid-column: 1 / span 6;
    }

    .titleblock {
      grid-column: 9 / -1;
    }
  }
</style>
