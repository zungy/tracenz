---
/**
 * Footer laid out as the sheet's title block. Every cell holds something
 * true: the page's title and sheet number, when the site was last built,
 * who drew it, the site's drawing number; the sheet row moves between the
 * site's three sheets, and the view cell switches Paper and Blueprint. On
 * desktop the block sits in the bottom-right corner of the sheet border and
 * shares its lines, and the left column keeps to the block's rows.
 */
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, sheetCount, sheets, site, type SheetKey } from '../config/site';

interface Props {
  sheet: SheetKey | null;
}

const { sheet } = Astro.props;
const current = sheet ? sheets[sheet] : null;
const built = new Date();
const year = built.getFullYear();
const months = 'Jan Feb Mar Apr May Jun Jul Aug Sep Oct Nov Dec'.split(' ');
const updated = `${built.getDate()} ${months[built.getMonth()]} ${year}`;
const index = (Object.keys(sheets) as SheetKey[]).map((key) => ({ key, ...sheets[key] }));
---

<footer class="footer" data-row>
  <div class="container footer__grid">
    <div class="footer__brand">
      <Brand />
    </div>
    <p class="footer__about">{site.description}</p>
    <nav class="footer__links" aria-label="Footer">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
          </li>
        ))}
        <li>
          <a href="/login">Log in</a>
        </li>
        <li>
          <a href="/signup">Sign up</a>
        </li>
      </ul>
    </nav>
    <p class="footer__legal">
      Autodesk Fusion is a trademark of Autodesk, Inc. Trace is not affiliated with Autodesk.
    </p>

    <div class="titleblock">
      <div class="cell cell--title">
        <p class="label">Title</p>
        <p class="cell__title">{current ? current.title : 'Page not found'}</p>
      </div>
      <div class="cell">
        <p class="label">Sheet</p>
        <p class="cell__value num">
          {current ? `${current.number} of ${sheetCount}` : `– of ${sheetCount}`}
        </p>
      </div>

      <div class="cell">
        <p class="label">Updated</p>
        <p class="cell__value num">{updated}</p>
      </div>
      <div class="cell">
        <p class="label">Drawn</p>
        <p class="cell__value">Trace</p>
      </div>
      <div class="cell">
        <p class="label">Dwg no.</p>
        <p class="cell__value num">TR-WEB-01</p>
      </div>

      <nav class="cell cell--sheets" aria-label="Sheets">
        <ul>
          {index.map((s) => (
            <li>
              <a href={s.href} aria-current={sheet === s.key ? 'page' : undefined}>
                <span class="num">{s.number}</span>
                {s.title}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="cell cell--view">
        <p class="label" aria-hidden="true">
          View
        </p>
        <ThemeToggle id="footer" />
      </div>
      <div class="cell cell--copy">
        <p class="num">© {year} Trace</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .footer {
    padding-top: var(--section-pad);
    padding-bottom: var(--sp-5);
    background: var(--bg);
    border-top: var(--rule) solid var(--text-strong);
  }

  .footer__grid {
    display: grid;
    gap: var(--sp-2);
    justify-items: start;
  }

  .footer__about {
    max-width: 38ch;
    color: var(--text-muted);
  }

  .footer__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-1) var(--sp-3);
    padding: 0;
    list-style: none;
  }

  .footer__links a {
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }

  .footer__links a:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  .footer__legal {
    max-width: 52ch;
    font-size: var(--s-2);
    color: var(--text-faint);
  }

  /* Title block: the 1px gaps over a line-coloured ground draw the cell rules. */
  .titleblock {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    justify-self: stretch;
    margin-top: var(--sp-3);
    background: var(--line);
    border: var(--rule-heavy) solid var(--text-strong);
  }

  .cell {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    min-width: 0;
    padding: 0.625rem var(--sp-2) 0.75rem;
    background: var(--bg);
  }

  .cell--title {
    grid-column: span 2;
  }

  .cell__title {
    font-family: var(--font-display);
    font-size: var(--s3);
    font-weight: 500;
    line-height: 1.1;
    color: var(--text-strong);
  }

  .cell__value {
    font-family: var(--font-mono);
    font-size: var(--s-1);
    font-weight: 500;
    color: var(--text-strong);
  }

  /* The sheet row is navigation; the current sheet is filled. */
  .cell--sheets {
    grid-column: 1 / -1;
    padding: 0;
  }

  .cell--sheets ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    height: 100%;
    padding: 0;
    background: var(--line);
    list-style: none;
  }

  .cell--sheets a {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    height: 100%;
    min-height: 2.75rem;
    padding: 0.5rem var(--sp-2);
    background: var(--bg);
    font-size: var(--s-1);
    font-weight: 600;
    color: var(--text-strong);
    text-decoration: none;
  }

  .cell--sheets a .num {
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 500;
    color: var(--text-muted);
  }

  .cell--sheets a:hover {
    background: var(--tint);
  }

  .cell--sheets a[aria-current='page'] {
    background: var(--text-strong);
    color: var(--bg);
  }

  .cell--sheets a[aria-current='page'] .num {
    color: inherit;
  }

  .cell--view {
    grid-column: span 2;
    grid-template-columns: auto auto;
    justify-content: space-between;
    align-items: center;
  }

  .cell--copy {
    align-content: center;
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  /*
   * Desktop: two halves on one set of rows. The title block holds zones 5 to
   * 8 and reaches the border on the right and at the bottom, using it as its
   * own lines; the left column's items sit on the block's rows.
   */
  @media (min-width: 64rem) {
    .footer {
      padding-bottom: 0;
    }

    .footer__grid {
      grid-template-columns: repeat(8, minmax(0, 1fr));
      grid-template-rows: repeat(4, auto);
      gap: 0;
      align-items: center;
    }

    .footer__brand,
    .footer__about,
    .footer__links,
    .footer__legal {
      grid-column: 1 / span 4;
      padding-inline: var(--pad);
    }

    .footer__brand {
      grid-row: 1;
    }

    .footer__about {
      grid-row: 2;
    }

    .footer__links {
      grid-row: 3;
    }

    .footer__legal {
      grid-row: 4;
    }

    .titleblock {
      grid-column: 5 / -1;
      grid-row: 1 / span 4;
      grid-template-rows: subgrid;
      margin-top: 0;
      border-right: 0;
      border-bottom: 0;
    }

    .cell--title {
      grid-row: 1;
    }

    .cell--sheets {
      grid-row: 3;
    }
  }
</style>
