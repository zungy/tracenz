---
/**
 * Footer laid out as a drawing's title block. Each page is a sheet, so the
 * block states which sheet the visitor is on.
 */
import Brand from './Brand.astro';
import ThemeToggle from './ThemeToggle.astro';
import { nav, sheetCount, sheets, site, type SheetKey } from '../config/site';

interface Props {
  sheet: SheetKey | null;
}

const { sheet } = Astro.props;
const current = sheet ? sheets[sheet] : null;
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container">
    <div class="footer__top grid">
      <div class="footer__brand">
        <Brand />
        <p>{site.description}</p>
      </div>

      <nav class="footer__col footer__col--product" aria-label="Product">
        <p class="label">Product</p>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>

      <nav class="footer__col footer__col--account" aria-label="Account">
        <p class="label">Account</p>
        <ul>
          <li>
            <a href="/login">Log in</a>
          </li>
          <li>
            <a href="/signup">Sign up</a>
          </li>
        </ul>
      </nav>
    </div>

    <dl class="titleblock">
      <div class="titleblock__cell titleblock__cell--title">
        <dt class="label">Title</dt>
        <dd>{current ? current.title : 'Not found'}</dd>
      </div>
      <div class="titleblock__cell">
        <dt class="label">Sheet</dt>
        <dd class="num">{current ? `${current.number} of ${sheetCount}` : `– of ${sheetCount}`}</dd>
      </div>
      <div class="titleblock__cell">
        <dt class="label">Rev</dt>
        <dd>A</dd>
      </div>
      <div class="titleblock__cell">
        <dt class="label">Scale</dt>
        <dd class="num">1:1</dd>
      </div>
      <div class="titleblock__cell">
        <dt class="label">Copyright</dt>
        <dd class="num">© {year} Trace</dd>
      </div>
      <div class="titleblock__cell titleblock__cell--view">
        <dt class="label">View</dt>
        <dd>
          <ThemeToggle />
        </dd>
      </div>
    </dl>
  </div>
</footer>

<style>
  .footer {
    padding-block: var(--sp-8) var(--sp-5);
    background: var(--bg);
    border-top: 1px solid var(--line);
  }

  .footer__top {
    row-gap: var(--sp-5);
    padding-bottom: var(--sp-5);
  }

  .footer__brand {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--sp-2);
    justify-items: start;
  }

  .footer__brand p {
    max-width: 36ch;
    color: var(--text-muted);
    font-size: var(--s-1);
  }

  .footer__col {
    grid-column: span 2;
  }

  .footer__col ul {
    display: grid;
    gap: var(--sp-1);
    margin-top: var(--sp-2);
    padding: 0;
    list-style: none;
  }

  .footer__col a {
    color: var(--text);
    text-decoration: none;
  }

  .footer__col a:hover {
    color: var(--text-strong);
    text-decoration: underline;
  }

  /* Title block: the 1px gaps over a line-colored ground draw the cell rules. */
  .titleblock {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line-strong);
  }

  .titleblock__cell {
    display: grid;
    align-content: start;
    gap: 0.375rem;
    min-width: 0;
    padding: 0.625rem 0.75rem 0.75rem;
    background: var(--bg);
  }

  .titleblock__cell--title,
  .titleblock__cell--view {
    grid-column: 1 / -1;
  }

  .titleblock dd {
    font-family: var(--font-mono);
    font-size: var(--s-1);
    color: var(--text-strong);
  }

  .titleblock__cell--title dd {
    font-family: var(--font-display);
    font-size: var(--s1);
    font-weight: 750;
    font-stretch: 112%;
  }

  @media (min-width: 40rem) {
    .footer__brand {
      grid-column: span 4;
    }

    .titleblock {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }

    .titleblock__cell--title,
    .titleblock__cell--view {
      grid-column: span 2;
    }
  }

  @media (min-width: 64rem) {
    .footer__brand {
      grid-column: 1 / span 6;
    }

    .footer__col--product {
      grid-column: 11 / span 3;
    }

    .footer__col--account {
      grid-column: 14 / span 3;
    }

    .titleblock {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr)) 1.6fr 2.4fr;
    }

    .titleblock__cell--title,
    .titleblock__cell--view {
      grid-column: auto;
    }
  }
</style>
