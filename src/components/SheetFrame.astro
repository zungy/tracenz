---
/**
 * Drawing-sheet border on desktop, after ISO 5457: an outer trim line, a
 * 1.5px border line, zone numbers top and bottom, zone letters left and
 * right, division ticks between the two lines and centering marks. It is
 * fixed to the viewport, so the page scrolls under it. The 8 zones match the
 * layout grid: every gutter between a pair of columns sits on a zone line.
 */
const numbers = Array.from({ length: 8 }, (_, i) => i + 1);
const letters = ['A', 'B', 'C', 'D', 'E', 'F'];
---

<div class="frame" aria-hidden="true">
  <div class="border">
    <div class="zones zones--top">
      {numbers.map((n) => (
        <span>{n}</span>
      ))}
    </div>
    <div class="zones zones--bottom">
      {numbers.map((n) => (
        <span>{n}</span>
      ))}
    </div>
    <div class="zones zones--left">
      {letters.map((l) => (
        <span>{l}</span>
      ))}
    </div>
    <div class="zones zones--right">
      {letters.map((l) => (
        <span>{l}</span>
      ))}
    </div>
    <span class="center center--top"></span>
    <span class="center center--bottom"></span>
    <span class="center center--left"></span>
    <span class="center center--right"></span>
  </div>
  <div class="trim"></div>
</div>

<style>
  .frame {
    display: none;
  }

  @media (min-width: 64rem) {
    .frame {
      position: fixed;
      inset: 0;
      z-index: 70;
      display: block;
      pointer-events: none;
      --strip: calc(var(--frame) - 5px);
    }
  }

  /* The border line; its outward shadow is the paper margin that hides the page as it scrolls. */
  .border {
    position: absolute;
    top: var(--frame);
    bottom: var(--frame);
    left: var(--mat-x);
    right: var(--mat-x);
    border: 1.5px solid var(--text-strong);
    box-shadow: 0 0 0 200vmax var(--bg);
  }

  .trim {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: calc(var(--mat-x) - var(--frame) + 5px);
    right: calc(var(--mat-x) - var(--frame) + 5px);
    border: 1px solid var(--line-strong);
  }

  .zones {
    position: absolute;
    display: grid;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    line-height: 1;
    color: var(--text-strong);
  }

  .zones span {
    position: relative;
    display: grid;
    place-items: center;
  }

  .zones--top,
  .zones--bottom {
    left: 0;
    right: 0;
    height: var(--strip);
    grid-template-columns: repeat(8, 1fr);
  }

  .zones--top {
    bottom: calc(100% + 1.5px);
  }

  .zones--bottom {
    top: calc(100% + 1.5px);
  }

  .zones--left,
  .zones--right {
    top: 0;
    bottom: 0;
    width: var(--strip);
    grid-template-rows: repeat(6, 1fr);
  }

  .zones--left {
    right: calc(100% + 1.5px);
  }

  .zones--right {
    left: calc(100% + 1.5px);
  }

  /* Zone divisions run from the trim line to the border line. */
  .zones--top span + span::before,
  .zones--bottom span + span::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--text-strong);
  }

  .zones--left span + span::before,
  .zones--right span + span::before {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 1px;
    background: var(--text-strong);
  }

  /* Centering marks cross the border line into the sheet. */
  .center {
    position: absolute;
    background: var(--text-strong);
  }

  .center--top,
  .center--bottom {
    left: 50%;
    width: 1.5px;
    height: calc(var(--strip) + 10px);
    transform: translateX(-50%);
  }

  .center--top {
    top: calc(var(--strip) * -1);
  }

  .center--bottom {
    bottom: calc(var(--strip) * -1);
  }

  .center--left,
  .center--right {
    top: 50%;
    height: 1.5px;
    width: calc(var(--strip) + 10px);
    transform: translateY(-50%);
  }

  .center--left {
    left: calc(var(--strip) * -1);
  }

  .center--right {
    right: calc(var(--strip) * -1);
  }
</style>
