---
/**
 * Drawing-sheet border on desktop, after ISO 5457: an outer trim line, a 2px
 * border line, zone numbers top and bottom, and centering marks. It covers
 * the whole page rather than the viewport, so the page is the sheet: the
 * zone lines are the layout grid's lines (see .grid in global.css), and each
 * section writes its own row letter in the side margins, with a division
 * line level with its top edge (see [data-row]).
 */
const numbers = Array.from({ length: 8 }, (_, i) => i + 1);
---

<div class="frame" aria-hidden="true">
  <div class="border">
    <div class="zones zones--top">
      {numbers.map((n) => (
        <span>{n}</span>
      ))}
    </div>
    <div class="zones zones--bottom">
      {numbers.map((n) => (
        <span>{n}</span>
      ))}
    </div>
    <span class="center center--top"></span>
    <span class="center center--bottom"></span>
    <span class="center center--left"></span>
    <span class="center center--right"></span>
  </div>
  <div class="trim"></div>
</div>

<style>
  .frame {
    display: none;
  }

  @media (min-width: 64rem) {
    .frame {
      position: absolute;
      inset: 0;
      z-index: 70;
      display: block;
      pointer-events: none;
      --strip: calc(var(--frame) - 5px);
    }
  }

  .border {
    position: absolute;
    top: var(--frame);
    bottom: var(--frame);
    left: var(--mat-x);
    right: var(--mat-x);
    border: var(--rule-heavy) solid var(--frame-ink);
  }

  .trim {
    position: absolute;
    top: 5px;
    bottom: 5px;
    left: calc(var(--mat-x) - var(--frame) + 5px);
    right: calc(var(--mat-x) - var(--frame) + 5px);
    border: 1px solid var(--line-strong);
  }

  .zones {
    position: absolute;
    left: 0;
    right: 0;
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    height: var(--strip);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    line-height: 1;
    color: var(--frame-ink);
  }

  .zones--top {
    bottom: calc(100% + var(--rule-heavy));
  }

  .zones--bottom {
    top: calc(100% + var(--rule-heavy));
  }

  .zones span {
    position: relative;
    display: grid;
    place-items: center;
  }

  /* Zone divisions run from the trim line to the border line. */
  .zones span + span::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 1px;
    background: var(--frame-ink);
  }

  /* Centering marks cross the border line into the sheet. */
  .center {
    position: absolute;
    background: var(--frame-ink);
  }

  .center--top,
  .center--bottom {
    left: 50%;
    width: var(--rule-heavy);
    height: calc(var(--strip) + 10px);
    transform: translateX(-50%);
  }

  .center--top {
    top: calc(var(--strip) * -1);
  }

  .center--bottom {
    bottom: calc(var(--strip) * -1);
  }

  .center--left,
  .center--right {
    top: 50%;
    height: var(--rule-heavy);
    width: calc(var(--strip) + 10px);
    transform: translateY(-50%);
  }

  .center--left {
    left: calc(var(--strip) * -1);
  }

  .center--right {
    right: calc(var(--strip) * -1);
  }
</style>
