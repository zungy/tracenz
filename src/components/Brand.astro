---
/** Trace logo lockup, matching the desktop app. */
import TraceMark from './LogoPlaceholder.astro';

interface Props {
  href?: string;
  size?: number;
}

const { href = '/', size = 28 } = Astro.props;
---

<a class="brand" href={href} aria-label="Trace home">
  <TraceMark size={size} label="" />
  <span class="brand__name" aria-hidden="true">
    Trace
  </span>
</a>

<style>
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    color: var(--text-strong);
    text-decoration: none;
  }

  .brand__name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1;
  }
</style>
