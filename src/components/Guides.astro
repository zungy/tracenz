---
/**
 * Construction lines: one vertical line at the start of each layout column
 * (4, 8 or 16 depending on width), so content visibly snaps to the grid.
 * Place inside a positioned element; it fills it and ignores the pointer.
 */
---

<div class="guides" aria-hidden="true">
  <div class="container guides__frame">
    <div class="grid guides__grid">
      {Array.from({ length: 16 }, () => (
        <span />
      ))}
    </div>
  </div>
</div>

<style>
  .guides {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .guides__frame,
  .guides__grid {
    height: 100%;
  }

  span {
    border-left: 1px solid var(--line-soft);
  }

  span:nth-child(4) {
    border-right: 1px solid var(--line-soft);
  }

  span:nth-child(n + 5) {
    display: none;
  }

  @media (min-width: 40rem) {
    span:nth-child(4) {
      border-right: 0;
    }

    span:nth-child(-n + 8) {
      display: block;
    }

    span:nth-child(8) {
      border-right: 1px solid var(--line-soft);
    }
  }

  @media (min-width: 64rem) {
    span:nth-child(8) {
      border-right: 0;
    }

    span:nth-child(n) {
      display: block;
    }

    span:nth-child(16) {
      border-right: 1px solid var(--line-soft);
    }
  }
</style>
