---
/**
 * Plans as a band of cells on the zone lines: a key in zones 1 and 2 with
 * the Monthly / Yearly switch and what every plan includes, then Free, Pro
 * and Team, two zones each. On desktop the cells share their rules and
 * their rows, so prices, buttons and lists line up across the band, and the
 * rule over the lists runs from zone line to zone line. The recommended
 * plan carries CAD selection handles, which move to another plan on hover
 * or focus.
 *
 * The switch is two radio inputs and CSS :has() swaps the prices, so it
 * works without JavaScript.
 */
import Icon from '../Icon.astro';
import { everyPlan, plans } from '../../config/pricing';
---

<div class="plans" data-plans>
  <div class="grid plans__band">
    <div class="cell key">
      <fieldset class="billing">
        <legend class="visually-hidden">Billing period</legend>
        <input type="radio" name="billing" id="billing-monthly" value="monthly" checked />
        <label for="billing-monthly">Monthly</label>
        <input type="radio" name="billing" id="billing-yearly" value="yearly" />
        <label for="billing-yearly">Yearly</label>
      </fieldset>
      <p class="key__note">Prices in USD. Yearly billing costs ten months.</p>
      <div class="key__every">
        <h2 id="every-plan" class="key__title">
          In every plan
        </h2>
        <ul class="list" aria-labelledby="every-plan">
          {everyPlan.map((item) => (
            <li>
              <Icon name="check" size={18} stroke={2} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {plans.map((plan) => (
      <article
        class:list={[
          'cell',
          'card',
          `card--${plan.id}`,
          plan.recommended ? 'handles' : 'handles-hover',
        ]}
        aria-labelledby={`plan-${plan.id}`}
      >
        <div class="card__head">
          <h2 id={`plan-${plan.id}`} class="card__name">
            {plan.name}
          </h2>
          {plan.recommended && <p class="card__tag mono">Recommended</p>}
        </div>
        <p class="card__summary">{plan.summary}</p>
        <p class="card__price">
          <span class="card__amount num">
            <span class="price-monthly">${plan.monthly}</span>
            <span class="price-yearly">${plan.yearly}</span>
          </span>
          <span class="card__unit">{plan.unit}</span>
        </p>
        <p class="card__billed">
          {plan.monthly === 0 ? (
            'Free forever, no card needed'
          ) : (
            <>
              <span class="price-monthly">Billed monthly</span>
              <span class="price-yearly">
                Billed yearly at <span class="num">${plan.yearly * 12}</span>
                {plan.id === 'team' ? ' per user' : ''}
              </span>
            </>
          )}
        </p>
        <a
          class:list={['btn', 'btn--block', plan.recommended ? 'btn--primary' : 'btn--secondary']}
          href={plan.cta.href}
        >
          {plan.cta.label}
        </a>
        <ul class="list card__includes" aria-label={`${plan.name} includes`}>
          {plan.includes.map((item) => (
            <li>
              <Icon name="check" size={18} stroke={2} />
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </article>
    ))}
  </div>
</div>

<style>
  .plans__band {
    row-gap: var(--sp-3);
  }

  .cell {
    grid-column: 1 / -1;
    min-width: 0;
  }

  /* Key: the billing switch, and what every plan includes */
  .key {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--sp-2);
    padding-bottom: var(--sp-2);
  }

  .billing {
    display: inline-flex;
    padding: 3px;
    border: 1px solid var(--text-strong);
    border-radius: var(--radius);
  }

  .billing input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .billing label {
    display: grid;
    place-items: center;
    min-height: 2.25rem;
    padding-inline: var(--sp-2);
    border-radius: 1px;
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
  }

  .billing input:checked + label {
    background: var(--text-strong);
    color: var(--bg);
  }

  .billing input:focus-visible + label {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .key__note {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .key__every {
    display: grid;
    gap: var(--sp-2);
  }

  .key__title,
  .card__name {
    font-family: var(--font-body);
    font-size: var(--s1);
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
  }

  .key__title {
    font-size: var(--s0);
  }

  /* Price swap */
  .price-yearly {
    display: none;
  }

  .plans:has(#billing-yearly:checked) .price-monthly {
    display: none;
  }

  .plans:has(#billing-yearly:checked) .price-yearly {
    display: inline;
  }

  /* Lists */
  .list {
    display: grid;
    align-content: start;
    gap: 0.625rem;
    padding: 0;
    list-style: none;
  }

  .list li {
    display: grid;
    grid-template-columns: 1.125rem minmax(0, 1fr);
    gap: 0.625rem;
    align-items: start;
  }

  .list :global(.icon) {
    margin-top: 0.2rem;
    color: var(--text-strong);
  }

  /* Plans */
  .card {
    display: grid;
    align-content: start;
    padding: var(--sp-3);
    border: var(--rule) solid var(--line-strong);
    background: var(--surface);
  }

  .card__head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2);
  }

  .card__tag {
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--select);
    font-size: var(--s-2);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--select);
  }

  .card__summary {
    margin-top: 0.25rem;
    color: var(--text-muted);
  }

  .card__price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem;
    margin-top: var(--sp-3);
  }

  .card__amount {
    font-family: var(--font-display);
    font-size: var(--s8);
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }

  .card__unit,
  .card__billed {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .card__billed {
    margin-top: 0.375rem;
  }

  .card .btn {
    margin-top: var(--sp-3);
  }

  .card__includes {
    margin-top: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
  }

  /* Hovering or tabbing into another plan moves the selection to it. */
  .plans__band:has(.handles-hover:is(:hover, :focus-within)) .handles {
    outline-color: transparent;
  }

  .plans__band:has(.handles-hover:is(:hover, :focus-within)) .handles::after {
    opacity: 0;
  }

  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .card {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--sp-5);
    }

    .card > :not(.card__includes) {
      grid-column: 1;
    }

    .card__includes {
      grid-column: 2;
      grid-row: 1 / span 6;
      margin-top: 0;
      padding: 0 0 0 var(--sp-3);
      border-top: 0;
      border-left: 1px solid var(--line);
    }
  }

  /*
   * Desktop: every cell spans the band's six rows as a subgrid, so the
   * heads, prices, buttons and lists of all four cells sit on shared lines.
   */
  @media (min-width: 64rem) {
    .plans__band {
      grid-template-rows: repeat(6, auto);
      row-gap: 0;
      border-block: var(--rule) solid var(--text-strong);
    }

    .cell {
      grid-row: 1 / span 6;
      display: grid;
      grid-template-rows: subgrid;
      align-content: stretch;
      padding: var(--sp-5) var(--pad);
    }

    .key {
      grid-column: 1 / span 2;
      row-gap: 0;
    }

    .key .billing {
      grid-row: 1;
      align-self: start;
    }

    .key__note {
      grid-row: 2 / span 3;
      margin-top: var(--sp-2);
    }

    .key__every {
      grid-row: 6;
      justify-self: stretch;
    }

    .card {
      border: 0;
      border-left: var(--rule) solid var(--text-strong);
    }

    .card--free {
      grid-column: 3 / span 2;
    }

    .card--pro {
      grid-column: 5 / span 2;
    }

    .card--team {
      grid-column: 7 / span 2;
    }

    /* The rule over the lists runs across the band, zone line to zone line. */
    .key__every,
    .card__includes {
      margin: var(--sp-5) calc(var(--pad) * -1) 0;
      padding: var(--sp-3) var(--pad) 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
