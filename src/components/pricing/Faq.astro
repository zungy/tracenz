---
/**
 * Questions about plans. On desktop the heading holds zones 1 to 3 and the
 * list zones 4 to 8, its rules running to the border.
 */
import Icon from '../Icon.astro';
import { faqs } from '../../config/pricing';
---

<section class="faq" aria-labelledby="faq-title" data-row>
  <div class="container grid faq__grid">
    <div class="faq__head pad">
      <h2 id="faq-title" class="title">
        Common questions
      </h2>
      <p class="faq__intro">About what Trace records, the documents it writes, and plans.</p>
    </div>
    <div class="faq__list">
      {faqs.map((item, i) => (
        <details name="faq" open={i === 0}>
          <summary>
            <span>{item.q}</span>
            <Icon name="plus" size={20} class="faq__icon" />
          </summary>
          <p>{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    padding-block: var(--section-pad);
    border-top: var(--rule) solid var(--text-strong);
  }

  .faq__grid {
    row-gap: var(--sp-5);
  }

  .faq__head,
  .faq__list {
    grid-column: 1 / -1;
  }

  .faq__head {
    display: grid;
    align-content: start;
    gap: var(--sp-2);
  }

  .faq__intro {
    max-width: 32ch;
    color: var(--text-muted);
  }

  .faq__list {
    border-top: var(--rule) solid var(--text-strong);
  }

  details {
    border-bottom: 1px solid var(--line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--sp-3);
    padding-block: var(--sp-3);
    font-size: var(--s1);
    font-weight: 600;
    line-height: 1.4;
    color: var(--text-strong);
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq :global(.faq__icon) {
    flex: none;
    color: var(--text-strong);
    transition: transform 200ms var(--ease);
  }

  details[open] :global(.faq__icon) {
    transform: rotate(45deg);
  }

  details p {
    max-width: 60ch;
    padding-bottom: var(--sp-3);
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .faq__head {
      grid-column: 1 / span 3;
    }

    .faq__list {
      grid-column: 4 / -1;
    }

    summary,
    details p {
      padding-inline: var(--pad);
    }
  }
</style>
