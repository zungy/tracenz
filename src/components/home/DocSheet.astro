---
/**
 * Example design document, drawn as a sheet with a revision block at the top
 * and a title block at the bottom, the way engineering documents are laid out.
 * Stays paper in both themes.
 */
import Icon from '../Icon.astro';

const revisions = [
  { rev: 'A', description: 'Initial release', date: '2026-08-14' },
  { rev: 'B', description: 'Wall, material, dust extraction', date: '2026-09-22' },
];

const changes = [
  { id: '2.1', text: 'Motor mount wall thickened from 2.0 to 2.5 mm.', ref: '09:12 Sketch 4' },
  { id: '2.2', text: 'Housing material changed from ABS to PC-ABS.', ref: '10:20 Housing' },
  { id: '2.3', text: 'Dust extraction moved from 6 to 8 holes, each Ø9.', ref: '10:24 Pattern 1' },
];
---

<article class="sheet scheme-paper" aria-label="Example design document">
  <div class="sheet__top">
    <p class="sheet__kind label">Design document</p>
    <table class="revblock">
      <caption class="visually-hidden">Revisions</caption>
      <thead>
        <tr>
          <th scope="col">Rev</th>
          <th scope="col">Description</th>
          <th scope="col">Date</th>
        </tr>
      </thead>
      <tbody>
        {revisions.map((r) => (
          <tr>
            <td>{r.rev}</td>
            <td>{r.description}</td>
            <td class="num">{r.date}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <p class="sheet__title">Orbital sander housing</p>

  <div class="sheet__section">
    <p class="sheet__heading">
      <span class="num">1</span> Overview
    </p>
    <p>
      A two-piece clamshell housing in PC-ABS around a 125 mm orbital pad. The motor sits on a
      bracket mated to the housing boss; dust is pulled through the pad into the rear port.
    </p>
    <dl class="sheet__facts">
      <div>
        <dt>Parts</dt>
        <dd>Upper shell, lower shell, motor bracket, pad</dd>
      </div>
      <div>
        <dt>Pad</dt>
        <dd class="num">Ø125 mm, 8 × Ø9 holes</dd>
      </div>
      <div>
        <dt>Wall</dt>
        <dd class="num">2.5 mm nominal</dd>
      </div>
    </dl>
  </div>

  <div class="sheet__section">
    <p class="sheet__heading">
      <span class="num">2</span> Changes since Rev A
    </p>
    <ol class="sheet__changes">
      {changes.map((c) => (
        <li>
          <span class="sheet__id num">{c.id}</span> <span>{c.text}</span>{' '}
          <span class="sheet__ref mono">
            <Icon name="corner-down-right" size={12} />
            {c.ref}
          </span>
        </li>
      ))}
    </ol>
  </div>

  <dl class="sheet__block">
    <div class="sheet__block-title">
      <dt>Title</dt>
      <dd>Orbital sander housing</dd>
    </div>
    <div>
      <dt>Doc no.</dt>
      <dd class="num">TR-0142</dd>
    </div>
    <div>
      <dt>Rev</dt>
      <dd>B</dd>
    </div>
    <div>
      <dt>Source</dt>
      <dd class="num">71 changes</dd>
    </div>
  </dl>
</article>

<style>
  .sheet {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sp-3);
    padding: var(--sp-3);
    border: 1px solid var(--line);
    box-shadow:
      0 1px 0 var(--line),
      0 24px 48px -20px rgb(25 44 100 / 0.3);
    font-size: var(--s-1);
    line-height: 1.55;
  }

  .sheet__top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: start;
    gap: var(--sp-2);
  }

  /* Revision block */
  .revblock {
    border-collapse: collapse;
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .revblock th,
  .revblock td {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--line-strong);
    text-align: left;
    vertical-align: top;
    white-space: nowrap;
  }

  /* The description is the one column allowed to wrap. */
  .revblock td:nth-child(2) {
    white-space: normal;
  }

  @media (max-width: 39.99rem) {
    .revblock {
      width: 100%;
    }
  }

  .revblock th {
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .revblock tbody tr:last-child {
    background: var(--tint);
    font-weight: 700;
  }

  .sheet__title {
    font-family: var(--font-display);
    font-size: var(--s3);
    font-weight: 760;
    font-stretch: 110%;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }

  .sheet__section {
    display: grid;
    gap: var(--sp-1);
  }

  .sheet__heading {
    display: flex;
    gap: 0.75rem;
    padding-bottom: 0.35rem;
    border-bottom: 1px solid var(--line);
    font-weight: 700;
    color: var(--text-strong);
  }

  .sheet__heading .num {
    font-family: var(--font-mono);
    color: var(--mark);
  }

  .sheet__facts {
    display: grid;
    gap: 0.25rem;
  }

  .sheet__facts div {
    display: grid;
    grid-template-columns: 4.5rem minmax(0, 1fr);
    gap: 0.75rem;
  }

  .sheet__facts dt {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
    padding-top: 0.15rem;
  }

  .sheet__changes {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .sheet__changes li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.75rem;
  }

  .sheet__id {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .sheet__ref {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    font-size: 0.6875rem;
    color: var(--link);
  }

  /* Title block */
  .sheet__block {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin-top: var(--sp-1);
    background: var(--line);
    border: 1px solid var(--line-strong);
    font-size: 0.75rem;
  }

  .sheet__block div {
    display: grid;
    gap: 0.1rem;
    padding: 0.35rem 0.5rem;
    background: var(--bg);
  }

  .sheet__block-title {
    grid-column: 1 / -1;
  }

  .sheet__block dt {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .sheet__block dd {
    font-family: var(--font-mono);
    color: var(--text-strong);
  }

  @media (min-width: 40rem) {
    .sheet {
      padding: var(--sp-5);
    }

    .sheet__block {
      grid-template-columns: 2fr repeat(3, minmax(0, 1fr));
    }

    .sheet__block-title {
      grid-column: auto;
    }
  }
</style>
