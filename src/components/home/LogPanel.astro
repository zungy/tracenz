---
/**
 * The change log as Trace shows it: a session timeline and the latest
 * changes, each with its value before and after. Row 1 is the change the hero
 * traces through to the document. Plays in when the parent .hero has
 * `is-playing`; otherwise it shows its finished state.
 */
import Icon from '../Icon.astro';

// Sixteen sessions that bunch up toward the present, the way work speeds up
// before a review.
const sessions = [
  0.047, 0.188, 0.25, 0.273, 0.312, 0.5, 0.609, 0.672, 0.734, 0.75, 0.852, 0.867, 0.898, 0.953,
  0.977, 0.992,
];

const rows = [
  { time: '09:12', feature: 'Sketch 4', param: 'D3', from: '2.0', to: '2.5 mm', traced: true },
  { time: '09:31', feature: 'Fillet 7', param: 'Radius', from: 'R1.5', to: 'R2' },
  { time: '10:02', feature: 'Motor bracket', param: 'Part', added: true },
  { time: '10:20', feature: 'Housing', param: 'Material', from: 'ABS', to: 'PC-ABS' },
  { time: '10:24', feature: 'Pattern 1', param: 'Holes', from: '6', to: '8' },
  { time: '10:26', feature: 'Hole 3', param: 'Dia.', from: 'Ø8', to: 'Ø9' },
];
const recent = sessions.slice(-rows.length);
---

<div class="log">
  <div class="log__bar">
    <span class="log__file mono">orbital-sander / housing</span>
    <span class="log__live">
      <span class="log__dot" aria-hidden="true"></span>Logging
    </span>
    <button class="log__replay" type="button" data-replay aria-label="Replay the example">
      <Icon name="rotate" size={16} />
    </button>
  </div>

  <div class="timeline" aria-hidden="true">
    <div class="timeline__track">
      {sessions.map((at) => (
        <span class="timeline__tick" style={`--at: ${at}`} />
      ))}
      <span class="timeline__playhead"></span>
    </div>
    <div class="timeline__labels mono">
      <span>16 sessions</span>
      <span class="num">71 changes</span>
    </div>
  </div>

  <ol class="log__rows" aria-label="Latest changes">
    {rows.map((row, i) => (
      <li
        class:list={['row', row.traced && 'row--traced']}
        style={`--at: ${recent[i]}`}
        data-trace={row.traced ? 'log' : undefined}
      >
        <time class="row__time num">{row.time}</time>{' '}
        <span class="row__what">
          <span class="row__feature">{row.feature}</span>{' '}
          <span class="row__param">{row.param}</span>
        </span>{' '}
        {row.added ? (
          <span class="row__change">
            <ins class="new-value">added</ins>
          </span>
        ) : (
          <span class="row__change num">
            <span class="visually-hidden">from </span>
            <del class="old-value">{row.from}</del>
            <span class="row__arrow" aria-hidden="true">
              →
            </span>
            <span class="visually-hidden"> to </span>
            <ins class="new-value">{row.to}</ins>
          </span>
        )}
      </li>
    ))}
  </ol>
</div>

<style>
  .log {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    background: var(--surface);
    border: 1px solid var(--line-strong);
  }

  .log__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 2.75rem;
    padding-inline: var(--sp-2) 0.375rem;
    border-bottom: 1px solid var(--line);
  }

  .log__file {
    overflow: hidden;
    font-size: var(--s-1);
    color: var(--text-strong);
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .log__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  .log__dot {
    width: 0.4375rem;
    height: 0.4375rem;
    border-radius: 50%;
    background: var(--change);
  }

  @media (prefers-reduced-motion: no-preference) {
    .log__dot {
      animation: pulse 2s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  .log__replay {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--text-muted);
  }

  .log__replay:hover {
    border-color: var(--line-strong);
    color: var(--text-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .log__replay {
      display: none;
    }
  }

  /* Session timeline */
  .timeline {
    padding: 0.875rem var(--sp-2) 0.625rem;
    border-bottom: 1px solid var(--line);
  }

  .timeline__track {
    position: relative;
    height: 1rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .timeline__tick {
    position: absolute;
    bottom: 0;
    left: calc(var(--at) * 100%);
    width: 1.5px;
    height: 0.625rem;
    background: var(--text-strong);
    transform-origin: bottom;
  }

  .timeline__playhead {
    position: absolute;
    top: -0.25rem;
    bottom: -0.25rem;
    left: 100%;
    width: 1px;
    background: var(--change);
  }

  .timeline__labels {
    display: flex;
    justify-content: space-between;
    padding-top: 0.375rem;
    font-size: 0.6875rem;
    color: var(--text-muted);
  }

  /* Rows */
  .log__rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: 2.625rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
    min-height: 2.5rem;
    padding: 0.35rem var(--sp-2);
    border-bottom: 1px solid var(--line-soft);
    font-size: var(--s-1);
  }

  .row:last-child {
    border-bottom: 0;
  }

  .row--traced {
    background: var(--tint);
    box-shadow: inset 2px 0 0 var(--change);
  }

  .row__time {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .row__what {
    display: flex;
    gap: 0.4rem;
    min-width: 0;
    white-space: nowrap;
  }

  .row__feature {
    overflow: hidden;
    font-weight: 600;
    color: var(--text-strong);
    text-overflow: ellipsis;
  }

  .row__param {
    color: var(--text-muted);
  }

  .row__change {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .row__arrow {
    color: var(--text-faint);
  }

  /* Playback: each element starts dimmed, never hidden, then settles. */
  :global(.hero.is-playing) .timeline__playhead {
    animation: sweep var(--play) linear both;
  }

  :global(.hero.is-playing) .timeline__tick {
    animation: tick-on 260ms var(--ease) both;
    animation-delay: calc(var(--at) * var(--play));
  }

  :global(.hero.is-playing) .row {
    animation: capture 320ms var(--ease) both;
    animation-delay: calc(var(--at) * var(--play));
  }

  @keyframes sweep {
    from {
      left: 0%;
    }
  }

  @keyframes tick-on {
    from {
      opacity: 0.25;
      transform: scaleY(0.4);
    }
  }

  @keyframes capture {
    from {
      opacity: 0.2;
      transform: translateX(-6px);
    }
  }
</style>
