---
/**
 * A deliberately quiet band: type only, no figures, no numbers. It sits
 * between the mechanics (how it works) and the product (the document).
 */
---

<section class="quiet" aria-labelledby="quiet-title">
  <div class="container grid">
    <h2 id="quiet-title" class="quiet__title">
      Design intent gets <span class="quiet__hidden">lost</span> between revisions.
    </h2>
    <p class="quiet__text">
      Why did the wall get thicker? When did the material change? Trace keeps every change with its
      before and after values, so reviews, handoffs and audits start from the full record.
    </p>
  </div>
</section>

<style>
  .quiet {
    padding-block: var(--sp-13);
    background: var(--bg-alt);
    border-block: 1px solid var(--line);
  }

  .quiet__title {
    grid-column: 1 / -1;
    font-size: clamp(var(--s4), 1.1rem + 3.9vw, var(--s8));
    font-weight: 780;
    font-stretch: 116%;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  /* "lost" drawn as outline only, like geometry that is no longer there */
  .quiet__hidden {
    color: transparent;
    -webkit-text-stroke: 1.5px var(--text-strong);
  }

  @supports not (-webkit-text-stroke: 1px black) {
    .quiet__hidden {
      color: var(--text-muted);
    }
  }

  .quiet__text {
    grid-column: 1 / -1;
    margin-top: var(--sp-5);
    max-width: 44ch;
    font-size: var(--s1);
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .quiet__title {
      grid-column: 1 / span 13;
    }

    .quiet__text {
      grid-column: 8 / span 8;
    }
  }
</style>
