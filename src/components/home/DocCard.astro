---
/**
 * The design document Trace writes, as a sheet of paper in both themes. In
 * the hero band it fills a cell of the figure; it keeps to LogPanel's row
 * grid (a 44px bar and a 56px block), so the first change statement sits on
 * the same line as the log entry it came from.
 */
const changes = [
  {
    id: '2.1',
    text: 'Motor mount wall thickened from 2.0 to 2.5 mm, with its root fillet raised from R1.5 to R2.',
    ref: '09:12, 09:31',
    link: 'wall',
  },
  {
    id: '2.2',
    text: 'Housing material changed from ABS to PC-ABS.',
    ref: '10:20',
    link: 'material',
  },
  {
    id: '2.3',
    text: 'Bearing seat set to Ø22 H7 for the 608 bearing.',
    ref: '10:24, 10:26',
    link: 'bearing',
  },
];
---

<article class="doc scheme-paper" aria-label="Design document written by Trace">
  <header class="doc__bar">
    <span class="doc__kind mono">Design document</span>
    <span class="doc__no mono num">TR-0142</span>
    <span class="doc__rev mono">
      Rev B
      <span class="rev-tag rev-tag--change" aria-hidden="true">
        <svg viewBox="0 0 24 21">
          <path d="M12 1.5 22.5 19.5H1.5Z"></path>
        </svg>
        <span>B</span>
      </span>
    </span>
  </header>

  <div class="doc__block doc__line" style="--i: 0">
    <p class="doc__title">Orbital sander housing</p>
    <p class="doc__meta mono num">2 Changes since Rev A · 22 Sep 2026</p>
  </div>

  <ol class="doc__items">
    {changes.map((c, i) => (
      <li
        class:list={['doc__item', 'doc__line', c.link === 'wall' && 'is-active']}
        style={`--i: ${i + 1}`}
        data-trace="doc"
        data-link={c.link}
      >
        <span class="doc__id mono num">{c.id}</span>
        <span class="doc__text">{c.text}</span>
        <span class="doc__ref mono num">
          <span class="visually-hidden">From log entries </span>↳ {c.ref}
        </span>
      </li>
    ))}
  </ol>

  <footer class="doc__foot mono">
    <span>Written by Trace</span>
    <span>Review: waiting</span>
  </footer>
</article>

<style>
  .doc {
    --cell-pad: var(--sp-2);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: 2.75rem 3.5rem 1fr auto;
    height: 100%;
    border: 1px solid var(--text-strong);
    font-size: var(--s-1);
    line-height: 1.5;
  }

  .doc__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    padding-inline: var(--cell-pad);
    border-bottom: 1px solid var(--line);
  }

  .doc__kind,
  .doc__no,
  .doc__rev {
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .doc__kind {
    color: var(--text-strong);
  }

  .doc__no {
    margin-left: auto;
    color: var(--text-muted);
  }

  .doc__rev {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-strong);
  }

  .doc__block {
    display: grid;
    align-content: center;
    gap: 0.125rem;
    padding-inline: var(--cell-pad);
    border-bottom: 1px solid var(--line);
  }

  .doc__title {
    font-family: var(--font-display);
    font-size: var(--s1);
    font-weight: 500;
    line-height: 1.2;
    color: var(--text-strong);
  }

  .doc__meta {
    font-size: var(--s-2);
    line-height: 1.3;
    color: var(--text-muted);
  }

  .doc__items {
    display: grid;
    align-content: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* The first text line is centred 20px from the top, on the log's first row. */
  .doc__item {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    column-gap: 0.25rem;
    padding: 0.5625rem var(--cell-pad) 0.625rem;
    border-bottom: 1px solid var(--line-soft);
  }

  .doc__item:last-child {
    border-bottom: 0;
  }

  .doc__item:global(.is-active) {
    background: var(--change-tint);
    box-shadow: inset 2px 0 0 var(--change);
  }

  .doc__id {
    font-size: var(--s-2);
    line-height: 1.6;
    color: var(--text-muted);
  }

  .doc__text {
    color: var(--text-strong);
  }

  .doc__ref {
    grid-column: 2;
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  .doc__foot {
    display: flex;
    justify-content: space-between;
    gap: var(--sp-2);
    padding: 0.625rem var(--cell-pad) 0.75rem;
    border-top: 1px solid var(--line);
    font-size: var(--s-2);
    line-height: 1.6;
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .doc {
      --cell-pad: var(--pad);
      border: 0;
    }
  }

  :global(.hero.is-playing) .doc__line {
    animation: write 380ms var(--ease) both;
    animation-delay: calc(var(--play) + 150ms + var(--i) * 120ms);
  }

  @keyframes write {
    from {
      opacity: 0.14;
      transform: translateY(4px);
    }
  }
</style>
