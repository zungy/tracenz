---
/**
 * The three stages as detail views on a drawing: Detail A, B and C, each an
 * enlarged view with its own scale.
 */

// Same session spacing as the hero timeline: bunching up toward the present.
const sessions = [
  0.047, 0.188, 0.25, 0.273, 0.312, 0.5, 0.609, 0.672, 0.734, 0.75, 0.852, 0.867, 0.898, 0.953,
  0.977, 0.992,
];
const tickX = (at: number) => 24 + at * 192;
---

<section id="how-it-works" class="section how" aria-labelledby="how-title">
  <div class="container grid how__grid">
    <div class="how__intro">
      <p class="label">How it works</p>
      <h2 id="how-title">You model. Trace keeps the record.</h2>
      <p>
        Trace captures each change as you work, logs it with its before and after values, and writes
        the design document from that log.
      </p>
    </div>

    <ol class="how__details">
      <li class="detail">
        <figure class="detail__view">
          <figcaption class="detail__caption label">
            <span>Detail A</span>
            <span>Scale 2:1</span>
          </figcaption>
          <svg viewBox="0 0 240 150" role="img" aria-labelledby="detail-a-title">
            <title id="detail-a-title">A plate whose width dimension changed from 12 to 14</title>
            <!-- plate -->
            <rect class="ln-visible" x="52" y="62" width="136" height="54"></rect>
            <!-- bore with centerlines -->
            <circle class="ln-visible" cx="120" cy="89" r="12"></circle>
            <path class="ln-center" d="M96 89H144M120 68V110"></path>
            <!-- extension lines -->
            <path class="ln-thin" d="M52 58V30M188 58V30"></path>
            <!-- dimension line with arrowheads -->
            <path class="ln-thin" d="M58 36H182"></path>
            <path class="arrow" d="M52 36l8-3v6zM188 36l-8-3v6z"></path>
            <!-- old value struck, new value, revision tag -->
            <text class="dim dim--old" x="100" y="28" text-anchor="middle">
              12
            </text>
            <path class="ln-thin" d="M91 24H109"></path>
            <text class="dim" x="132" y="28" text-anchor="middle">
              14
            </text>
            <path class="tri" d="M160 16l8 14h-16z"></path>
            <text class="tri-letter" x="160" y="28.5" text-anchor="middle">
              B
            </text>
          </svg>
        </figure>
        <p class="detail__stage">
          <span class="bubble" aria-hidden="true">
            A
          </span>
          Capture
        </p>
        <h3>Keep working in CAD</h3>
        <p>
          Trace runs next to your CAD tool and records features, dimensions, parts, mates and
          materials as you change them.
        </p>
      </li>

      <li class="detail">
        <figure class="detail__view">
          <figcaption class="detail__caption label">
            <span>Detail B</span>
            <span>Scale 1:4</span>
          </figcaption>
          <svg viewBox="0 0 240 150" role="img" aria-labelledby="detail-b-title">
            <title id="detail-b-title">A timeline of sessions with one change called out</title>
            <path class="ln-visible" d="M24 58H216"></path>
            {sessions.map((at) => (
              <path class="ln-tick" d={`M${tickX(at).toFixed(1)} 58V46`} />
            ))}
            <circle class="node" cx={tickX(sessions[10])} cy="46" r="3.5"></circle>
            <path class="ln-thin" d={`M${tickX(sessions[10])} 50V88H196`}></path>
            <rect class="ln-thin" x="36" y="80" width="168" height="18" rx="1"></rect>
            <text class="log-text" x="44" y="93">
              D3
            </text>
            <text class="log-text log-text--old" x="118" y="93">
              2.0
            </text>
            <path class="ln-thin" d="M111 89.5H133"></path>
            <text class="log-text" x="150" y="93">
              2.5
            </text>
            <rect class="ln-faint" x="36" y="104" width="168" height="18" rx="1"></rect>
            <rect class="ln-faint" x="36" y="128" width="168" height="10" rx="1"></rect>
          </svg>
        </figure>
        <p class="detail__stage">
          <span class="bubble" aria-hidden="true">
            B
          </span>
          Log
        </p>
        <h3>Every change, on the record</h3>
        <p>
          Changes land in a timeline grouped by session and part. Each one keeps its value before
          and after, and you can search all of it.
        </p>
      </li>

      <li class="detail">
        <figure class="detail__view">
          <figcaption class="detail__caption label">
            <span>Detail C</span>
            <span>Scale 1:2</span>
          </figcaption>
          <svg viewBox="0 0 240 150" role="img" aria-labelledby="detail-c-title">
            <title id="detail-c-title">Two revisions of a design document, B in front of A</title>
            <!-- Rev A sheet behind -->
            <rect class="ln-faint" x="70" y="14" width="84" height="119"></rect>
            <!-- Rev B sheet, ISO A proportions (1 : 1.414) -->
            <rect class="sheet" x="90" y="24" width="84" height="119"></rect>
            <path
              class="ln-text"
              d="M100 38H146M100 50H164M100 58H158M100 66H162M100 78H136M100 86H164M100 94H150"
            ></path>
            <!-- title block -->
            <path class="ln-thin" d="M130 121H174M130 121V143M152 121V143M130 132H174"></path>
            <path class="tri" d="M160 28l8 14h-16z"></path>
            <text class="tri-letter" x="160" y="40.5" text-anchor="middle">
              B
            </text>
            <!-- leader to the log reference -->
            <path class="ln-thin" d="M164 86H196V104"></path>
            <circle class="node" cx="196" cy="108" r="3.5"></circle>
          </svg>
        </figure>
        <p class="detail__stage">
          <span class="bubble" aria-hidden="true">
            C
          </span>
          Document
        </p>
        <h3>The design doc, written for you</h3>
        <p>
          Trace's AI reads the log and writes the design document. It starts with the overall
          design, then covers the changes that matter. Generate a new revision whenever the design
          moves on.
        </p>
      </li>
    </ol>
  </div>
</section>

<style>
  .how__grid {
    row-gap: var(--sp-5);
  }

  .how__intro {
    grid-column: 1 / -1;
    display: grid;
    align-content: start;
    gap: var(--sp-2);
  }

  .how__intro h2 {
    font-size: clamp(var(--s4), 1.4rem + 2.2vw, var(--s6));
  }

  .how__intro p:last-child {
    max-width: 34ch;
    color: var(--text-muted);
  }

  .how__details {
    grid-column: 1 / -1;
    display: grid;
    gap: var(--sp-5) var(--gutter);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .detail {
    display: grid;
    align-content: start;
    gap: var(--sp-2);
  }

  .detail h3 {
    font-size: var(--s2);
  }

  .detail > p:last-child {
    color: var(--text-muted);
  }

  .detail__view {
    position: relative;
    margin-bottom: var(--sp-1);
    border: 1px solid var(--line-strong);
    background: var(--bg);
  }

  .detail__caption {
    display: flex;
    justify-content: space-between;
    padding: 0.4rem 0.6rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.6875rem;
  }

  .detail__view svg {
    width: 100%;
    height: auto;
  }

  .detail__stage {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--font-mono);
    font-size: var(--s-2);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  /* Detail callout bubble, as on a drawing */
  .bubble {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--mark);
    border-radius: 50%;
    font-weight: 700;
    letter-spacing: 0;
    color: var(--mark);
  }

  /* Drafting line types */
  svg :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .ln-visible {
    fill: none;
    stroke: var(--text-strong);
    stroke-width: 1.75;
  }

  .ln-thin {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1;
  }

  .ln-center {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1;
    stroke-dasharray: 14 3 2 3;
  }

  .ln-tick {
    stroke: var(--mark);
    stroke-width: 1.5;
  }

  .ln-faint {
    fill: none;
    stroke: var(--line);
    stroke-width: 1;
  }

  .ln-text {
    fill: none;
    stroke: var(--line);
    stroke-width: 3;
  }

  .sheet {
    fill: var(--bg);
    stroke: var(--text-strong);
    stroke-width: 1.5;
  }

  .arrow {
    fill: var(--text-muted);
  }

  .node {
    fill: var(--mark);
  }

  .tri {
    fill: var(--bg);
    stroke: var(--mark);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .tri-letter {
    font-family: var(--font-mono);
    font-size: 8px;
    font-weight: 700;
    fill: var(--mark);
  }

  .dim,
  .log-text {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 600;
    fill: var(--text-strong);
  }

  .log-text {
    font-size: 10px;
  }

  .dim--old,
  .log-text--old {
    font-weight: 400;
    fill: var(--text-muted);
  }

  /* Tablet: each detail is a row, drawing on the left and text on the right. */
  @media (min-width: 40rem) and (max-width: 63.99rem) {
    .detail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--gutter);
      align-items: start;
    }

    .detail__view {
      grid-row: 1 / span 3;
      margin-bottom: 0;
    }

    .detail > :not(.detail__view) {
      grid-column: 2;
    }
  }

  @media (min-width: 64rem) {
    .how__intro {
      grid-column: 1 / span 4;
      position: sticky;
      top: 6rem;
    }

    .how__details {
      grid-column: 5 / -1;
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
