---
/**
 * How it works, shown on real changes: three changes to the housing (columns),
 * each followed through CAD, the log and the document (rows). Laid out like a
 * drawing table; rows line up across columns with subgrid.
 */
import MaterialDetail from '../drawings/MaterialDetail.astro';
import PadHoles from '../drawings/PadHoles.astro';
import WallSection from '../drawings/WallSection.astro';

const stages = [
  { name: 'In CAD', text: 'You change the model. Nothing else.' },
  { name: 'In the log', text: 'Trace records the change with its value before and after.' },
  {
    name: 'In the document',
    text: 'The AI writes it into the next revision, linked to the log.',
  },
];

const changes = [
  {
    id: 'wall',
    title: 'Motor mount wall',
    view: 'Section A–A · 2:1',
    drawing: 'wall',
    log: [{ time: '09:12', what: 'Sketch 4 · D3', from: '2.0', to: '2.5 mm' }],
    doc: { id: '2.1', text: 'Motor mount wall thickened from 2.0 to 2.5 mm.', refs: '09:12' },
  },
  {
    id: 'holes',
    title: 'Dust extraction',
    view: 'View B · 1:2.5',
    drawing: 'holes',
    log: [
      { time: '10:24', what: 'Pattern 1 · Holes', from: '6', to: '8' },
      { time: '10:26', what: 'Hole 3 · Dia.', from: 'Ø8', to: 'Ø9' },
    ],
    doc: {
      id: '2.3',
      text: 'Dust extraction moved from 6 to 8 holes, each Ø9.',
      refs: '10:24, 10:26',
    },
  },
  {
    id: 'material',
    title: 'Housing material',
    view: 'Detail C · 2:1',
    drawing: 'material',
    log: [{ time: '10:20', what: 'Housing · Material', from: 'ABS', to: 'PC-ABS' }],
    doc: { id: '2.2', text: 'Housing material changed from ABS to PC-ABS.', refs: '10:20' },
  },
];
---

<section id="how-it-works" class="section walk" aria-labelledby="walk-title">
  <div class="container">
    <div class="grid walk__head">
      <p class="label walk__callout">Rev A → Rev B · 3 of 71 changes</p>
      <h2 id="walk-title">Three changes, from the model to the document.</h2>
      <p class="walk__intro">
        One afternoon on the housing produced 71 logged changes. Here are three of them, as Trace
        saw them in CAD, logged them and wrote them up.
      </p>
    </div>

    <div class="walk__table">
      <div class="stages" aria-hidden="true">
        <div class="stages__corner"></div>
        {stages.map((stage) => (
          <div class="stage">
            <p class="stage__name">{stage.name}</p>
            <p class="stage__text">{stage.text}</p>
          </div>
        ))}
      </div>

      {changes.map((change) => (
        <article class="change" aria-labelledby={`change-${change.id}`}>
          <header class="change__head">
            <h3 id={`change-${change.id}`}>{change.title}</h3>
            <p class="change__view mono">{change.view}</p>
          </header>

          <div class="change__cell change__cell--drawing">
            <p class="change__stage">{stages[0].name}</p>
            {change.drawing === 'wall' && <WallSection />}
            {change.drawing === 'holes' && <PadHoles />}
            {change.drawing === 'material' && <MaterialDetail />}
          </div>

          <div class="change__cell">
            <p class="change__stage">{stages[1].name}</p>
            <ul class="entries">
              {change.log.map((entry) => (
                <li class="entry">
                  <time class="entry__time mono num">{entry.time}</time>{' '}
                  <span class="entry__what">{entry.what}</span>{' '}
                  <span class="entry__change mono num">
                    <span class="visually-hidden">from </span>
                    <del class="old-value">{entry.from}</del>
                    <span aria-hidden="true" class="entry__arrow">
                      →
                    </span>
                    <span class="visually-hidden"> to </span>
                    <ins class="new-value">{entry.to}</ins>
                  </span>
                </li>
              ))}
            </ul>
          </div>

          <div class="change__cell">
            <p class="change__stage">{stages[2].name}</p>
            <p class="statement">
              <span class="statement__id mono num">{change.doc.id}</span>{' '}
              <span>{change.doc.text}</span>{' '}
              <span class="statement__ref mono num">
                <span class="visually-hidden">From log entries </span>↳ {change.doc.refs}
              </span>
            </p>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .walk__head {
    row-gap: var(--sp-2);
    margin-bottom: var(--sp-5);
  }

  .walk__head > * {
    grid-column: 1 / -1;
  }

  .walk__head h2 {
    font-size: clamp(var(--s4), 1.3rem + 2.4vw, 3rem);
  }

  .walk__intro {
    max-width: 52ch;
    color: var(--text);
  }

  /* The table: stage labels + three change columns, ruled like a drawing table. */
  .walk__table {
    display: grid;
    gap: var(--sp-3);
  }

  .stages {
    display: none;
  }

  .change {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    border: 1px solid var(--line-strong);
  }

  .change__head {
    display: grid;
    align-content: start;
    gap: 0.25rem;
    padding: var(--sp-2) var(--sp-3);
    border-bottom: 1px solid var(--line-strong);
  }

  .change__head h3 {
    font-size: var(--s1);
  }

  .change__view {
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .change__cell {
    display: grid;
    align-content: start;
    gap: var(--sp-1);
    padding: var(--sp-3);
    border-bottom: 1px solid var(--line);
  }

  .change__cell:last-child {
    border-bottom: 0;
  }

  .change__cell--drawing {
    padding-block: var(--sp-3);
  }

  .change__stage {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .entries {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    align-items: baseline;
    font-size: var(--s-1);
  }

  .entry__time {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .entry__what {
    font-weight: 600;
    color: var(--text-strong);
  }

  .entry__change {
    grid-column: 2;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.8125rem;
  }

  .entry__arrow {
    color: var(--text-faint);
  }

  .statement {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: 0.75rem;
    row-gap: 0.25rem;
    align-items: baseline;
    font-size: var(--s-1);
    line-height: 1.5;
  }

  .statement__id {
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .statement__ref {
    grid-column: 2;
    font-size: 0.75rem;
    color: var(--change);
  }

  @media (min-width: 64rem) {
    /* Stage labels become the first column; rows align across columns. */
    .walk__table {
      grid-template-columns: 1.05fr repeat(3, minmax(0, 1fr));
      grid-template-rows: auto auto auto auto;
      gap: 0;
      border: 1px solid var(--line-strong);
    }

    .stages,
    .change {
      display: grid;
      grid-row: 1 / span 4;
      grid-template-rows: subgrid;
    }

    .change {
      border: 0;
      border-left: 1px solid var(--line-strong);
    }

    .stages__corner,
    .stage {
      border-bottom: 1px solid var(--line);
    }

    .stages__corner {
      border-bottom-color: var(--line-strong);
    }

    .stage:last-child {
      border-bottom: 0;
    }

    .stage {
      display: grid;
      align-content: start;
      gap: var(--sp-1);
      padding: var(--sp-3);
    }

    .stage__name {
      font-family: var(--font-display);
      font-size: var(--s1);
      font-weight: 700;
      font-stretch: 106%;
      color: var(--text-strong);
    }

    .stage__text {
      max-width: 22ch;
      font-size: var(--s-1);
      color: var(--text-muted);
    }

    /* The column's stage label is repeated for screen readers only. */
    .change__stage {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    .change__cell--drawing {
      align-content: center;
    }
  }
</style>
