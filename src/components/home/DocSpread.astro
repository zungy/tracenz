---
/**
 * The deliverable: the design document Trace writes, set as an A4 sheet at
 * about four-fifths scale, so its text still reads. Numbered notes on the
 * right point at three parts of it with drafting leaders: a short shoulder
 * from the balloon, then a straight run to a dot on the part. The same page
 * is offered as a PDF.
 *
 * The leaders are drawn by a small script from the notes and the page's
 * data-target elements; without it the notes stand on their own.
 */
import DocPage from './DocPage.astro';

const notes = [
  {
    target: 'revs',
    title: 'Revision history',
    text: 'Each revision is listed with its date and what changed. Earlier ones stay on record.',
  },
  {
    target: 'sources',
    title: 'Sources',
    text: 'Every change cites the log entries it came from, so a reviewer can check it against the model.',
  },
  {
    target: 'signoff',
    title: 'Sign-off',
    text: 'Reviewers check and approve the document in Trace. Review is part of the Team plan.',
  },
];
---

<section id="how-it-works" class="section spread" aria-labelledby="spread-title" data-row>
  <div class="container grid spread__grid" data-leaders>
    <div class="spread__text pad">
      <h2 id="spread-title" class="title">
        Every statement cites the change behind it.
      </h2>
      <p class="lead spread__lead">
        Trace writes the overview and the changes since the last revision, links each one to the log
        entries it came from, and leaves room for review and sign-off.
      </p>
    </div>

    <figure class="spread__sheet pad">
      <div class="spread__page">
        <article class="scheme-paper" aria-label="Design document TR-0142, sheet 1">
          <DocPage id="doc" />
        </article>
      </div>
      <figcaption class="spread__caption">
        <span class="mono">Fig. 2</span>
        <span>Design document TR-0142, Rev B, as Trace wrote it. Shown at 80%.</span>
      </figcaption>
    </figure>

    <div class="spread__notes pad">
      <ol class="notes">
        {notes.map((note, i) => (
          <li class="note" data-note={note.target}>
            <span class="note__balloon mono" aria-hidden="true">
              {i + 1}
            </span>
            <p>
              <strong>{note.title}.</strong> {note.text}
            </p>
          </li>
        ))}
      </ol>
      <a class="spread__pdf" href="/samples/TR-0142-rev-b.pdf" download>
        <span>Download this document</span>
        <span class="mono">PDF · A4 · 1 sheet</span>
      </a>
    </div>

    <svg class="leaders" aria-hidden="true" data-leaders-svg></svg>
  </div>
</section>

<style>
  .spread {
    border-top: var(--rule) solid var(--text-strong);
  }

  .spread__grid {
    position: relative;
    row-gap: var(--sp-5);
  }

  .spread__text,
  .spread__sheet,
  .spread__notes {
    grid-column: 1 / -1;
  }

  .spread__text {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
  }

  .spread__lead {
    max-width: 40ch;
  }

  /* The page is a size container; one page pixel is 1/794 of its width. */
  .spread__sheet {
    display: grid;
    gap: var(--sp-2);
    margin: 0;
  }

  .spread__page {
    --u: calc(100cqi / 794);
    container-type: inline-size;
  }

  .spread__page article {
    display: block;
    width: 100%;
    aspect-ratio: 794 / 1123;
    overflow: hidden;
    outline: var(--rule) solid var(--text-strong);
  }

  .spread__caption {
    display: flex;
    gap: 0.75rem;
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .spread__caption .mono {
    flex: none;
    font-size: var(--s-2);
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-strong);
  }

  .spread__notes {
    display: grid;
    align-content: start;
    gap: var(--sp-5);
  }

  .notes {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .note {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .note p {
    max-width: 38ch;
    font-size: var(--s0);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .note strong {
    font-weight: 600;
    color: var(--text-strong);
  }

  .note__balloon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--text-strong);
    border-radius: 50%;
    background: var(--bg);
    font-size: var(--s-2);
    font-weight: 600;
    color: var(--text-strong);
  }

  .spread__pdf {
    display: inline-grid;
    justify-self: start;
    gap: 0.125rem;
    padding: 0.75rem 1.25rem 0.75rem 1rem;
    border: var(--rule) solid var(--text-strong);
    border-radius: var(--radius);
    color: var(--text-strong);
    font-weight: 600;
    text-decoration: none;
  }

  .spread__pdf .mono {
    font-size: var(--s-2);
    font-weight: 500;
    color: var(--text-muted);
  }

  .spread__pdf:hover {
    background: var(--tint);
  }

  .leaders {
    display: none;
  }

  /*
   * Desktop: the page holds zones 1 to 4. The heading and the notes take
   * zones 5 to 8, each note lower down the column than the one before, with
   * its leader running left to the part it describes.
   */
  @media (min-width: 64rem) {
    .spread__grid {
      grid-template-rows: auto 1fr;
      row-gap: 0;
    }

    .spread__sheet {
      grid-column: 1 / span 4;
      grid-row: 1 / span 2;
    }

    .spread__text {
      grid-column: 5 / -1;
      grid-row: 1;
    }

    .spread__notes {
      grid-column: 5 / span 3;
      grid-row: 2;
      position: relative;
    }

    /* Placed by the script, each level with its target where there is room. */
    .spread__notes.is-placed .notes {
      display: block;
    }

    .spread__notes.is-placed .note {
      position: absolute;
      left: var(--pad);
      right: var(--pad);
    }

    .spread__notes.is-placed .spread__pdf {
      position: absolute;
      left: var(--pad);
    }

    .leaders {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      height: 100%;
      max-width: none;
      overflow: visible;
      pointer-events: none;
    }

    .leaders :global(path) {
      fill: none;
      stroke: var(--text-strong);
      stroke-width: 1;
    }

    .leaders :global(.leader--page) {
      stroke: var(--ink);
    }

    .leaders :global(circle) {
      fill: var(--ink);
    }
  }
</style>

<script>
  // Leaders: from each note's balloon, a short shoulder to the left, then a
  // straight run to a dot on the part of the page it describes.
  for (const root of document.querySelectorAll<HTMLElement>('[data-leaders]')) {
    const svg = root.querySelector<SVGSVGElement>('[data-leaders-svg]');
    const page = root.querySelector<HTMLElement>('.spread__page');
    if (!svg || !page) continue;

    const column = root.querySelector<HTMLElement>('.spread__notes');
    const pdf = root.querySelector<HTMLElement>('.spread__pdf');

    // Each note goes level with its target, but never above the notes'
    // column or closer than a gap to the note before it.
    const place = () => {
      if (!column) return;
      if (getComputedStyle(svg).display === 'none') {
        column.classList.remove('is-placed');
        for (const note of column.querySelectorAll<HTMLElement>('[data-note]')) note.style.top = '';
        if (pdf) pdf.style.top = '';
        return;
      }
      column.classList.add('is-placed');
      const top = column.getBoundingClientRect().top;
      let floor = 32;
      for (const note of column.querySelectorAll<HTMLElement>('[data-note]')) {
        const target = page.querySelector<HTMLElement>(`[data-target="${note.dataset.note}"]`);
        const balloon = note.querySelector<HTMLElement>('.note__balloon');
        if (!target || !balloon) continue;
        const t = target.getBoundingClientRect();
        const want = t.top - top + Math.min(t.height / 2, 14) - balloon.offsetHeight / 2;
        const y = Math.max(want, floor);
        note.style.top = `${y}px`;
        floor = y + note.offsetHeight + 24;
      }
      if (pdf) {
        const pageBottom = page.getBoundingClientRect().bottom - top;
        pdf.style.top = `${Math.max(floor + 16, pageBottom - pdf.offsetHeight)}px`;
      }
    };

    const draw = () => {
      place();
      if (getComputedStyle(svg).display === 'none') return;
      const box = root.getBoundingClientRect();
      const pageBox = page.getBoundingClientRect();
      const f = (n: number) => n.toFixed(1);
      let out = '';
      for (const note of root.querySelectorAll<HTMLElement>('[data-note]')) {
        const target = page.querySelector<HTMLElement>(`[data-target="${note.dataset.note}"]`);
        const balloon = note.querySelector<HTMLElement>('.note__balloon');
        if (!target || !balloon) continue;
        const b = balloon.getBoundingClientRect();
        const t = target.getBoundingClientRect();
        const start = { x: b.left - box.left, y: b.top - box.top + b.height / 2 };
        const shoulder = start.x - 20;
        const end = { x: t.right - box.left - 10, y: t.top - box.top + Math.min(t.height / 2, 14) };
        const edge = pageBox.right - box.left;
        // The run crosses the page's edge; beyond it the line takes the page's ink.
        const k = (edge - shoulder) / (end.x - shoulder);
        const cross = { x: edge, y: start.y + (end.y - start.y) * k };
        out +=
          `<path d="M${f(start.x)} ${f(start.y)} H${f(shoulder)} L${f(cross.x)} ${f(cross.y)}"></path>` +
          `<path class="leader--page" d="M${f(cross.x)} ${f(cross.y)} L${f(end.x)} ${f(end.y)}"></path>` +
          `<circle cx="${f(end.x)}" cy="${f(end.y)}" r="3"></circle>`;
      }
      svg.setAttribute('viewBox', `0 0 ${f(box.width)} ${f(box.height)}`);
      svg.innerHTML = out;
    };

    draw();
    new ResizeObserver(draw).observe(root);
    document.fonts?.ready.then(draw);
  }
</script>
