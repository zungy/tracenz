---
/**
 * The deliverable: page 1 of the design document Trace writes, drawn at
 * reduced scale like a view on a sheet. Balloons with notes point at three
 * parts of it, and detail D repeats the change table's source column at
 * actual size.
 *
 * Note targets and the detail are given in page pixels (see DocPage). On
 * desktop the page spans six columns and the detail the last six, so both
 * compute the same page scale from their own width.
 */
import DocPage from './DocPage.astro';

const notes = [
  {
    title: 'Revision history',
    text: 'Each revision is listed with its date and what changed. Earlier revisions stay on record.',
    x: 721,
    y: 187,
  },
  {
    title: 'Sources',
    text: 'Every change cites the log entries it came from, so a reviewer can check it against the model.',
    x: 718,
    y: 533,
  },
  {
    title: 'Sign-off',
    text: 'Reviewers check and approve the document in Trace. Review is part of the Team plan.',
    x: 718,
    y: 1008,
  },
];

// Detail D, in page pixels: its center and radius.
const detail = { x: 585, y: 562, r: 195 };
---

<section id="how-it-works" class="section spread" aria-labelledby="spread-title">
  <div class="container">
    <div class="grid spread__head">
      <h2 id="spread-title">Design intent gets lost between revisions. Trace writes it down.</h2>
      <p class="spread__lead">
        This is the design document Trace wrote for the housing after an afternoon of changes: the
        overall design first, then every change since the last revision, each tied to its source.
      </p>
    </div>

    <figure class="grid docfig" style={`--dx: ${detail.x}; --dy: ${detail.y}; --dr: ${detail.r}`}>
      <div class="docfig__sheet">
        <article class="docfig__page scheme-paper" aria-label="Design document TR-0142, page 1">
          <DocPage id="doc" />
        </article>

        <svg class="docfig__region" aria-hidden="true" viewBox="0 0 100 100">
          <circle cx="50" cy="50" r="49.5"></circle>
        </svg>
        <span class="docfig__region-label mono" aria-hidden="true">
          D
        </span>

        <ol class="docfig__notes">
          {notes.map((note, i) => (
            <li class="note" style={`--tx: ${note.x}; --ty: ${note.y}`}>
              <span class="note__balloon mono" aria-hidden="true">
                {i + 1}
              </span>
              <p>
                <strong>{note.title}.</strong> {note.text}
              </p>
            </li>
          ))}
        </ol>
      </div>

      <div class="docfig__detail" aria-hidden="true">
        <div class="lens">
          <div class="lens__page scheme-paper" inert>
            <DocPage id="doc-detail" />
          </div>
        </div>
        <p class="lens__label mono">
          Detail D <span>Actual size</span>
        </p>
      </div>

      <figcaption class="docfig__caption">
        <span class="mono">Fig. 2</span>
        <span>Design document TR-0142, Rev B, page 1 of 3, as Trace wrote it.</span>
      </figcaption>
    </figure>
  </div>
</section>

<style>
  .spread {
    border-top: 1px solid var(--line-strong);
  }

  .spread__head {
    row-gap: var(--sp-3);
    align-items: end;
  }

  .spread__head h2,
  .spread__lead {
    grid-column: 1 / -1;
  }

  .spread__head h2 {
    font-size: clamp(var(--s4), 1.2rem + 2.4vw, 3.25rem);
    line-height: 1.05;
  }

  .spread__lead {
    max-width: 46ch;
    color: var(--text);
  }

  /* Figure */
  .docfig {
    row-gap: var(--sp-5);
    margin-top: var(--sp-8);
  }

  .docfig__sheet,
  .docfig__detail,
  .docfig__caption {
    grid-column: 1 / -1;
  }

  /* Both are size containers; one page pixel is 1/794 of their width. */
  .docfig__sheet,
  .docfig__detail {
    --u: calc(100cqi / 794);
    position: relative;
    container-type: inline-size;
  }

  .docfig__page {
    display: block;
    width: 100%;
    aspect-ratio: 794 / 1123;
    overflow: hidden;
    outline: 1px solid var(--text-strong);
  }

  /* Detail D's boundary on the page: a thin chain circle. */
  .docfig__region {
    position: absolute;
    left: calc((var(--dx) - var(--dr)) * var(--u));
    top: calc((var(--dy) - var(--dr)) * var(--u));
    width: calc(var(--dr) * 2 * var(--u));
    height: calc(var(--dr) * 2 * var(--u));
    overflow: visible;
    pointer-events: none;
  }

  /* Drawn on the page, which is paper in both themes, so always in cobalt. */
  .docfig__region circle {
    fill: none;
    stroke: var(--cobalt);
    stroke-width: 1.25;
    stroke-dasharray: 16 3 3 3;
    vector-effect: non-scaling-stroke;
  }

  /* The letter breaks the circle line on its right, in the page margin. */
  .docfig__region-label {
    position: absolute;
    left: calc((var(--dx) + var(--dr)) * var(--u));
    top: calc(var(--dy) * var(--u));
    padding: 0.125rem 0.25rem;
    background: var(--paper);
    font-size: var(--s-1);
    font-weight: 600;
    line-height: 1;
    color: var(--cobalt);
    transform: translate(-50%, -50%);
  }

  /* Notes, each opened by a balloon */
  .docfig__notes {
    display: grid;
    gap: var(--sp-3);
    margin: var(--sp-5) 0 0;
    padding: 0;
    list-style: none;
  }

  .note {
    display: grid;
    grid-template-columns: 1.75rem minmax(0, 1fr);
    gap: 0.875rem;
    align-items: start;
  }

  .note p {
    max-width: 36ch;
    font-size: var(--s-1);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .note strong {
    font-weight: 600;
    color: var(--text-strong);
  }

  .note__balloon {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1.5px solid var(--text-strong);
    border-radius: 50%;
    background: var(--bg);
    font-size: var(--s-2);
    font-weight: 600;
    color: var(--text-strong);
  }

  /* Detail view: the same page at actual size, seen through a circle. */
  .docfig__detail {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: var(--sp-2);
  }

  .lens {
    --r: min(calc(var(--dr) * 1px), 50cqi);
    position: relative;
    width: calc(var(--r) * 2);
    height: calc(var(--r) * 2);
    overflow: hidden;
    border: 1.5px solid var(--select);
    border-radius: 50%;
    background: var(--paper);
  }

  .lens__page {
    --u: 1px;
    position: absolute;
    left: calc(var(--r) - var(--dx) * 1px);
    top: calc(var(--r) - var(--dy) * 1px);
  }

  .lens__label {
    display: flex;
    gap: 0.75rem;
    font-size: var(--s-2);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .lens__label span {
    font-weight: 500;
    color: var(--text-muted);
  }

  .docfig__caption {
    display: flex;
    gap: 0.75rem;
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .docfig__caption .mono {
    flex: none;
    font-size: var(--s-2);
    font-weight: 600;
    line-height: 1.75;
    color: var(--text-strong);
  }

  @media (min-width: 64rem) {
    .spread__head h2 {
      grid-column: 1 / span 10;
    }

    .spread__lead {
      grid-column: 11 / -1;
      padding-bottom: 0.3rem;
    }

    .docfig__sheet {
      grid-column: 1 / span 6;
    }

    .docfig__detail {
      grid-column: 11 / -1;
    }

    /* The detail sits level with its boundary on the page. */
    .lens {
      margin-top: calc(var(--dy) * var(--u) - var(--r));
    }

    /*
     * Notes hang in the four columns right of the page, each level with the
     * point it describes. The column is four units and three gutters, taken
     * from the six-column sheet: unit = (100cqi - 5 gutters + edge) / 6.
     */
    .docfig__notes {
      position: absolute;
      top: 0;
      bottom: 0;
      left: calc(100% + var(--gutter));
      width: calc((100cqi - 5 * var(--gutter) + var(--edge)) * 4 / 6 + 3 * var(--gutter));
      margin: 0;
    }

    .note {
      position: absolute;
      top: calc(var(--ty) * var(--u) - 0.875rem);
      left: 0;
      right: 0;
    }

    /* Leader from the balloon to a dot on the page */
    .note::before,
    .note::after {
      content: '';
      position: absolute;
      top: 0.875rem;
      pointer-events: none;
    }

    /* Over the sheet the leader takes the theme's ink; over the page, always ink. */
    .note::before {
      right: 100%;
      width: calc(100cqi + var(--gutter) - var(--tx) * var(--u));
      height: 1px;
      background: linear-gradient(
        to left,
        var(--text-strong) var(--gutter),
        var(--ink) var(--gutter)
      );
    }

    .note::after {
      left: calc(var(--tx) * var(--u) - 100cqi - var(--gutter) - 3px);
      width: 7px;
      height: 7px;
      margin-top: -3px;
      border-radius: 50%;
      background: var(--ink);
    }
  }
</style>
