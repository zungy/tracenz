---
import LogoPlaceholder from '../LogoPlaceholder.astro';

// Placeholders for the CAD tools Trace supports. When real logos are added,
// give each one alt text with the tool's name and drop aria-hidden from the list.
const slots = 6;
---

<section class="works" aria-labelledby="works-title">
  <div class="container grid works__grid">
    <h2 id="works-title" class="label works__title">
      Works alongside the CAD tools you already use
    </h2>
    <ul class="works__logos" aria-hidden="true">
      {Array.from({ length: slots }, () => (
        <li>
          <LogoPlaceholder size={36} ratio={3.2} label="" />
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .works {
    padding-block: var(--sp-5);
    border-bottom: 1px solid var(--line);
  }

  .works__grid {
    row-gap: var(--sp-3);
    align-items: center;
  }

  .works__title {
    grid-column: 1 / -1;
    max-width: 30ch;
  }

  .works__logos {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sp-3) var(--gutter);
    padding: 0;
    list-style: none;
  }

  .works__logos :global(.logo-placeholder) {
    width: 100%;
    max-width: 8rem;
    height: auto;
  }

  @media (min-width: 40rem) {
    .works__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .works__title {
      grid-column: 1 / span 4;
    }

    .works__logos {
      grid-column: 5 / -1;
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
</style>
