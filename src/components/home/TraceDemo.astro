---
/**
 * Hero demo: a CAD change log fills in along the session timeline, then Trace
 * writes the design document from it. Animation is driven by the
 * `is-playing` class on the parent .hero (see Hero.astro); without it,
 * everything shows its finished state.
 */
import Icon from '../Icon.astro';

// Session timeline: sixteen sessions that bunch up toward the present,
// the way design work speeds up near a review.
const sessions = [
  0.047, 0.188, 0.25, 0.273, 0.312, 0.5, 0.609, 0.672, 0.734, 0.75, 0.852, 0.867, 0.898, 0.953,
  0.977, 0.992,
];

// The latest changes, one per recent session.
const log = [
  { time: '09:12', feature: 'Sketch 4', param: 'Dimension D3', from: '2.0', to: '2.5 mm' },
  { time: '09:14', feature: 'Extrude 2', param: 'Depth', from: '12', to: '14 mm' },
  { time: '09:31', feature: 'Fillet 7', param: 'Radius', from: 'R1.5', to: 'R2' },
  { time: '10:02', feature: 'Motor bracket', param: 'Part', added: true },
  { time: '10:07', feature: 'Mate 3', param: 'Coincident', added: true },
  { time: '10:20', feature: 'Housing', param: 'Material', from: 'ABS', to: 'PC-ABS' },
  { time: '10:24', feature: 'Pattern 1', param: 'Dust holes', from: '6', to: '8' },
  { time: '10:26', feature: 'Hole 3', param: 'Diameter', from: 'Ø8', to: 'Ø9' },
];
const recent = sessions.slice(-log.length);

const changes = [
  { text: 'Motor mount wall thickened from 2.0 to 2.5 mm.', ref: 0 },
  { text: 'Housing material changed from ABS to PC-ABS.', ref: 5 },
  { text: 'Dust extraction moved to 8 holes, each Ø9.', ref: 6 },
];
---

<figure class="demo" data-demo>
  <div class="demo__bar">
    <span class="demo__file mono">orbital-sander / housing</span>
    <span class="demo__live label">
      <span class="demo__dot" aria-hidden="true"></span>Logging
    </span>
    <button class="demo__replay" type="button" data-replay>
      <Icon name="rotate" size={16} />
      Replay
    </button>
  </div>

  <div class="timeline" aria-hidden="true">
    <div class="timeline__track">
      {sessions.map((at) => (
        <span class="timeline__tick" style={`--at: ${at}`} />
      ))}
      <span class="timeline__playhead"></span>
    </div>
    <div class="timeline__labels label">
      <span>16 sessions</span>
      <span class="num">71 changes</span>
    </div>
  </div>

  <ol class="log" aria-label="Latest changes">
    {log.map((row, i) => (
      <li class="log__row" style={`--at: ${recent[i]}`} data-row={i}>
        <span class="log__mark" aria-hidden="true" />
        <time class="log__time num">{row.time}</time>{' '}
        <span class="log__what">
          <span class="log__feature">{row.feature}</span>{' '}
          <span class="log__param">{row.param}</span>
        </span>{' '}
        {row.added ? (
          <span class="log__change">
            <ins class="log__added">added</ins>
          </span>
        ) : (
          <span class="log__change num">
            <span class="visually-hidden">from </span>
            <del>{row.from}</del>
            <Icon name="arrow-narrow-right" size={14} />
            <span class="visually-hidden"> to </span>
            <ins>{row.to}</ins>
          </span>
        )}
      </li>
    ))}
  </ol>

  <article class="doc scheme-paper" aria-label="Generated design document">
    <header class="doc__head doc__line" style="--i: 0">
      <p class="label">Design document</p>
      <span class="doc__rev mono" role="img" aria-label="Revision B">
        <svg viewBox="0 0 24 21" aria-hidden="true">
          <path d="M12 1.8 22.4 19.5H1.6Z"></path>
        </svg>
        <span aria-hidden="true">B</span>
      </span>
    </header>
    <p class="doc__title doc__line" style="--i: 1">
      Orbital sander housing
    </p>

    <section class="doc__section doc__line" style="--i: 2">
      <p class="label">Overview</p>
      <p>
        Two-piece PC-ABS housing around a 125 mm orbital pad. The motor sits on a bracket mated to
        the housing boss.
      </p>
    </section>

    <section class="doc__section">
      <p class="label doc__line" style="--i: 3">
        Changes since Rev A
      </p>
      <ul class="doc__changes">
        {changes.map((change, i) => (
          <li class="doc__line" style={`--i: ${i + 4}`}>
            <span>{change.text}</span>{' '}
            <span class="doc__ref mono num" data-ref={change.ref} title="Log entry">
              <Icon name="corner-down-right" size={12} />
              {log[change.ref].time}
            </span>
          </li>
        ))}
      </ul>
    </section>

    <p class="doc__foot mono doc__line" style="--i: 7">
      From 71 changes in 16 sessions
    </p>
  </article>

  <figcaption class="visually-hidden">
    Example project: Trace logs changes to an orbital sander housing and writes a design document
    from them.
  </figcaption>
</figure>

<style>
  .demo {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
  }

  /* Title bar */
  .demo__bar {
    display: flex;
    align-items: center;
    gap: var(--sp-2);
    min-height: 2.75rem;
    padding-inline: var(--sp-2) var(--sp-1);
    border-bottom: 1px solid var(--line);
  }

  .demo__file {
    font-size: var(--s-1);
    color: var(--text-strong);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .demo__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
    color: var(--text-strong);
  }

  .demo__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--accent);
  }

  @media (prefers-reduced-motion: no-preference) {
    .demo__dot {
      animation: pulse 2s ease-in-out infinite;
    }
  }

  @keyframes pulse {
    50% {
      opacity: 0.25;
    }
  }

  .demo__replay {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid transparent;
    border-radius: var(--radius);
    background: none;
    color: var(--text-muted);
    font-size: var(--s-1);
  }

  .demo__replay:hover {
    border-color: var(--line-strong);
    color: var(--text-strong);
  }

  @media (prefers-reduced-motion: reduce) {
    .demo__replay {
      display: none;
    }
  }

  /* Session timeline */
  .timeline {
    padding: var(--sp-2) var(--sp-2) 0;
  }

  .timeline__track {
    position: relative;
    height: 1.25rem;
    border-bottom: 1px solid var(--line-strong);
  }

  .timeline__tick {
    position: absolute;
    bottom: 0;
    left: calc(var(--at) * 100%);
    width: 1.5px;
    height: 0.75rem;
    background: var(--accent);
    transform-origin: bottom;
  }

  .timeline__playhead {
    position: absolute;
    top: -0.25rem;
    bottom: -0.25rem;
    left: 100%;
    width: 1px;
    background: var(--text-strong);
  }

  .timeline__playhead::before {
    content: '';
    position: absolute;
    top: 0;
    left: -4px;
    border: 4.5px solid transparent;
    border-top-color: var(--text-strong);
  }

  .timeline__labels {
    display: flex;
    justify-content: space-between;
    padding-top: 0.4rem;
  }

  /* Change log */
  .log {
    margin: 0;
    padding: var(--sp-1) 0 var(--sp-2);
    list-style: none;
  }

  .log__row {
    display: grid;
    grid-template-columns: 0.5rem 2.75rem minmax(0, 1fr) auto;
    align-items: center;
    column-gap: 0.75rem;
    padding: 0.45rem var(--sp-2);
    border-bottom: 1px solid var(--line-soft);
    font-size: var(--s-1);
    transition: background-color 160ms var(--ease);
  }

  .log__row.is-traced {
    background: var(--tint);
  }

  .log__mark {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--accent);
    border: 1.5px solid var(--accent);
  }

  .log__time {
    font-family: var(--font-mono);
    color: var(--text-muted);
  }

  .log__what {
    display: flex;
    flex-wrap: wrap;
    column-gap: 0.5rem;
    min-width: 0;
  }

  .log__feature {
    font-weight: 650;
    color: var(--text-strong);
  }

  .log__param {
    color: var(--text-muted);
  }

  .log__change {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-family: var(--font-mono);
    white-space: nowrap;
  }

  .log__change del {
    color: var(--text-muted);
    text-decoration-thickness: 1px;
  }

  .log__change ins {
    text-decoration: none;
    font-weight: 600;
    color: var(--text-strong);
  }

  .log__change :global(.icon) {
    color: var(--text-muted);
  }

  .log__added {
    padding: 0.05rem 0.4rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    font-size: var(--s-2);
    letter-spacing: 0.04em;
  }

  /* Generated document: a paper sheet in both themes */
  .doc {
    display: grid;
    gap: 0.75rem;
    margin: 0 var(--sp-2) var(--sp-2);
    padding: var(--sp-3);
    border: 1px solid var(--line);
    box-shadow: 0 18px 40px -12px rgb(25 44 100 / 0.28);
  }

  .doc__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .doc__rev {
    position: relative;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.55rem;
    font-size: var(--s-2);
    font-weight: 700;
    color: var(--mark);
  }

  .doc__rev svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    fill: none;
    stroke: var(--mark);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .doc__rev span {
    position: relative;
    top: 0.2rem;
  }

  .doc__title {
    font-family: var(--font-display);
    font-size: var(--s2);
    font-weight: 760;
    font-stretch: 108%;
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--text-strong);
  }

  .doc__section {
    display: grid;
    gap: 0.35rem;
  }

  .doc__section p,
  .doc__changes {
    font-size: var(--s-1);
    line-height: 1.5;
  }

  .doc__changes {
    display: grid;
    gap: 0.4rem;
    padding: 0;
    list-style: none;
  }

  .doc__changes li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--sp-2);
    padding-left: 0.9rem;
    position: relative;
  }

  .doc__changes li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.375rem;
    height: 0.375rem;
    border: 1.5px solid var(--accent);
  }

  .doc__ref {
    display: inline-flex;
    align-items: center;
    gap: 0.15rem;
    flex: none;
    padding: 0 0.3rem;
    border-radius: var(--radius);
    font-size: var(--s-2);
    color: var(--link);
    cursor: default;
  }

  .doc__ref:hover {
    background: var(--tint);
  }

  .doc__foot {
    padding-top: 0.75rem;
    border-top: 1px dashed var(--line);
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  @media (max-width: 39.99rem) {
    /* Keep the rows the document cites; drop two on narrow screens. */
    .log__row:nth-child(2),
    .log__row:nth-child(3) {
      display: none;
    }

    .log__row {
      grid-template-columns: 0.5rem 2.5rem minmax(0, 1fr) auto;
      column-gap: 0.5rem;
      padding-inline: 0.75rem;
    }

    .log__param {
      display: none;
    }

    .doc {
      margin-inline: 0.75rem;
      padding: var(--sp-2);
    }

    .doc__changes li {
      flex-direction: column;
      gap: 0.1rem;
    }
  }

  @media (min-width: 64rem) {
    .doc {
      margin: 0 calc(var(--sp-3) * -1) calc(var(--sp-3) * -1) var(--sp-5);
    }
  }

  /* Playback. Each element starts dimmed, never hidden, then settles. */
  :global(.hero.is-playing) .timeline__playhead {
    animation: sweep var(--play) linear both;
  }

  :global(.hero.is-playing) .timeline__tick {
    animation: tick-on 260ms var(--ease) both;
    animation-delay: calc(var(--at) * var(--play));
  }

  :global(.hero.is-playing) .log__row {
    animation: capture 320ms var(--ease) both;
    animation-delay: calc(var(--at) * var(--play));
  }

  :global(.hero.is-playing) .log__mark {
    animation: mark-on 200ms var(--ease) both;
    animation-delay: calc(var(--at) * var(--play) + 120ms);
  }

  :global(.hero.is-playing) .doc__line {
    animation: write 380ms var(--ease) both;
    animation-delay: calc(var(--play) + 150ms + var(--i) * 90ms);
  }

  @keyframes sweep {
    from {
      left: 0%;
    }
  }

  @keyframes tick-on {
    from {
      opacity: 0.25;
      transform: scaleY(0.4);
    }
  }

  @keyframes capture {
    from {
      opacity: 0.22;
      transform: translateX(-6px);
    }
  }

  @keyframes mark-on {
    from {
      background: transparent;
    }
  }

  @keyframes write {
    from {
      opacity: 0.14;
      transform: translateY(4px);
    }
  }
</style>

<script>
  // Hovering a reference in the document highlights the log entry it came from.
  for (const demo of document.querySelectorAll<HTMLElement>('[data-demo]')) {
    const rows = demo.querySelectorAll<HTMLElement>('[data-row]');
    for (const ref of demo.querySelectorAll<HTMLElement>('[data-ref]')) {
      const row = rows[Number(ref.dataset.ref)];
      ref.addEventListener('mouseenter', () => row?.classList.add('is-traced'));
      ref.addEventListener('mouseleave', () => row?.classList.remove('is-traced'));
    }
  }
</script>
