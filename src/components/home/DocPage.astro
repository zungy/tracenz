---
/**
 * Page 1 of the design document Trace writes, laid out as an A4 page
 * (794 × 1123 px at 96 dpi). Every size is a multiple of --u, one page
 * pixel, which the parent sets from its own width, so the page renders at
 * any scale; its figures are true to scale on the printed page.
 *
 * Elements the notes point at carry data-target: the revision block, the
 * change table's source column and the sign-off block.
 */
import HousingDetail from '../drawings/HousingDetail.astro';
import HousingSection from '../drawings/HousingSection.astro';

interface Props {
  /** Id prefix for the drawings, so the page can appear twice. */
  id: string;
}

const { id } = Astro.props;

const changes = [
  { id: '2.1', what: 'Motor mount wall', was: '2.0', now: '2.5', source: '09:12 Sketch 4' },
  { id: '2.2', what: 'Root fillet', was: 'R1.5', now: 'R2', source: '09:31 Fillet 7' },
  { id: '2.3', what: 'Housing material', was: 'ABS', now: 'PC-ABS', source: '10:20 Housing' },
  { id: '2.4', what: 'Bearing seat', was: 'Ø21.8', now: 'Ø22 H7', source: '10:24, 10:26' },
];
---

<div class="page">
  <header class="head">
    <span>Design document</span>
    <span class="num">TR-0142</span>
    <span class="num">Sheet 1 of 1</span>
  </header>

  <div class="top">
    <div class="titling">
      <p class="title">Orbital sander housing</p>
      <p class="meta num">Written by Trace from 71 changes in 16 sessions</p>
      <p class="meta num">22 Sep 2026</p>
    </div>
    <table class="revs" data-target="revs">
      <thead>
        <tr>
          <th scope="col">Rev</th>
          <th scope="col">Date</th>
          <th scope="col">Description</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>A</td>
          <td class="num">14 Aug 2026</td>
          <td>First release</td>
        </tr>
        <tr>
          <td>
            <span class="tri" aria-hidden="true">
              <svg viewBox="0 0 24 21">
                <path d="M12 1.5 22.5 19.5H1.5Z"></path>
              </svg>
              <span>B</span>
            </span>
            <span class="visually-hidden">B</span>
          </td>
          <td class="num">22 Sep 2026</td>
          <td>Wall, fillet, material, seat</td>
        </tr>
      </tbody>
    </table>
  </div>

  <section class="block overview">
    <h3 class="h">
      <span class="num">1</span> Overview
    </h3>
    <p class="text">
      The upper housing of a random orbital sander, molded in one piece around a 125 mm pad. The
      motor stands on a wall inside the housing, in a 608 bearing held by a boss under the wall; the
      palm grip closes the top, and the dust port leaves the skirt at the back.
    </p>
    <dl class="specs">
      <div>
        <dt>Height</dt>
        <dd class="num">124</dd>
      </div>
      <div>
        <dt>Rim</dt>
        <dd class="num">Ø124</dd>
      </div>
      <div>
        <dt>Wall</dt>
        <dd class="num">2.5 nominal</dd>
      </div>
      <div>
        <dt>Material</dt>
        <dd>
          PC-ABS
          <span class="tri tri--small" role="img" aria-label="changed in revision B">
            <svg viewBox="0 0 24 21" aria-hidden="true">
              <path d="M12 1.5 22.5 19.5H1.5Z"></path>
            </svg>
            <span aria-hidden="true">B</span>
          </span>
        </dd>
      </div>
    </dl>
  </section>

  <section class="block changes">
    <h3 class="h">
      <span class="num">2</span> Changes since Rev A
    </h3>
    <table class="table">
      <thead>
        <tr>
          <th scope="col">No.</th>
          <th scope="col">Change</th>
          <th scope="col">Was</th>
          <th scope="col">Now</th>
          <th scope="col" data-target="sources">
            Source
          </th>
        </tr>
      </thead>
      <tbody>
        {changes.map((c) => (
          <tr>
            <td class="num">{c.id}</td>
            <th scope="row">{c.what}</th>
            <td class="num">
              <del class="was">{c.was}</del>
            </td>
            <td class="num">
              <ins class="now">{c.now}</ins>
            </td>
            <td class="num src">↳ {c.source}</td>
          </tr>
        ))}
      </tbody>
    </table>
    <div class="figs">
      <figure>
        <HousingSection id={`${id}-sec`} />
        <figcaption>Fig. 1 Half section · 1:2.5</figcaption>
      </figure>
      <figure>
        <HousingDetail id={`${id}-det`} />
        <figcaption>Fig. 2 Detail A · 1:1</figcaption>
      </figure>
    </div>
  </section>

  <footer class="signoff" data-target="signoff">
    <div>
      <p class="k">Written</p>
      <p class="v">Trace</p>
      <p class="d num">22 Sep 2026</p>
    </div>
    <div>
      <p class="k">Checked</p>
      <p class="v">Waiting for review</p>
      <p class="d">–</p>
    </div>
    <div>
      <p class="k">Approved</p>
      <p class="v">–</p>
      <p class="d">–</p>
    </div>
  </footer>
</div>

<style>
  /* Sizes are page pixels times --u; the parent sets --u. */
  .page {
    display: grid;
    grid-template-rows:
      calc(32 * var(--u)) calc(120 * var(--u)) calc(170 * var(--u))
      calc(460 * var(--u)) 1fr calc(104 * var(--u));
    row-gap: calc(26 * var(--u));
    width: calc(794 * var(--u));
    height: calc(1123 * var(--u));
    padding: calc(56 * var(--u)) calc(64 * var(--u)) calc(48 * var(--u));
    background: var(--paper);
    color: var(--ink);
    font-family: var(--font-body);
    font-size: calc(13.5 * var(--u));
    line-height: 1.5;
    text-align: left;
  }

  /* Drawings print at their true scale on the page. */
  .page :global(.dwg) {
    --dwg-ink: var(--ink);
    --w-thick: calc(1.9 * var(--u));
    --w-thin: calc(0.8 * var(--u));
    width: calc(var(--paper-w) * 3.7795 * var(--u));
    max-width: none;
  }

  .page :global(.dwg .chain) {
    stroke-dasharray: calc(12 * var(--u)) calc(2.5 * var(--u)) calc(2 * var(--u))
      calc(2.5 * var(--u));
  }

  .page :global(.dwg .hidden) {
    stroke-dasharray: calc(4 * var(--u)) calc(2 * var(--u));
  }

  .page :global(.dwg .halo) {
    stroke-width: calc(4 * var(--u));
  }

  .page :global(.dwg .rev-cloud) {
    stroke-width: calc(1.25 * var(--u));
  }

  .head {
    display: flex;
    gap: calc(24 * var(--u));
    align-items: start;
    border-bottom: calc(2 * var(--u)) solid var(--ink);
    font-family: var(--font-mono);
    font-size: calc(11 * var(--u));
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .head span:nth-child(2) {
    margin-left: auto;
  }

  .top {
    display: grid;
    grid-template-columns: minmax(0, 1fr) calc(300 * var(--u));
    gap: calc(32 * var(--u));
  }

  .titling {
    display: grid;
    align-content: start;
    gap: calc(4 * var(--u));
  }

  .title {
    margin-bottom: calc(8 * var(--u));
    font-family: var(--font-display);
    font-size: calc(32 * var(--u));
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.01em;
  }

  .meta {
    font-family: var(--font-mono);
    font-size: calc(11.5 * var(--u));
    color: rgb(25 44 100 / 0.75);
  }

  /* Tables: 1px rules, a heavier rule under the header row. */
  table {
    width: 100%;
    border-collapse: collapse;
    font-size: calc(12.5 * var(--u));
  }

  th,
  td {
    padding: calc(6 * var(--u)) calc(8 * var(--u));
    border: calc(1 * var(--u)) solid var(--vellum);
    text-align: left;
    vertical-align: middle;
    font-weight: 400;
  }

  thead th {
    border-bottom: calc(1.5 * var(--u)) solid var(--ink);
    font-family: var(--font-mono);
    font-size: calc(10.5 * var(--u));
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(25 44 100 / 0.75);
  }

  .revs {
    align-self: start;
    border: calc(1.5 * var(--u)) solid var(--ink);
  }

  .revs td:first-child {
    width: calc(44 * var(--u));
    font-family: var(--font-mono);
    font-weight: 600;
  }

  /* Revision triangles: redline, as on the drawings. */
  .tri {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: calc(20 * var(--u));
    height: calc(17.5 * var(--u));
    vertical-align: middle;
  }

  .tri svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: var(--redline);
  }

  .tri span {
    position: relative;
    top: calc(2.5 * var(--u));
    font-family: var(--font-mono);
    font-size: calc(9.5 * var(--u));
    font-weight: 600;
    color: var(--paper);
  }

  .tri--small {
    width: calc(16 * var(--u));
    height: calc(14 * var(--u));
    margin-left: calc(6 * var(--u));
  }

  .tri--small span {
    top: calc(2 * var(--u));
    font-size: calc(8 * var(--u));
  }

  .block {
    display: grid;
    align-content: start;
    gap: calc(12 * var(--u));
  }

  .h {
    display: flex;
    gap: calc(10 * var(--u));
    font-family: var(--font-body);
    font-size: calc(15 * var(--u));
    font-weight: 600;
    line-height: 1.4;
    letter-spacing: 0;
    color: var(--ink);
  }

  .h .num {
    font-family: var(--font-mono);
    font-weight: 500;
    color: rgb(25 44 100 / 0.6);
  }

  .text {
    max-width: calc(640 * var(--u));
  }

  .specs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin-top: calc(4 * var(--u));
    border-block: calc(1 * var(--u)) solid var(--vellum);
  }

  .specs div {
    display: grid;
    gap: calc(2 * var(--u));
    padding: calc(10 * var(--u)) 0;
  }

  .specs div + div {
    padding-left: calc(14 * var(--u));
    border-left: calc(1 * var(--u)) solid var(--vellum);
  }

  .specs dt {
    font-family: var(--font-mono);
    font-size: calc(10.5 * var(--u));
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(25 44 100 / 0.75);
  }

  .specs dd {
    display: flex;
    align-items: center;
    font-size: calc(15 * var(--u));
    font-weight: 600;
  }

  .table {
    border: calc(1.5 * var(--u)) solid var(--ink);
  }

  .table tbody th {
    font-weight: 600;
  }

  .table td:first-child {
    width: calc(40 * var(--u));
    font-family: var(--font-mono);
    color: rgb(25 44 100 / 0.75);
  }

  .table td.num {
    font-family: var(--font-mono);
  }

  .was {
    color: rgb(25 44 100 / 0.66);
    text-decoration: line-through;
  }

  .now {
    font-weight: 600;
    text-decoration: none;
  }

  .src {
    white-space: nowrap;
  }

  .figs {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: calc(16 * var(--u));
    margin-top: calc(4 * var(--u));
  }

  .figs figure {
    display: grid;
    gap: calc(6 * var(--u));
  }

  .figs figcaption {
    font-family: var(--font-mono);
    font-size: calc(10.5 * var(--u));
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(25 44 100 / 0.75);
  }

  /* Sign-off block at the foot of the page, like a drawing's title block */
  .signoff {
    grid-row: 6;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: calc(1.5 * var(--u)) solid var(--ink);
  }

  .signoff div {
    display: grid;
    align-content: start;
    gap: calc(4 * var(--u));
    padding: calc(12 * var(--u)) calc(14 * var(--u));
  }

  .signoff div + div {
    border-left: calc(1 * var(--u)) solid var(--vellum);
  }

  .k {
    font-family: var(--font-mono);
    font-size: calc(10.5 * var(--u));
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: rgb(25 44 100 / 0.75);
  }

  .v {
    font-size: calc(15 * var(--u));
    font-weight: 600;
  }

  .d {
    font-family: var(--font-mono);
    font-size: calc(11.5 * var(--u));
    color: rgb(25 44 100 / 0.75);
  }
</style>
