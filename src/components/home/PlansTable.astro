---
/**
 * Plans as a compact drawing table: one column per plan with its price and
 * button in the header, features below, table notes underneath. The
 * recommended plan's column carries CAD selection handles.
 */
import Icon from '../Icon.astro';
import { plans } from '../../config/pricing';

type Cell = string | boolean;
const rows: { desc: string; values: [Cell, Cell, Cell] }[] = [
  { desc: 'Active projects', values: ['1', 'Unlimited', 'Unlimited'] },
  { desc: 'Change history', values: ['30 days', 'Full', 'Full'] },
  { desc: 'Design documents', values: ['3 a month', 'Unlimited', 'Unlimited'] },
  { desc: 'Export', values: ['PDF', 'PDF, Word, Markdown', 'PDF, Word, Markdown'] },
  { desc: 'Custom templates', values: [false, true, true] },
  { desc: 'Shared projects and review', values: [false, false, true] },
  { desc: 'Support', values: ['Community', 'Email', 'Priority'] },
];
const recommended = plans.findIndex((p) => p.recommended);
---

<section class="section plans" aria-labelledby="plans-title">
  <div class="container grid plans__grid">
    <div class="plans__head">
      <p class="mono plans__ref">Table 1</p>
      <h2 id="plans-title">Free for your first project.</h2>
      <p>Upgrade when you need more projects, the full history or team review.</p>
    </div>

    <div class="plans__body">
      <div class="plans__scroll" role="region" aria-label="Plans table" tabindex="0">
        <div class="plans__frame">
          <table>
            <colgroup>
              <col class="col-desc" />
              {plans.map(() => (
                <col class="col-plan" />
              ))}
            </colgroup>
            <thead>
              <tr>
                <td class="corner"></td>
                {plans.map((plan) => (
                  <th scope="col" class="plan">
                    <span class="plan__name">{plan.name}</span>
                    <span class="plan__for">{plan.summary}</span>
                    <span class="plan__price num">${plan.monthly}</span>
                    <span class="plan__unit">{plan.unit}</span>
                    <a
                      class:list={[
                        'btn',
                        'btn--sm',
                        'btn--block',
                        plan.recommended ? 'btn--primary' : 'btn--secondary',
                      ]}
                      href={plan.cta.href}
                    >
                      {plan.cta.label}
                    </a>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <th scope="row">{row.desc}</th>
                  {row.values.map((value) =>
                    value === true ? (
                      <td>
                        <Icon name="check" size={18} stroke={2} />
                        <span class="visually-hidden">Included</span>
                      </td>
                    ) : value === false ? (
                      <td>
                        <span class="none" aria-hidden="true" />
                        <span class="visually-hidden">Not included</span>
                      </td>
                    ) : (
                      <td>{value}</td>
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          </table>
          <div class="plans__overlay" aria-hidden="true">
            <span class="handles" style={`grid-column: ${recommended + 2}`}>
              <span class="plans__tag mono">Recommended</span>
            </span>
          </div>
        </div>
      </div>

      <ol class="plans__notes">
        <li>Prices in USD per month. Yearly billing saves two months.</li>
        <li>
          Every limit and feature is on the <a href="/pricing">pricing page</a>.
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .plans {
    border-top: 1px solid var(--line-strong);
  }

  .plans__grid {
    row-gap: var(--sp-5);
  }

  .plans__head,
  .plans__body {
    grid-column: 1 / -1;
  }

  .plans__head {
    display: grid;
    align-content: start;
    gap: var(--sp-2);
  }

  .plans__ref {
    font-size: var(--s-2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .plans__head h2 {
    font-size: clamp(var(--s4), 1.2rem + 2vw, 2.75rem);
  }

  .plans__head p:last-child {
    max-width: 30ch;
    color: var(--text);
  }

  /* position: relative keeps screen-reader labels inside the scroll area. */
  .plans__scroll {
    position: relative;
    overflow-x: auto;
    padding: 28px 8px 8px;
    margin: -28px -8px -8px;
  }

  .plans__frame {
    position: relative;
    min-width: 40rem;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    border: 1.5px solid var(--text-strong);
    font-size: var(--s-1);
  }

  .col-desc {
    width: 28%;
  }

  .col-plan {
    width: 24%;
  }

  th,
  td {
    padding: 0.75rem var(--sp-2);
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
    color: var(--text-strong);
  }

  thead th,
  thead td {
    border-bottom: 1.5px solid var(--text-strong);
    vertical-align: top;
  }

  .plan {
    padding-block: var(--sp-3) var(--sp-2);
    font-weight: 400;
  }

  .plan__name,
  .plan__for,
  .plan__price,
  .plan__unit {
    display: block;
  }

  .plan__name {
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .plan__for {
    min-height: 2.6em;
    margin-top: 0.3rem;
    font-size: var(--s-1);
    line-height: 1.3;
    color: var(--text-muted);
  }

  .plan__price {
    margin-top: var(--sp-2);
    font-family: var(--font-display);
    font-size: var(--s6);
    font-weight: var(--display-weight);
    font-stretch: 110%;
    line-height: 1;
    letter-spacing: -0.03em;
  }

  .plan__unit {
    margin: 0.3rem 0 var(--sp-2);
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  tbody th {
    font-weight: 500;
  }

  td :global(.icon) {
    color: var(--text-strong);
  }

  /* Not included: a short thin rule */
  .none {
    display: inline-block;
    width: 0.875rem;
    border-top: 1px solid var(--line-strong);
    vertical-align: middle;
  }

  /* Selection handles around the recommended column, on the table's own column grid. */
  .plans__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 28% 24% 24% 24%;
    pointer-events: none;
  }

  .plans__overlay .handles {
    grid-row: 1;
    background: var(--tint);
  }

  .plans__tag {
    position: absolute;
    left: -1px;
    bottom: calc(100% + 6px);
    padding: 0.2rem 0.45rem;
    background: var(--select);
    color: var(--bg);
    font-size: 0.6875rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .plans__notes {
    display: grid;
    gap: 0.25rem;
    margin-top: var(--sp-3);
    padding-left: 1.25rem;
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .plans__head {
      grid-column: 1 / span 4;
    }

    .plans__body {
      grid-column: 5 / -1;
    }
  }
</style>
