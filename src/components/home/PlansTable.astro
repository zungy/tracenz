---
/**
 * Plans as one drawing table: a column per plan with its price and button in
 * the header, features below, table notes underneath. The section heading
 * and the Monthly / Yearly switch sit in the table's corner cell on desktop
 * (above the table on smaller screens). The switch is two radio inputs and
 * CSS :has() swaps the prices, so it works without JavaScript. The
 * recommended plan's column carries CAD selection handles, with its tag hung
 * from the top grip on a leader.
 */
import Icon from '../Icon.astro';
import { plans } from '../../config/pricing';

type Cell = string | boolean;
const rows: { desc: string; values: [Cell, Cell, Cell] }[] = [
  { desc: 'Active projects', values: ['1', 'Unlimited', 'Unlimited'] },
  { desc: 'Change history', values: ['30 days', 'Full', 'Full'] },
  { desc: 'Design documents', values: ['3 a month', 'Unlimited', 'Unlimited'] },
  { desc: 'Export', values: ['PDF', 'PDF, Word, Markdown', 'PDF, Word, Markdown'] },
  { desc: 'Custom templates', values: [false, true, true] },
  { desc: 'Shared projects and review', values: [false, false, true] },
  { desc: 'Support', values: ['Community', 'Email', 'Priority'] },
];
const recommended = plans.findIndex((p) => p.recommended);
---

<section class="section plans" aria-labelledby="plans-title">
  <div class="container">
    <div class="plans__frame">
      <div class="plans__head">
        <p class="label">Table 1 · Plans</p>
        <h2 id="plans-title">Free for your first project.</h2>
        <p class="plans__intro">
          Upgrade when you need more projects, the full history or team review.
        </p>
        <fieldset class="billing">
          <legend class="visually-hidden">Billing period</legend>
          <input type="radio" name="plans-billing" id="plans-monthly" checked />
          <label for="plans-monthly">Monthly</label>
          <input type="radio" name="plans-billing" id="plans-yearly" />
          <label for="plans-yearly">Yearly</label>
        </fieldset>
      </div>

      <div class="plans__scroll" role="region" aria-label="Plans table" tabindex="0">
        <div class="plans__table">
          <table>
            <colgroup>
              <col class="col-desc" />
              {plans.map(() => (
                <col class="col-plan" />
              ))}
            </colgroup>
            <thead>
              <tr>
                <td class="corner"></td>
                {plans.map((plan) => (
                  <th scope="col" class="plan">
                    <span class="plan__name">{plan.name}</span>
                    <span class="plan__for">{plan.summary}</span>
                    <span class="plan__price num">
                      <span class="price-monthly">${plan.monthly}</span>
                      <span class="price-yearly">${plan.yearly}</span>
                    </span>
                    <span class="plan__unit">
                      {plan.unit}
                      {plan.monthly > 0 && <span class="price-yearly">, billed yearly</span>}
                    </span>
                    <a
                      class:list={[
                        'btn',
                        'btn--sm',
                        'btn--block',
                        plan.recommended ? 'btn--primary' : 'btn--secondary',
                      ]}
                      href={plan.cta.href}
                    >
                      {plan.cta.label}
                    </a>
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {rows.map((row) => (
                <tr>
                  <th scope="row">{row.desc}</th>
                  {row.values.map((value) =>
                    value === true ? (
                      <td>
                        <Icon name="check" size={18} stroke={2} />
                        <span class="visually-hidden">Included</span>
                      </td>
                    ) : value === false ? (
                      <td>
                        <span class="none" aria-hidden="true" />
                        <span class="visually-hidden">Not included</span>
                      </td>
                    ) : (
                      <td>{value}</td>
                    ),
                  )}
                </tr>
              ))}
            </tbody>
          </table>
          <div class="plans__overlay" aria-hidden="true">
            <span class="handles" style={`grid-column: ${recommended + 2}`}>
              <span class="plans__tag mono">Recommended</span>
            </span>
          </div>
        </div>
      </div>

      <ol class="plans__notes">
        <li>Prices in USD. Yearly billing costs ten months.</li>
        <li>
          Every limit and feature is on the <a href="/pricing">pricing page</a>.
        </li>
      </ol>
    </div>
  </div>
</section>

<style>
  .plans {
    border-top: 1px solid var(--line-strong);
  }

  .plans__frame {
    position: relative;
    display: grid;
    gap: var(--sp-5);
  }

  .plans__head {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: 0.75rem;
  }

  .plans__head h2 {
    font-size: clamp(var(--s4), 1.2rem + 1.6vw, 2.5rem);
    line-height: 1.08;
  }

  .plans__intro {
    max-width: 30ch;
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  /* Monthly / Yearly */
  .billing {
    display: inline-flex;
    margin-top: 0.25rem;
    padding: 3px;
    border: 1px solid var(--text-strong);
    border-radius: var(--radius);
  }

  .billing input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .billing label {
    display: grid;
    place-items: center;
    min-height: 2rem;
    padding-inline: 0.875rem;
    border-radius: 1px;
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
  }

  .billing input:checked + label {
    background: var(--text-strong);
    color: var(--bg);
  }

  .billing input:focus-visible + label {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .price-yearly {
    display: none;
  }

  .plans:has(#plans-yearly:checked) .price-monthly {
    display: none;
  }

  .plans:has(#plans-yearly:checked) .price-yearly {
    display: inline;
  }

  /* position: relative keeps screen-reader labels inside the scroll area. */
  .plans__scroll {
    position: relative;
    overflow-x: auto;
    padding: 3rem 8px 8px;
    margin: -3rem -8px -8px;
  }

  .plans__table {
    position: relative;
    min-width: 40rem;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    border: 2px solid var(--text-strong);
    background: var(--surface);
    font-size: var(--s-1);
  }

  .col-desc {
    width: 28%;
  }

  .col-plan {
    width: 24%;
  }

  th,
  td {
    padding: 0.75rem var(--sp-3);
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
    color: var(--text-strong);
  }

  thead th,
  thead td {
    border-bottom: 1px solid var(--text-strong);
    vertical-align: top;
  }

  .plan {
    padding-block: var(--sp-3);
    font-weight: 400;
  }

  .plan__name,
  .plan__for,
  .plan__price,
  .plan__unit {
    display: block;
  }

  .plan__name {
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .plan__for {
    min-height: 2.6em;
    margin-top: 0.25rem;
    font-size: var(--s-1);
    line-height: 1.3;
    color: var(--text-muted);
  }

  .plan__price {
    margin-top: var(--sp-3);
    font-size: var(--s6);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .plan__unit {
    margin: 0.375rem 0 var(--sp-3);
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  tbody th {
    font-weight: 500;
  }

  td :global(.icon) {
    color: var(--text-strong);
  }

  /* Not included: a short thin rule */
  .none {
    display: inline-block;
    width: 0.875rem;
    border-top: 1px solid var(--line-strong);
    vertical-align: middle;
  }

  /* Selection handles around the recommended column, on the table's own column grid. */
  .plans__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 28% 24% 24% 24%;
    pointer-events: none;
  }

  .plans__overlay .handles {
    grid-row: 1;
  }

  /* The tag hangs above the top middle grip on a short leader. */
  .plans__tag {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 1.75rem);
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--select);
    background: var(--bg);
    color: var(--select);
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    line-height: 1.2;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .plans__tag::after {
    content: '';
    position: absolute;
    top: 100%;
    left: 50%;
    height: calc(1.75rem - 5px);
    border-left: 1px solid var(--select);
  }

  .plans__notes {
    display: grid;
    gap: 0.25rem;
    padding-left: 1.25rem;
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  /*
   * Desktop: the heading block moves into the table's empty corner cell,
   * whose height it sets.
   */
  @media (min-width: 64rem) {
    .plans__frame {
      gap: var(--sp-3);
    }

    .plans__head {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;
      width: 28%;
      padding: var(--sp-3);
    }

    .corner {
      height: 18.5rem;
    }

    .plans__scroll {
      grid-row: 1;
    }
  }
</style>
