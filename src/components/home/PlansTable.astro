---
/**
 * Plans as a drawing's parts list: item, description, one column per plan,
 * prices in the header and a button at the foot of each column. The
 * recommended plan's column carries CAD selection handles.
 */
import Icon from '../Icon.astro';
import { plans } from '../../config/pricing';

type Cell = string | boolean;
const rows: { desc: string; values: [Cell, Cell, Cell] }[] = [
  { desc: 'Active projects', values: ['1', 'Unlimited', 'Unlimited'] },
  { desc: 'Change history', values: ['30 days', 'Full', 'Full'] },
  { desc: 'Design documents', values: ['3 a month', 'Unlimited', 'Unlimited'] },
  { desc: 'Export', values: ['PDF', 'PDF, Word, Markdown', 'PDF, Word, Markdown'] },
  { desc: 'Custom document templates', values: [false, true, true] },
  { desc: 'Shared projects and review', values: [false, false, true] },
  { desc: 'Support', values: ['Community', 'Email', 'Priority'] },
];
const recommended = plans.findIndex((p) => p.recommended);
---

<section class="section plans" aria-labelledby="plans-title">
  <div class="container">
    <div class="grid plans__head">
      <p class="label plans__callout">Table 1 · Plans · USD per month</p>
      <h2 id="plans-title">Free for your first project.</h2>
      <p class="plans__note">
        Yearly billing saves two months. <a href="/pricing">Compare every detail</a>
      </p>
    </div>

    <div class="plans__scroll" role="region" aria-label="Plans table" tabindex="0">
      <div class="plans__frame">
        <table>
          <colgroup>
            <col class="col-item" />
            <col class="col-desc" />
            {plans.map(() => (
              <col class="col-plan" />
            ))}
          </colgroup>
          <thead>
            <tr>
              <th scope="col" class="item">
                Item
              </th>
              <th scope="col">Description</th>
              {plans.map((plan) => (
                <th scope="col" class="plan">
                  <span class="plan__name">{plan.name}</span>
                  <span class="plan__price num">${plan.monthly}</span>
                  <span class="plan__unit">{plan.unit}</span>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr>
                <td class="item mono num">{i + 1}</td>
                <th scope="row">{row.desc}</th>
                {row.values.map((value) =>
                  value === true ? (
                    <td>
                      <Icon name="check" size={18} stroke={2} />
                      <span class="visually-hidden">Included</span>
                    </td>
                  ) : value === false ? (
                    <td>
                      <span class="no" aria-hidden="true" />
                      <span class="visually-hidden">Not included</span>
                    </td>
                  ) : (
                    <td>{value}</td>
                  ),
                )}
              </tr>
            ))}
          </tbody>
          <tfoot>
            <tr>
              <td class="item"></td>
              <td></td>
              {plans.map((plan) => (
                <td>
                  <a
                    class:list={[
                      'btn',
                      'btn--block',
                      plan.recommended ? 'btn--primary' : 'btn--secondary',
                    ]}
                    href={plan.cta.href}
                  >
                    {plan.cta.label}
                  </a>
                </td>
              ))}
            </tr>
          </tfoot>
        </table>
        <div class="plans__overlay" aria-hidden="true">
          <span class="handles" style={`grid-column: ${recommended + 3}`}></span>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .plans {
    border-bottom: 1px solid var(--line-strong);
  }

  .plans__head {
    row-gap: var(--sp-2);
    align-items: end;
    margin-bottom: var(--sp-5);
  }

  .plans__head > * {
    grid-column: 1 / -1;
  }

  .plans__head h2 {
    font-size: clamp(var(--s4), 1.3rem + 2.4vw, 3rem);
  }

  .plans__note {
    color: var(--text);
  }

  /* position: relative keeps screen-reader labels inside the scroll area. */
  .plans__scroll {
    position: relative;
    overflow-x: auto;
    padding: 6px;
    margin: -6px;
  }

  .plans__frame {
    position: relative;
    min-width: 46rem;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    border: 1.5px solid var(--text-strong);
    font-size: var(--s-1);
  }

  .col-item {
    width: 6%;
  }

  .col-desc {
    width: 31%;
  }

  .col-plan {
    width: 21%;
  }

  th,
  td {
    padding: 0.8rem var(--sp-2);
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
    color: var(--text-strong);
  }

  thead th {
    border-bottom: 1.5px solid var(--text-strong);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    vertical-align: bottom;
  }

  thead th.plan {
    padding-block: var(--sp-2);
  }

  .plan__name,
  .plan__price,
  .plan__unit {
    display: block;
  }

  .plan__name {
    color: var(--text-strong);
  }

  .plan__price {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-size: var(--s6);
    font-weight: 780;
    font-stretch: 112%;
    line-height: 1;
    letter-spacing: -0.03em;
    text-transform: none;
    color: var(--text-strong);
  }

  .plan__unit {
    margin-top: 0.3rem;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  tbody th {
    font-weight: 500;
  }

  .item {
    color: var(--text-muted);
    text-align: center;
  }

  tfoot td {
    padding-block: var(--sp-2);
    border-top: 1.5px solid var(--text-strong);
  }

  td :global(.icon) {
    color: var(--text-strong);
  }

  /* Not included: a short hidden-line dash */
  .no {
    display: inline-block;
    width: 1.25rem;
    border-top: 1.5px dashed var(--line-strong);
    vertical-align: middle;
  }

  /* Selection handles around the recommended column, on the same column grid as the table. */
  .plans__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: 6% 31% 21% 21% 21%;
    pointer-events: none;
  }

  .plans__overlay .handles {
    grid-row: 1;
    background: var(--tint);
    mix-blend-mode: multiply;
  }

  :global(:root[data-theme='dark']) .plans__overlay .handles {
    mix-blend-mode: normal;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme='light'])) .plans__overlay .handles {
      mix-blend-mode: normal;
    }
  }

  @media (min-width: 64rem) {
    .plans__callout {
      grid-column: 1 / span 6;
      grid-row: 1;
    }

    .plans__head h2 {
      grid-column: 1 / span 10;
      grid-row: 2;
    }

    .plans__note {
      grid-column: 11 / -1;
      grid-row: 2;
      justify-self: end;
      padding-bottom: 0.35rem;
      text-align: right;
    }
  }
</style>
