---
/**
 * Plans as one drawing table, laid out like a parts list: an item column,
 * a column per plan with its price and button in the header, values in mono
 * and a keyed note underneath. On desktop the table runs the full width of
 * the sheet, its columns on the zone lines and its sides on the border; the
 * section heading and the Monthly / Yearly switch fill its corner cell.
 *
 * The switch is two radio inputs and CSS :has() swaps the prices, so it
 * works without JavaScript. The recommended plan's column carries CAD
 * selection handles.
 */
import Icon from '../Icon.astro';
import { plans } from '../../config/pricing';

type Cell = string | boolean;
const rows: { desc: string; values: [Cell, Cell, Cell] }[] = [
  { desc: 'Active projects', values: ['1', 'Unlimited', 'Unlimited'] },
  { desc: 'Change history', values: ['30 days', 'Full', 'Full'] },
  { desc: 'Design documents', values: ['3 a month', 'Unlimited', 'Unlimited'] },
  { desc: 'Export', values: ['PDF', 'PDF, Word, MD', 'PDF, Word, MD'] },
  { desc: 'Custom templates', values: [false, true, true] },
  { desc: 'Shared projects and review', values: [false, false, true] },
  { desc: 'Support', values: ['Community', 'Email', 'Priority'] },
];
const recommended = plans.findIndex((p) => p.recommended);
---

<section class="plans" aria-labelledby="plans-title" data-row>
  <div class="container plans__frame">
    <div class="plans__head">
      <h2 id="plans-title" class="title">
        Free for your first project.
      </h2>
      <p class="plans__intro">Pay when you need more projects, the full history or team review.</p>
      <fieldset class="billing">
        <legend class="visually-hidden">Billing period</legend>
        <input type="radio" name="plans-billing" id="plans-monthly" checked />
        <label for="plans-monthly">Monthly</label>
        <input type="radio" name="plans-billing" id="plans-yearly" />
        <label for="plans-yearly">Yearly</label>
      </fieldset>
    </div>

    <div class="plans__scroll" role="region" aria-label="Plans table" tabindex="0">
      <div class="plans__table">
        <table>
          <colgroup>
            <col class="col-desc" />
            {plans.map(() => (
              <col class="col-plan" />
            ))}
          </colgroup>
          <thead>
            <tr>
              <td class="corner"></td>
              {plans.map((plan) => (
                <th scope="col" class="plan">
                  <span class="plan__name">{plan.name}</span>
                  <span class="plan__for">{plan.summary}</span>
                  <span class="plan__price num">
                    <span class="price-monthly">${plan.monthly}</span>
                    <span class="price-yearly">${plan.yearly}</span>
                  </span>
                  <span class="plan__unit">
                    {plan.unit}
                    {plan.monthly > 0 && <span class="price-yearly">, billed yearly</span>}
                    <sup class="plan__key mono">1</sup>
                  </span>
                  <a
                    class:list={[
                      'btn',
                      'btn--sm',
                      'btn--block',
                      plan.recommended ? 'btn--primary' : 'btn--secondary',
                    ]}
                    href={plan.cta.href}
                  >
                    {plan.cta.label}
                  </a>
                </th>
              ))}
            </tr>
          </thead>
          <tbody>
            {rows.map((row, i) => (
              <tr>
                <th scope="row">
                  <span class="item mono num">{String(i + 1).padStart(2, '0')}</span>
                  {row.desc}
                </th>
                {row.values.map((value) =>
                  value === true ? (
                    <td>
                      <Icon name="check" size={18} stroke={2} />
                      <span class="visually-hidden">Included</span>
                    </td>
                  ) : value === false ? (
                    <td>
                      <span class="none" aria-hidden="true" />
                      <span class="visually-hidden">Not included</span>
                    </td>
                  ) : (
                    <td class="mono">{value}</td>
                  ),
                )}
              </tr>
            ))}
          </tbody>
        </table>
        <div class="plans__overlay" aria-hidden="true">
          <span class="handles" style={`grid-column: ${recommended + 2}`}>
            <span class="plans__tag mono">Recommended</span>
          </span>
        </div>
      </div>
    </div>

    <div class="plans__foot">
      <p class="plans__notes mono">
        <span>Notes</span>
        <span>
          <sup>1</sup> Prices in USD per month. Yearly billing costs ten months.
        </span>
      </p>
      <a class="plans__more" href="/pricing">
        Compare every feature
      </a>
    </div>
  </div>
</section>

<style>
  .plans {
    padding-block: var(--section-pad);
    border-top: var(--rule) solid var(--text-strong);
  }

  .plans__frame {
    position: relative;
    display: grid;
    gap: var(--sp-5);
  }

  .plans__head {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--sp-2);
  }

  .plans__intro {
    max-width: 30ch;
    color: var(--text-muted);
  }

  /* Monthly / Yearly */
  .billing {
    display: inline-flex;
    margin-top: var(--sp-1);
    padding: 3px;
    border: 1px solid var(--text-strong);
    border-radius: var(--radius);
  }

  .billing input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .billing label {
    display: grid;
    place-items: center;
    min-height: 2rem;
    padding-inline: 0.875rem;
    border-radius: 1px;
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
    cursor: pointer;
  }

  .billing input:checked + label {
    background: var(--text-strong);
    color: var(--bg);
  }

  .billing input:focus-visible + label {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .price-yearly {
    display: none;
  }

  .plans:has(#plans-yearly:checked) .price-monthly {
    display: none;
  }

  .plans:has(#plans-yearly:checked) .price-yearly {
    display: inline;
  }

  /* position: relative keeps screen-reader labels inside the scroll area. */
  .plans__scroll {
    position: relative;
    overflow-x: auto;
    padding: 12px 8px 8px;
    margin: -12px -8px -8px;
  }

  .plans__table {
    position: relative;
    min-width: 40rem;
  }

  table {
    width: 100%;
    table-layout: fixed;
    border-collapse: collapse;
    border: var(--rule-heavy) solid var(--text-strong);
    background: var(--surface);
    font-size: var(--s-1);
  }

  .col-desc,
  .col-plan {
    width: 25%;
  }

  th,
  td {
    padding: 0.625rem var(--sp-2);
    border: 1px solid var(--line);
    text-align: left;
    vertical-align: middle;
    color: var(--text-strong);
  }

  td.mono {
    font-size: var(--s-2);
  }

  thead th,
  thead td {
    border-bottom: var(--rule) solid var(--text-strong);
    vertical-align: top;
  }

  .plan {
    padding-block: var(--sp-3);
    font-weight: 400;
  }

  .plan__name,
  .plan__for,
  .plan__price,
  .plan__unit {
    display: block;
  }

  .plan__name {
    font-size: var(--s1);
    font-weight: 600;
    line-height: 1.2;
  }

  .plan__for {
    margin-top: 0.25rem;
    font-size: var(--s-1);
    line-height: 1.4;
    color: var(--text-muted);
  }

  .plan__price {
    margin-top: var(--sp-3);
    font-family: var(--font-display);
    font-size: var(--s6);
    font-weight: 500;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .plan__unit {
    margin: 0.375rem 0 var(--sp-3);
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .plan__key,
  .plans__notes sup {
    margin-left: 0.15em;
    font-size: 0.6875rem;
    color: var(--text-strong);
  }

  tbody th {
    font-weight: 500;
  }

  .item {
    display: inline-block;
    width: 2rem;
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  td :global(.icon) {
    color: var(--text-strong);
  }

  /* Not included: a short thin rule */
  .none {
    display: inline-block;
    width: 0.875rem;
    border-top: 1px solid var(--line-strong);
    vertical-align: middle;
  }

  /* Selection handles around the recommended column, on the table's own column grid. */
  .plans__overlay {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(4, 25%);
    pointer-events: none;
  }

  .plans__overlay .handles {
    grid-row: 1;
  }

  .plans__tag {
    position: absolute;
    top: var(--sp-3);
    right: var(--sp-2);
    padding: 0.125rem 0.375rem;
    border: 1px solid var(--select);
    color: var(--select);
    font-size: var(--s-2);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.4;
  }

  .plans__foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--sp-2) var(--sp-5);
  }

  .plans__notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem var(--sp-3);
    font-size: var(--s-2);
    color: var(--text-muted);
  }

  .plans__notes > span:first-child {
    font-weight: 600;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .plans__more {
    font-weight: 500;
  }

  /*
   * Desktop: the table spans the sheet. Its columns sit on the zone lines,
   * two zones each, and its sides are the border lines; the heading fills
   * the corner cell.
   */
  @media (min-width: 64rem) {
    .plans {
      padding-top: 0;
    }

    .plans__frame {
      gap: var(--sp-3);
    }

    .plans__head {
      position: absolute;
      top: 0;
      left: 0;
      z-index: 2;
      width: 25%;
      padding: var(--sp-3) var(--pad);
    }

    .plans__scroll {
      overflow: visible;
      padding: 0;
      margin: 0;
    }

    table {
      border-top: 0;
      border-inline: 0;
    }

    .corner {
      height: 17.5rem;
    }

    th,
    td {
      padding-inline: var(--pad);
    }

    .plans__foot {
      padding-inline: var(--pad);
    }
  }
</style>
