---
import DownloadButtons from '../DownloadButtons.astro';
import ModelView from '../ModelView.astro';
import DocCard from './DocCard.astro';
import LogPanel from './LogPanel.astro';
---

<section class="hero" aria-labelledby="hero-title" data-hero data-row>
  <div class="container">
    <h1 id="hero-title" class="hero__title pad">
      <span class="hero__line">Model the part.</span>
      <span class="hero__line">Trace writes the design doc.</span>
    </h1>

    <div class="grid hero__intro">
      <p class="lead hero__lead pad">
        Trace records every change you make in CAD, from a sketch dimension to a new material. Its
        AI turns that history into a design document: the overall design, and every change that
        shaped it.
      </p>
      <div class="hero__get pad">
        <DownloadButtons size="lg" />
        <p class="hero__meta">
          Free for one project. Runs beside Autodesk Fusion. <a href="/signup">Create an account</a>
        </p>
      </div>
    </div>

    <figure class="figure" data-trace-figure data-active="wall">
      <div class="grid figure__band">
        <div class="cell cell--model">
          <ModelView
            alt="The sander housing with a quarter cut away. The motor mount wall inside, which changed in revision B, is drawn in red."
            anchors
            intro
          />
          <p class="cell__label mono">Housing, Rev B · quarter section</p>
        </div>
        <div class="cell cell--log">
          <LogPanel />
        </div>
        <div class="cell cell--doc">
          <DocCard />
        </div>
      </div>
      <svg class="trace" aria-hidden="true" data-trace-svg>
        <path class="trace__path" pathLength="1"></path>
        <g class="trace__marks"></g>
      </svg>
      <figcaption class="figure__caption pad">
        <span class="mono">Fig. 1</span>
        <span>
          One change on its way through Trace: the motor mount wall, from the model to its log
          entries to the design document.
        </span>
      </figcaption>
    </figure>
  </div>
</section>
<script is:inline>
  // Start the sequence while the page parses, so the finished state never flashes first.
  (function () {
    var hero = document.currentScript.previousElementSibling;
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.classList.add('is-playing');
    }
  })();
</script>

<style>
  .hero {
    --play: 1500ms;
    padding-top: var(--sp-5);
  }

  .hero__title {
    font-size: clamp(2.75rem, 1rem + 5.2vw, var(--s10));
    line-height: 1;
    letter-spacing: -0.02em;
    text-wrap: initial;
  }

  .hero__line {
    display: block;
  }

  .hero__intro {
    row-gap: var(--sp-5);
    margin-top: var(--sp-5);
  }

  .hero__lead,
  .hero__get {
    grid-column: 1 / -1;
  }

  .hero__lead {
    max-width: 44ch;
  }

  .hero__get {
    display: grid;
    align-content: start;
    gap: var(--sp-2);
  }

  .hero__meta {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .hero__meta a {
    font-weight: 500;
  }

  /* Figure: model, log and document, joined by the trace line */
  .figure {
    position: relative;
    margin-top: var(--sp-8);
  }

  .figure__band {
    row-gap: var(--sp-3);
  }

  .cell {
    grid-column: 1 / -1;
    min-width: 0;
  }

  .cell--model {
    display: grid;
    align-content: space-between;
    gap: var(--sp-1);
  }

  .cell--model :global(.model) {
    aspect-ratio: 1040 / 750;
  }

  .cell__label {
    font-size: var(--s-2);
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .figure__caption {
    display: flex;
    gap: 0.75rem;
    padding-block: var(--sp-2);
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .figure__caption .mono {
    flex: none;
    font-size: var(--s-2);
    font-weight: 600;
    line-height: 1.6;
    color: var(--text-strong);
  }

  .trace {
    display: none;
  }

  @media (min-width: 40rem) {
    .cell--log {
      grid-column: 1 / span 4;
    }

    .cell--doc {
      grid-column: 5 / -1;
    }
  }

  /*
   * Desktop: the figure is a band across the sheet, cut into cells on the
   * zone lines: the model in zones 1 to 3, the log in 4 and 5, the document
   * in 6 to 8. The cells share their rules, as the blocks of a drawing do.
   */
  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--sp-8);
    }

    .hero__lead {
      grid-column: 1 / span 3;
    }

    .hero__get {
      grid-column: 4 / span 4;
      padding-top: 0.3rem;
    }

    .figure__band {
      row-gap: 0;
      border-block: var(--rule) solid var(--text-strong);
    }

    .cell--model {
      grid-column: 1 / span 3;
      padding: var(--sp-3) var(--pad) var(--sp-2);
    }

    .cell--log {
      grid-column: 4 / span 2;
      border-left: var(--rule) solid var(--text-strong);
    }

    .cell--doc {
      grid-column: 6 / -1;
      border-left: var(--rule) solid var(--text-strong);
    }

    .trace {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      max-width: none;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
  }

  .trace__path {
    fill: none;
    stroke: var(--change);
    stroke-width: 1.5;
    stroke-linejoin: miter;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .trace :global(.trace__mark) {
    fill: var(--change);
  }

  .trace :global(.trace__ring) {
    fill: var(--bg);
    stroke: var(--change);
    stroke-width: 1.5;
  }

  /* Sequence: the section plane sweeps in, the log fills, then the trace draws. */
  .hero.is-playing .trace__path {
    animation: draw 700ms var(--ease) both;
    animation-delay: calc(var(--play) + 800ms);
  }

  .hero.is-playing .trace :global(.trace__mark),
  .hero.is-playing .trace :global(.trace__ring) {
    animation: mark-in 240ms var(--ease) both;
    animation-delay: calc(var(--play) + 800ms);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes mark-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const ARROW = 8;

  for (const figure of document.querySelectorAll<HTMLElement>('[data-trace-figure]')) {
    // The trace line joins one change across the three cells: from its cut
    // face in the model to its first log entry, and on into the document
    // statement written from it. Where both ends sit on one line it runs
    // straight; otherwise it turns once, just before the next cell.
    const svg = figure.querySelector<SVGSVGElement>('[data-trace-svg]');
    const path = svg?.querySelector('path');
    const marks = svg?.querySelector('g');
    const linked = [...figure.querySelectorAll<HTMLElement>('.log [data-link], .doc [data-link]')];

    const layout = () => {
      if (!svg || !path || !marks) return;
      if (getComputedStyle(svg).display === 'none') return;
      const key = figure.dataset.active ?? 'wall';
      const source = figure.querySelector(`[data-source="${key}"]`);
      const row = figure.querySelector<HTMLElement>(`.log [data-link="${key}"]`);
      const item = figure.querySelector<HTMLElement>(`.doc [data-link="${key}"]`);
      const logCell = row?.closest('.cell');
      const docCell = item?.closest('.cell');
      if (!source || !row || !item || !logCell || !docCell) return;

      const box = figure.getBoundingClientRect();
      const rel = (r: DOMRect) => ({
        left: r.left - box.left,
        right: r.right - box.left,
        top: r.top - box.top,
        mid: r.top - box.top + r.height / 2,
      });
      const s = rel(source.getBoundingClientRect());
      const l = rel(row.getBoundingClientRect());
      const logBox = rel(logCell.getBoundingClientRect());
      const docBox = rel(docCell.getBoundingClientRect());
      const style = getComputedStyle(item);
      const docY =
        rel(item.getBoundingClientRect()).top +
        parseFloat(style.paddingTop) +
        parseFloat(style.lineHeight) / 2;
      const f = (n: number) => n.toFixed(1);

      const start = { x: (s.left + s.right) / 2, y: s.mid };
      const y1 = Math.abs(start.y - l.mid) < 4 ? l.mid : start.y;
      const bend = logBox.left - 24;
      let d =
        Math.abs(y1 - l.mid) < 0.5
          ? `M${f(start.x)} ${f(l.mid)} H${f(logBox.left)}`
          : `M${f(start.x)} ${f(y1)} H${f(bend)} V${f(l.mid)} H${f(logBox.left)}`;
      // Across the shared rule into the document.
      const into = docBox.left + 14;
      const straight = Math.abs(docY - l.mid) < 4;
      d += straight
        ? ` M${f(logBox.right)} ${f(l.mid)} H${f(into)}`
        : ` M${f(logBox.right)} ${f(l.mid)} H${f(docBox.left + 6)} V${f(docY)} H${f(into)}`;
      const endY = straight ? l.mid : docY;

      svg.setAttribute('viewBox', `0 0 ${f(box.width)} ${f(box.height)}`);
      path.setAttribute('d', d);
      const ring = (x: number, y: number) =>
        `<circle class="trace__ring" cx="${f(x)}" cy="${f(y)}" r="4"></circle>`;
      const dot = (x: number, y: number) =>
        `<circle class="trace__mark" cx="${f(x)}" cy="${f(y)}" r="3"></circle>`;
      const arrow = (x: number, y: number) =>
        `<path class="trace__mark" d="M${f(x)} ${f(y)} l${-ARROW} -3 v6 z"></path>`;
      marks.innerHTML =
        ring(start.x, y1) +
        arrow(logBox.left, l.mid) +
        dot(logBox.right, l.mid) +
        arrow(into, endY);
    };

    // Pointing at a change traces it instead; letting go returns to the wall.
    const activate = (key: string) => {
      figure.dataset.active = key;
      for (const el of linked) el.classList.toggle('is-active', el.dataset.link === key);
      figure.dispatchEvent(new CustomEvent('trace:active', { detail: key }));
      layout();
    };
    for (const el of linked) {
      el.addEventListener('mouseenter', () => activate(el.dataset.link ?? 'wall'));
      el.addEventListener('mouseleave', () => activate('wall'));
    }

    figure.addEventListener('model:anchors', layout);
    layout();
    new ResizeObserver(layout).observe(figure);
    document.fonts?.ready.then(layout);
  }

  // The trace is the last step. Once it has drawn, drop the playing state so
  // later layout changes can't restart anything. Replay restarts the sequence.
  for (const hero of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    hero.querySelector('.trace__path')?.addEventListener('animationend', () => {
      hero.classList.remove('is-playing');
    });
    hero.querySelector('[data-replay]')?.addEventListener('click', () => {
      hero.classList.remove('is-playing');
      void hero.offsetWidth;
      hero.classList.add('is-playing');
    });
  }
</script>
