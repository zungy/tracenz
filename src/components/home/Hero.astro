---
import DownloadLink from '../DownloadLink.astro';
import Guides from '../Guides.astro';
import TraceDemo from './TraceDemo.astro';
import { cloudPath } from '../../scripts/revision-cloud';
import { site } from '../../config/site';

// Server-rendered cloud for a typical box; the client redraws it to the exact size.
const fallbackCloud = cloudPath(600, 130, 22);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <Guides />

  <div class="container">
    <div class="grid hero__grid">
      <p class="label hero__eyebrow">For mechanical and product design teams</p>

      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">Model the part.</span>
        <span class="hero__line">
          Trace writes the{' '}
          <span class="revmark" data-revmark>
            design doc
            <svg
              class="revmark__cloud"
              viewBox="0 0 600 130"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d={fallbackCloud} pathLength="1"></path>
            </svg>
            <span class="revmark__tag" aria-hidden="true">
              <svg viewBox="0 0 24 21">
                <path d="M12 1.8 22.4 19.5H1.6Z"></path>
              </svg>
              <span>B</span>
            </span>
          </span>
          .
        </span>
      </h1>

      <div class="hero__copy">
        <p class="lead">
          Trace records every change you make in CAD, from a sketch dimension to a new material. Its
          AI reads that history and writes a design document with the overall design and the changes
          that shaped it.
        </p>
        <div class="hero__actions">
          <a class="btn btn--primary" href="/signup">
            Sign up free
          </a>
          <DownloadLink os="windows" variant="secondary" />
        </div>
        <p class="hero__meta">
          Free for one project. <a href="/pricing">See pricing</a> or{' '}
          <a
            href={site.downloads.macos ?? '#download'}
            data-pending={
              site.downloads.macos ? undefined : "The macOS download isn't available yet."
            }
          >
            get the macOS app
          </a>
          .
        </p>
      </div>

      <div class="hero__demo">
        <TraceDemo />
      </div>
    </div>
  </div>
</section>
<script is:inline>
  // Start the demo while the page parses, so the finished state never flashes first.
  (function () {
    var hero = document.currentScript.previousElementSibling;
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.classList.add('is-playing');
    }
  })();
</script>

<style>
  .hero {
    --play: 1800ms;
    position: relative;
    padding-block: var(--sp-8);
    border-bottom: 1px solid var(--line);
  }

  .hero__grid {
    position: relative;
    row-gap: var(--sp-3);
  }

  .hero__eyebrow,
  .hero__title,
  .hero__copy,
  .hero__demo {
    grid-column: 1 / -1;
  }

  .hero__title {
    font-size: clamp(2.25rem, 1.1rem + 4.6vw, 4.757rem);
    font-weight: 780;
    font-stretch: 112%;
    line-height: 1.08;
    letter-spacing: -0.03em;
  }

  .hero__line {
    display: block;
  }

  .hero__copy {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
    padding-top: var(--sp-2);
  }

  .hero__copy .lead {
    max-width: 38ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .hero__meta {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .hero__demo {
    margin-top: var(--sp-3);
  }

  @media (min-width: 64rem) {
    .hero {
      padding-block: var(--sp-8) var(--sp-13);
    }

    .hero__eyebrow {
      grid-column: 1 / span 8;
    }

    .hero__title {
      grid-column: 1 / -1;
    }

    .hero__copy {
      grid-column: 1 / span 6;
    }

    .hero__demo {
      grid-column: 8 / -1;
      margin-top: 0;
      padding-top: var(--sp-2);
    }
  }

  /* Revision cloud and delta tag around "design doc" */
  .revmark {
    position: relative;
    display: inline-block;
    margin-inline: 0.12em 0.2em;
    white-space: nowrap;
  }

  .revmark__cloud {
    position: absolute;
    top: -0.1em;
    left: -0.2em;
    width: calc(100% + 0.4em);
    max-width: none;
    height: calc(100% + 0.2em);
    overflow: visible;
    pointer-events: none;
  }

  .revmark__cloud path {
    fill: none;
    stroke: var(--mark);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  /* Sized in the headline's em; only the letter is set small. */
  .revmark__tag {
    position: absolute;
    top: -0.36em;
    left: calc(100% + 0.04em);
    display: grid;
    place-items: center;
    width: max(0.46em, 1.75rem);
    aspect-ratio: 24 / 21;
  }

  .revmark__tag svg {
    position: absolute;
    inset: 0;
    width: 100%;
    max-width: none;
    height: 100%;
    fill: var(--bg);
    stroke: var(--mark);
    stroke-width: 1.5;
    stroke-linejoin: round;
    overflow: visible;
  }

  .revmark__tag span {
    position: relative;
    top: 0.3em;
    font-family: var(--font-mono);
    font-size: max(0.16em, 0.625rem);
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    color: var(--mark);
  }

  .hero.is-playing .revmark__cloud path {
    animation: draw 800ms var(--ease) both;
    animation-delay: calc(var(--play) + 1000ms);
  }

  .hero.is-playing .revmark__tag {
    animation: tag-in 320ms var(--ease) both;
    animation-delay: calc(var(--play) + 1700ms);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes tag-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
</style>

<script>
  import { cloudPath } from '../../scripts/revision-cloud';

  // Redraw the revision cloud to the word's real size so the scallops stay round.
  for (const mark of document.querySelectorAll<HTMLElement>('[data-revmark]')) {
    const svg = mark.querySelector<SVGSVGElement>('.revmark__cloud');
    const path = svg?.querySelector('path');
    if (!svg || !path) continue;

    const draw = () => {
      const { width, height } = svg.getBoundingClientRect();
      if (!width || !height) return;
      const fontSize = parseFloat(getComputedStyle(mark).fontSize);
      svg.setAttribute('viewBox', `0 0 ${width.toFixed(2)} ${height.toFixed(2)}`);
      svg.removeAttribute('preserveAspectRatio');
      path.setAttribute('d', cloudPath(width, height, Math.max(10, fontSize * 0.22)));
    };

    draw();
    new ResizeObserver(draw).observe(mark);
    document.fonts?.ready.then(draw);
  }

  // The revision tag is the last step. Once it lands, drop the playing state so
  // later layout changes (like crossing a breakpoint) can't restart anything.
  // Replay restarts the whole sequence: log, document, then the revision mark.
  for (const hero of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    hero.querySelector('.revmark__tag')?.addEventListener('animationend', () => {
      hero.classList.remove('is-playing');
    });
    hero.querySelector('[data-replay]')?.addEventListener('click', () => {
      hero.classList.remove('is-playing');
      void hero.offsetWidth;
      hero.classList.add('is-playing');
    });
  }
</script>
