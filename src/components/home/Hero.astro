---
import DownloadButtons from '../DownloadButtons.astro';
import SanderElevation from '../drawings/SanderElevation.astro';
import DocCard from './DocCard.astro';
import LogPanel from './LogPanel.astro';
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container">
    <h1 id="hero-title" class="hero__title">
      <span class="hero__line">Model the part.</span>
      <span class="hero__line">Trace writes the design doc.</span>
    </h1>

    <div class="grid hero__intro">
      <p class="lead hero__lead">
        Trace records every change you make in CAD, from a sketch dimension to a new material. Its
        AI turns that history into a design document that covers the overall design and every change
        that shaped it.
      </p>
      <div class="hero__get">
        <p class="label hero__label">Download the desktop app</p>
        <DownloadButtons />
        <p class="hero__meta">
          Free for one project, no card needed. Or <a href="/signup">create an account</a> first.
        </p>
      </div>
    </div>

    <figure class="figure" data-trace-figure data-active="wall">
      <div class="grid figure__grid">
        <div class="figure__part figure__drawing">
          <p class="figure__label">
            <span class="num">1</span> You model the part
          </p>
          <SanderElevation id="hero-elev" />
          <p class="figure__view mono">Front elevation, half section</p>
        </div>
        <div class="figure__part figure__log">
          <p class="figure__label">
            <span class="num">2</span> Trace logs each change
          </p>
          <LogPanel />
        </div>
        <div class="figure__part figure__doc">
          <p class="figure__label">
            <span class="num">3</span> Trace writes it up
          </p>
          <DocCard />
        </div>
      </div>
      <svg class="trace" aria-hidden="true" data-trace-svg>
        <path class="trace__path" pathLength="1"></path>
        <g class="trace__marks"></g>
      </svg>
      <figcaption class="figure__caption">
        <span class="mono">Fig. 1</span>
        <span>
          The motor mount wall, traced from the model through the log into the document. Point at
          another change to trace it instead.
        </span>
      </figcaption>
    </figure>
  </div>
</section>
<script is:inline>
  // Start the sequence while the page parses, so the finished state never flashes first.
  (function () {
    var hero = document.currentScript.previousElementSibling;
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.classList.add('is-playing');
    }
  })();
</script>

<style>
  .hero {
    --play: 1500ms;
    padding-block: var(--sp-5) var(--sp-8);
  }

  .hero__title {
    font-size: clamp(2.75rem, 1rem + 5.2vw, 6rem);
    font-weight: var(--display-weight);
    line-height: 1;
    letter-spacing: -0.035em;
    text-wrap: initial;
  }

  .hero__line {
    display: block;
  }

  .hero__intro {
    row-gap: var(--sp-5);
    margin-top: var(--sp-5);
  }

  .hero__lead,
  .hero__get {
    grid-column: 1 / -1;
  }

  .hero__lead {
    max-width: 44ch;
  }

  .hero__get {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    max-width: 30rem;
  }

  .hero__label {
    color: var(--text-strong);
  }

  .hero__meta {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  /* Figure: drawing, log and document, joined by the trace line */
  .figure {
    position: relative;
    margin-top: var(--sp-8);
  }

  .figure__grid {
    row-gap: var(--sp-5);
  }

  .figure__part {
    display: grid;
    grid-template-rows: auto 1fr;
    align-content: start;
    gap: 0.75rem;
    grid-column: 1 / -1;
    min-width: 0;
  }

  .figure__label {
    display: flex;
    gap: 0.75rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--text-strong);
    font-family: var(--font-mono);
    font-size: var(--s-2);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-strong);
  }

  .figure__label span {
    color: var(--text-muted);
  }

  /*
   * The drawing is a size container, so the note's height on screen is known:
   * it sits 85 of the drawing's 516 units down. The margin puts the note on
   * the log's first row, 121px below the panel top.
   */
  .figure__drawing {
    position: relative;
    container-type: inline-size;
  }

  @media (min-width: 64rem) {
    .figure__drawing :global(.elev) {
      margin-top: calc(121px - 100cqi * 85 / 516);
    }

    /* The view title sits on the panels' footer line. */
    .figure__view {
      position: absolute;
      left: 0;
      bottom: calc(0.75rem + 1px);
    }
  }

  .figure__drawing {
    grid-template-rows: auto auto 1fr;
  }

  .figure__view {
    align-self: end;
    font-size: var(--s-2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .figure__caption {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--sp-3);
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .figure__caption .mono {
    flex: none;
    font-size: var(--s-2);
    font-weight: 600;
    line-height: 1.75;
    color: var(--text-strong);
  }

  .trace {
    display: none;
  }

  @media (min-width: 40rem) {
    .figure__log {
      grid-column: 1 / span 5;
    }

    .figure__doc {
      grid-column: 6 / -1;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--sp-8);
    }

    .hero__lead {
      grid-column: 1 / span 6;
    }

    .hero__get {
      grid-column: 7 / span 6;
      max-width: none;
    }

    .figure__drawing {
      grid-column: 1 / span 6;
    }

    .figure__log {
      grid-column: 7 / span 6;
    }

    .figure__doc {
      grid-column: 13 / -1;
    }

    .trace {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      max-width: none;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
  }

  .trace__path {
    fill: none;
    stroke: var(--change);
    stroke-width: 1.5;
    stroke-linejoin: miter;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .trace :global(.trace__mark) {
    fill: var(--change);
  }

  /* Sequence: log, document, trace line, then the revision mark on the drawing. */
  .hero.is-playing .trace__path {
    animation: draw 600ms var(--ease) both;
    animation-delay: calc(var(--play) + 800ms);
  }

  .hero.is-playing .trace :global(.trace__mark) {
    animation: mark-in 200ms var(--ease) both;
    animation-delay: calc(var(--play) + 800ms);
  }

  .hero.is-playing :global(.rev .cloud) {
    animation: draw 800ms var(--ease) both;
    animation-delay: calc(var(--play) + 1300ms);
  }

  .hero.is-playing :global(.rev .tag),
  .hero.is-playing :global(.rev text) {
    animation: mark-in 300ms var(--ease) both;
    animation-delay: calc(var(--play) + 2000ms);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes mark-in {
    from {
      opacity: 0;
    }
  }
</style>

<script>
  const ARROW = 8;

  for (const figure of document.querySelectorAll<HTMLElement>('[data-trace-figure]')) {
    // The trace line joins one change across the three panels: from the
    // drawing into its log entry, and from the entry into the document
    // statement written from it. Where two ends sit on one line it runs
    // straight; otherwise it turns at right angles in the gap between panels.
    const svg = figure.querySelector<SVGSVGElement>('[data-trace-svg]');
    const path = svg?.querySelector('path');
    const marks = svg?.querySelector('g');
    const linked = [...figure.querySelectorAll<HTMLElement | SVGElement>('[data-link]')];

    const layout = () => {
      if (!svg || !path || !marks) return;
      if (getComputedStyle(svg).display === 'none') return;
      const key = figure.dataset.active ?? 'wall';
      const source = figure.querySelector(`[data-source="${key}"]`);
      const row = figure.querySelector<HTMLElement>(`.log [data-link="${key}"]`);
      const item = figure.querySelector<HTMLElement>(`.doc [data-link="${key}"]`);
      const log = row?.closest('.log');
      const doc = item?.closest('.doc');
      if (!source || !row || !item || !log || !doc) return;

      const box = figure.getBoundingClientRect();
      const rel = (r: DOMRect) => ({
        left: r.left - box.left,
        right: r.right - box.left,
        top: r.top - box.top,
        mid: r.top - box.top + r.height / 2,
      });
      const s = rel(source.getBoundingClientRect());
      const l = rel(row.getBoundingClientRect());
      const logBox = rel(log.getBoundingClientRect());
      const docBox = rel(doc.getBoundingClientRect());
      // A statement is entered at its first line.
      const style = getComputedStyle(item);
      const itemY = rel(item.getBoundingClientRect()).top + parseFloat(style.paddingTop);
      const docY = itemY + parseFloat(style.lineHeight) / 2;
      const f = (n: number) => n.toFixed(1);

      const leg = (x1: number, y1: number, x2: number, y2: number) => {
        if (Math.abs(y2 - y1) < 4) return `M${f(x1)} ${f(y2)} H${f(x2)}`;
        const gx = x2 - 20;
        return `M${f(x1)} ${f(y1)} H${f(gx)} V${f(y2)} H${f(x2)}`;
      };
      const start = { x: s.right + 6, y: s.mid };
      const snapped = Math.abs(start.y - l.mid) < 4 ? l.mid : start.y;
      const docEnd = Math.abs(docY - l.mid) < 4 ? l.mid : docY;

      svg.setAttribute('viewBox', `0 0 ${f(box.width)} ${f(box.height)}`);
      path.setAttribute(
        'd',
        `${leg(start.x, snapped, logBox.left - 1, l.mid)} ${leg(logBox.right + 1, l.mid, docBox.left - 1, docEnd)}`,
      );
      const dot = (x: number, y: number) =>
        `<circle class="trace__mark" cx="${f(x)}" cy="${f(y)}" r="3"></circle>`;
      const arrow = (x: number, y: number) =>
        `<path class="trace__mark" d="M${f(x)} ${f(y)} l${-ARROW} -3 v6 z"></path>`;
      marks.innerHTML =
        dot(start.x, snapped) +
        arrow(logBox.left - 1, l.mid) +
        dot(logBox.right + 1, l.mid) +
        arrow(docBox.left - 1, docEnd);
    };

    // Pointing at a change traces it instead; letting go returns to the wall.
    const activate = (key: string, pointing: boolean) => {
      figure.dataset.active = key;
      for (const el of linked) {
        const match = el.dataset.link === key;
        if (el instanceof SVGElement) el.classList.toggle('is-linked', pointing && match);
        else el.classList.toggle('is-active', match);
      }
      layout();
    };
    for (const el of linked) {
      el.addEventListener('mouseenter', () => activate(el.dataset.link ?? 'wall', true));
      el.addEventListener('mouseleave', () => activate('wall', false));
    }

    layout();
    new ResizeObserver(layout).observe(figure);
    document.fonts?.ready.then(layout);
  }

  // The revision tag is the last step. Once it lands, drop the playing state so
  // later layout changes can't restart anything. Replay restarts the sequence.
  for (const hero of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    hero.querySelector('.rev .tag')?.addEventListener('animationend', () => {
      hero.classList.remove('is-playing');
    });
    hero.querySelector('[data-replay]')?.addEventListener('click', () => {
      hero.classList.remove('is-playing');
      void hero.offsetWidth;
      hero.classList.add('is-playing');
    });
  }
</script>
