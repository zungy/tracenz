---
import DownloadButton from '../DownloadButton.astro';
import SanderElevation from '../drawings/SanderElevation.astro';
import DocCard from './DocCard.astro';
import LogPanel from './LogPanel.astro';
import { cloudPath } from '../../scripts/revision-cloud';

// Server-rendered cloud for a typical box; the client redraws it to the exact size.
const fallbackCloud = cloudPath(560, 130, 24);
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  <div class="container">
    <div class="grid hero__top">
      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">Model the part.</span>
        <span class="hero__line">Trace writes the</span>
        <span class="hero__line">
          <span class="revmark" data-revmark>
            design doc.
            <svg
              class="revmark__cloud"
              viewBox="0 0 560 130"
              preserveAspectRatio="none"
              aria-hidden="true"
            >
              <path d={fallbackCloud} pathLength="1"></path>
            </svg>
            <span class="rev-tag revmark__tag" aria-hidden="true">
              <svg viewBox="0 0 24 21">
                <path d="M12 1 23 20H1Z"></path>
              </svg>
              <span>B</span>
            </span>
          </span>
        </span>
      </h1>

      <div class="hero__intro">
        <p class="lead">
          Trace records every change you make in CAD, from a sketch dimension to a new material. Its
          AI turns that history into a design document that covers the overall design and every
          change that shaped it.
        </p>
        <div class="hero__actions">
          <DownloadButton />
          <a class="btn btn--secondary" href="/signup">
            Sign up free
          </a>
        </div>
        <p class="hero__meta">Runs alongside Autodesk Fusion. Free for one project.</p>
      </div>
    </div>

    <figure class="figure" data-trace-figure>
      <div class="grid figure__grid">
        <div class="figure__drawing">
          <SanderElevation id="hero-elev" />
          <p class="figure__view mono">Half section · scale 1:2</p>
        </div>
        <div class="figure__log">
          <LogPanel />
        </div>
        <div class="figure__doc">
          <DocCard />
        </div>
      </div>
      <svg class="trace" aria-hidden="true" data-trace-svg>
        <path class="trace__path" pathLength="1"></path>
        <g class="trace__nodes"></g>
      </svg>
      <figcaption class="figure__caption">
        <span class="mono">Fig. 1</span>
        Change 09:12, traced from the model through the log into the document. Point at any change
        in the log to find it in the other two.
      </figcaption>
    </figure>
  </div>
</section>
<script is:inline>
  // Start the sequence while the page parses, so the finished state never flashes first.
  (function () {
    var hero = document.currentScript.previousElementSibling;
    if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      hero.classList.add('is-playing');
    }
  })();
</script>

<style>
  .hero {
    --play: 1500ms;
    padding-block: var(--sp-5) var(--section-pad);
  }

  .hero__top {
    row-gap: var(--sp-5);
    align-items: end;
  }

  .hero__title,
  .hero__intro {
    grid-column: 1 / -1;
  }

  .hero__title {
    font-size: clamp(2.5rem, 1.1rem + 4.7vw, 5rem);
    font-weight: 660;
    font-stretch: 110%;
    line-height: 1.02;
    letter-spacing: -0.03em;
  }

  .hero__line {
    display: block;
  }

  .hero__intro {
    display: grid;
    gap: var(--sp-3);
  }

  .hero__intro .lead {
    max-width: 40ch;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-2);
  }

  .hero__meta {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  /* Figure: drawing, log and document, joined by the trace line */
  .figure {
    position: relative;
    margin-top: var(--sp-8);
  }

  .figure__grid {
    row-gap: var(--sp-5);
    align-items: start;
  }

  .figure__drawing,
  .figure__log,
  .figure__doc {
    grid-column: 1 / -1;
  }

  .figure__drawing {
    display: grid;
    gap: var(--sp-1);
  }

  .figure__view {
    font-size: var(--s-2);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
  }

  .figure__caption {
    display: flex;
    gap: 0.75rem;
    margin-top: var(--sp-5);
    padding-top: var(--sp-2);
    border-top: 1px solid var(--line);
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .figure__caption span {
    flex: none;
    font-weight: 600;
    color: var(--text-strong);
  }

  .trace {
    display: none;
  }

  @media (min-width: 40rem) {
    .figure__log {
      grid-column: 1 / span 4;
    }

    .figure__doc {
      grid-column: 5 / -1;
    }
  }

  @media (min-width: 64rem) {
    .hero {
      padding-top: var(--sp-8);
    }

    .hero__title {
      grid-column: 1 / span 10;
    }

    .hero__intro {
      grid-column: 11 / -1;
      padding-bottom: 0.5rem;
    }

    .figure__drawing {
      grid-column: 1 / span 6;
    }

    .figure__log {
      grid-column: 7 / span 5;
      margin-left: var(--sp-2);
    }

    /* Leave room for the stacked sheet's offset inside the column. */
    .figure__doc {
      grid-column: 12 / -1;
      margin-left: calc(var(--sp-5) - var(--gutter) + 6px);
      margin-right: 6px;
    }

    .trace {
      position: absolute;
      inset: 0;
      display: block;
      width: 100%;
      max-width: none;
      height: 100%;
      overflow: visible;
      pointer-events: none;
    }
  }

  .trace__path {
    fill: none;
    stroke: var(--change);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .trace :global(.trace__node) {
    fill: var(--change);
  }

  /* Revision cloud and tag around "design doc." */
  .revmark {
    position: relative;
    z-index: 0;
    display: inline-block;
    white-space: nowrap;
  }

  .revmark__cloud {
    position: absolute;
    top: -0.12em;
    left: -0.12em;
    z-index: -1;
    width: calc(100% + 0.3em);
    max-width: none;
    height: calc(100% + 0.24em);
    overflow: visible;
    pointer-events: none;
  }

  .revmark__cloud path {
    fill: none;
    stroke: var(--change);
    stroke-width: 1.75;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  .revmark__tag {
    position: absolute;
    top: 0.02em;
    left: calc(100% + 0.22em);
    width: max(0.44em, 1.75rem);
    height: auto;
    aspect-ratio: 24 / 21;
  }

  .revmark__tag span {
    top: 0.3em;
    font-size: max(0.14em, 0.625rem);
    letter-spacing: 0;
  }

  /* Sequence: log, document, trace line, then the revision mark. */
  .hero.is-playing .trace__path {
    animation: draw 700ms var(--ease) both;
    animation-delay: calc(var(--play) + 1300ms);
  }

  .hero.is-playing .trace :global(.trace__node) {
    animation: node-in 200ms var(--ease) both;
    animation-delay: calc(var(--play) + 1300ms);
  }

  .hero.is-playing .revmark__cloud path {
    animation: draw 900ms var(--ease) both;
    animation-delay: calc(var(--play) + 2000ms);
  }

  .hero.is-playing .revmark__tag {
    animation: tag-in 320ms var(--ease) both;
    animation-delay: calc(var(--play) + 2700ms);
  }

  @keyframes draw {
    from {
      stroke-dashoffset: 1;
    }
  }

  @keyframes node-in {
    from {
      opacity: 0;
    }
  }

  @keyframes tag-in {
    from {
      opacity: 0;
      transform: scale(0.6);
    }
  }
</style>

<script>
  import { cloudPath } from '../../scripts/revision-cloud';

  // Redraw the revision cloud to the phrase's real size so the arcs stay round.
  for (const mark of document.querySelectorAll<HTMLElement>('[data-revmark]')) {
    const svg = mark.querySelector<SVGSVGElement>('.revmark__cloud');
    const path = svg?.querySelector('path');
    if (!svg || !path) continue;

    const draw = () => {
      const { width, height } = svg.getBoundingClientRect();
      if (!width || !height) return;
      const fontSize = parseFloat(getComputedStyle(mark).fontSize);
      svg.setAttribute('viewBox', `0 0 ${width.toFixed(2)} ${height.toFixed(2)}`);
      svg.removeAttribute('preserveAspectRatio');
      path.setAttribute('d', cloudPath(width, height, Math.max(12, fontSize * 0.3)));
    };

    draw();
    new ResizeObserver(draw).observe(mark);
    document.fonts?.ready.then(draw);
  }

  for (const figure of document.querySelectorAll<HTMLElement>('[data-trace-figure]')) {
    // The trace line: from the drawing's callout into log row 09:12, and out of
    // that row into document item 2.1, routed with right angles through the gaps.
    const svg = figure.querySelector<SVGSVGElement>('[data-trace-svg]');
    const path = svg?.querySelector('path');
    const nodes = svg?.querySelector('g');
    const source = figure.querySelector('[data-trace="source"]');
    const row = figure.querySelector('[data-trace="log"]');
    const item = figure.querySelector('[data-trace="doc"]');

    const layout = () => {
      if (!svg || !path || !nodes || !source || !row || !item) return;
      if (getComputedStyle(svg).display === 'none') return;
      const box = figure.getBoundingClientRect();
      const rel = (r: DOMRect) => ({
        left: r.left - box.left,
        right: r.right - box.left,
        mid: r.top - box.top + r.height / 2,
      });
      const s = rel(source.getBoundingClientRect());
      const l = rel(row.getBoundingClientRect());
      const d = rel(item.getBoundingClientRect());
      const logBox = rel((row.closest('.log') ?? row).getBoundingClientRect());
      const docBox = rel((item.closest('.doc') ?? item).getBoundingClientRect());
      const gap1 = (s.right + logBox.left) / 2;
      const gap2 = (logBox.right + docBox.left) / 2;
      const f = (n: number) => n.toFixed(1);

      svg.setAttribute('viewBox', `0 0 ${f(box.width)} ${f(box.height)}`);
      path.setAttribute(
        'd',
        `M${f(s.right + 2)} ${f(s.mid)} H${f(gap1)} V${f(l.mid)} H${f(l.left)}` +
          ` M${f(l.right)} ${f(l.mid)} H${f(gap2)} V${f(d.mid)} H${f(docBox.left + 1)}`,
      );
      nodes.innerHTML = [
        [s.right + 2, s.mid],
        [l.left, l.mid],
        [l.right, l.mid],
        [docBox.left + 1, d.mid],
      ]
        .map(
          ([x, y]) =>
            `<rect class="trace__node" x="${f(x - 3.5)}" y="${f(y - 3.5)}" width="7" height="7"></rect>`,
        )
        .join('');
    };

    layout();
    new ResizeObserver(layout).observe(figure);
    document.fonts?.ready.then(layout);

    // Pointing at a change lights it up in all three panels.
    const linked = [...figure.querySelectorAll<HTMLElement | SVGElement>('[data-link]')];
    const highlight = (key: string | null) => {
      figure.classList.toggle('is-pointing', key !== null);
      for (const el of linked) el.classList.toggle('is-linked', el.dataset.link === key);
    };
    for (const el of linked) {
      el.addEventListener('mouseenter', () => highlight(el.dataset.link ?? null));
      el.addEventListener('mouseleave', () => highlight(null));
    }
  }

  // The revision tag is the last step. Once it lands, drop the playing state so
  // later layout changes can't restart anything. Replay restarts the sequence.
  for (const hero of document.querySelectorAll<HTMLElement>('[data-hero]')) {
    hero.querySelector('.revmark__tag')?.addEventListener('animationend', () => {
      hero.classList.remove('is-playing');
    });
    hero.querySelector('[data-replay]')?.addEventListener('click', () => {
      hero.classList.remove('is-playing');
      void hero.offsetWidth;
      hero.classList.add('is-playing');
    });
  }
</script>
