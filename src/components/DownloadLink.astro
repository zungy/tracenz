---
/**
 * Download button for one platform. While the platform's URL in
 * src/config/site.ts is null, clicking shows a notice instead of a dead link.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  os: 'windows' | 'macos';
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'sm';
  class?: string;
}

const { os, variant = 'primary', size = 'md', class: className } = Astro.props;
const url = site.downloads[os];
const label = os === 'windows' ? 'Download for Windows' : 'Download for macOS';
const icon = os === 'windows' ? 'brand-windows' : 'brand-apple';
---

<a
  class:list={['btn', `btn--${variant}`, size === 'sm' && 'btn--sm', className]}
  href={url ?? '#download'}
  data-pending={
    url ? undefined : `The ${os === 'windows' ? 'Windows' : 'macOS'} download isn't available yet.`
  }
>
  <Icon name={icon} size={20} />
  {label}
</a>
