---
/**
 * Closing band on the home and pricing pages: a blueprint sheet with the
 * download on the left and, on the right, a line drawing of Trace docked
 * next to the model it is logging.
 */
import DownloadButtons from './DownloadButtons.astro';
import AppSketch from './drawings/AppSketch.astro';
---

<section id="download" class="band scheme-blueprint" aria-labelledby="download-title">
  <div class="container grid band__grid">
    <div class="band__copy">
      <h2 id="download-title">Put Trace next to Autodesk Fusion.</h2>
      <p class="band__text">
        Install the desktop app, sign in and open a project. Trace logs from the first change, and
        writes the document when you ask for it.
      </p>
      <DownloadButtons class="band__buttons" />
      <p class="band__small">
        Free for one project. Needs a Trace account: <a href="/signup">create one</a> or{' '}
        <a href="/login">log in</a>.
      </p>
    </div>

    <figure class="band__drawing">
      <AppSketch />
    </figure>
  </div>
</section>

<style>
  /*
   * Blueprint ground with a fine square grid: 16px squares, every fifth line
   * heavier, both faint enough to stay behind the drawing.
   */
  .band {
    padding-block: var(--section-pad);
    background-image:
      linear-gradient(rgb(233 235 243 / 0.1) 1px, transparent 1px),
      linear-gradient(90deg, rgb(233 235 243 / 0.1) 1px, transparent 1px),
      linear-gradient(rgb(233 235 243 / 0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgb(233 235 243 / 0.05) 1px, transparent 1px);
    background-size:
      80px 80px,
      80px 80px,
      16px 16px,
      16px 16px;
    background-position: center -1px;
  }

  .band__grid {
    row-gap: var(--sp-8);
    align-items: center;
  }

  .band__copy,
  .band__drawing {
    grid-column: 1 / -1;
  }

  .band__copy {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
  }

  .band__copy h2 {
    font-size: clamp(var(--s4), 1.2rem + 2.4vw, 3.25rem);
  }

  .band__text {
    max-width: 40ch;
    font-size: var(--s1);
    line-height: 1.5;
  }

  /* Solid paper buttons on the blueprint. */
  .band__copy :global(.band__buttons) {
    --accent: var(--paper);
    --accent-hover: var(--film);
    --on-accent: var(--ink);
    max-width: 26rem;
    margin-top: var(--sp-1);
  }

  .band__small {
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  .band__drawing {
    margin: 0;
  }

  @media (min-width: 64rem) {
    .band__copy {
      grid-column: 1 / span 6;
    }

    .band__drawing {
      grid-column: 8 / -1;
    }
  }
</style>
