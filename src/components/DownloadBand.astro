---
/**
 * Closing Paper band on the home and pricing pages.
 * The download sits on the left; on the right, Trace
 * docked in a CAD window with the document it has written.
 */
import CadWindow from './CadWindow.astro';
import DownloadButtons from './DownloadButtons.astro';
---

<section id="download" class="band scheme-paper" aria-labelledby="download-title" data-row>
  <div class="container grid band__grid">
    <div class="band__copy pad">
      <h2 id="download-title" class="title">
        Put Trace next to Autodesk Fusion.
      </h2>
      <p class="band__text">
        Open the desktop app, sign in and connect the Fusion add-in. Your captured checkpoints,
        original reasoning and AI summaries are available in the app and on the web.
      </p>
      <DownloadButtons class="band__buttons" />
      <p class="band__small">
        Use the same Trace account on your desktop and the web: <a href="/signup">create one</a> or{' '}
        <a href="/login">log in</a>.
      </p>
    </div>

    <div class="band__shot pad">
      <CadWindow />
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    isolation: isolate;
    padding-block: var(--section-pad);
  }

  .band__grid {
    row-gap: var(--sp-8);
    align-items: center;
  }

  .band__copy,
  .band__shot {
    grid-column: 1 / -1;
  }

  .band__copy {
    display: grid;
    align-content: start;
    gap: var(--sp-3);
  }

  .band__text {
    max-width: 40ch;
    font-size: var(--s1);
    line-height: 1.6;
  }

  .band__copy :global(.band__buttons) {
    margin-top: var(--sp-1);
  }

  .band__small {
    max-width: 44ch;
    font-size: var(--s-1);
    color: var(--text-muted);
  }

  @media (min-width: 64rem) {
    .band__copy {
      grid-column: 1 / span 3;
    }

    .band__shot {
      grid-column: 4 / -1;
    }
  }
</style>
