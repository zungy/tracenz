---
import Icon from './Icon.astro';
import { site } from '../config/site';
interface Props {
  class?: string;
  size?: 'md' | 'lg';
}
const { class: className, size = 'md' } = Astro.props;
---

<div class:list={['download', className]}>
  <a
    class:list={['btn', 'btn--primary', size === 'lg' && 'download__lg']}
    href={site.downloads.windows}
  >
    <Icon name="brand-windows" size={20} />
    Download for Windows
  </a>
  <a class="download__guide" href="/download">
    Setup guide
  </a>
</div>
<style>
  .download {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem var(--sp-3);
  }
  .download__lg {
    --btn-h: 3.5rem;
    padding-inline: var(--sp-3) var(--sp-5);
    font-size: var(--s1);
  }
  .download__guide {
    font-weight: 500;
  }
</style>
