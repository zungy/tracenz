---
/**
 * The primary action: download the desktop app for the visitor's system.
 * Both variants are rendered; a small script shows the macOS one on a Mac.
 * While a download URL in src/config/site.ts is null, clicking explains that
 * the download isn't available yet.
 */
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  /** Show a text link to the other system under the button. */
  other?: boolean;
  size?: 'md' | 'lg';
  class?: string;
}

const { other = false, size = 'md', class: className } = Astro.props;

const platforms = {
  windows: { label: 'Windows', icon: 'brand-windows', url: site.downloads.windows },
  macos: { label: 'macOS', icon: 'brand-apple', url: site.downloads.macos },
} as const;
type Os = keyof typeof platforms;
const pending = (os: Os) =>
  platforms[os].url ? undefined : `The ${platforms[os].label} download isn't available yet.`;
const systems: Os[] = ['windows', 'macos'];
---

{systems.map((os) => {
  const alt: Os = os === 'windows' ? 'macos' : 'windows';
  return (
    <div class:list={['download', className]} data-os={os} hidden={os === 'macos'}>
      <a
        class:list={['btn', 'btn--primary', size === 'lg' && 'download__lg']}
        href={platforms[os].url ?? '#download'}
        data-pending={pending(os)}
      >
        <Icon name={platforms[os].icon} size={20} />
        Download for {platforms[os].label}
      </a>
      {other && (
        <a
          class="download__other"
          href={platforms[alt].url ?? '#download'}
          data-pending={pending(alt)}
        >
          or for {platforms[alt].label}
        </a>
      )}
    </div>
  );
})}

<script>
  // Offer the visitor's own system first.
  const nav = navigator as Navigator & { userAgentData?: { platform?: string } };
  const platform = nav.userAgentData?.platform || navigator.platform || navigator.userAgent;
  if (/mac/i.test(platform)) {
    for (const el of document.querySelectorAll<HTMLElement>('.download[data-os]')) {
      el.hidden = el.dataset.os !== 'macos';
    }
  }
</script>

<style>
  .download {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem var(--sp-2);
  }

  .download[hidden] {
    display: none;
  }

  .download__lg {
    --btn-h: 3.5rem;
    padding-inline: var(--sp-5);
    font-size: var(--s1);
  }

  .download__other {
    font-size: var(--s-1);
  }
</style>
