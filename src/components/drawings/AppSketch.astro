---
/**
 * Line drawing of the setup Trace is built for: a CAD window with the
 * orbital sander housing in the viewport, drawn as a wireframe, and the
 * Trace panel docked on the right, logging changes. Generic on purpose: no
 * CAD vendor's interface is copied.
 *
 * The wireframe is projected from millimetres: the housing is a body of
 * revolution (pad, skirt, tapered body, dome) seen from above and to the
 * front right. For each horizontal circle the far half is drawn as a hidden
 * line.
 */
const W = 760;
const H = 468;
const dock = 520; // x where the Trace panel starts

// Orthographic view: turned 30° about the vertical axis, looking down 24°.
const az = (30 * Math.PI) / 180;
const el = (24 * Math.PI) / 180;
const s = 1.75; // SVG units per millimetre
const origin = { x: 282, y: 350 };
const project = (x: number, y: number, z: number) => {
  const xr = x * Math.cos(az) - y * Math.sin(az);
  const yr = x * Math.sin(az) + y * Math.cos(az);
  return {
    x: origin.x + xr * s,
    y: origin.y - z * Math.cos(el) * s - yr * Math.sin(el) * s,
    depth: yr,
  };
};
const f = (n: number) => n.toFixed(1);

// A horizontal circle, split into its near (visible) and far (hidden) halves.
function ring(r: number, z: number) {
  const near: string[] = [];
  const far: string[] = [];
  let prev: 'near' | 'far' | null = null;
  for (let i = 0; i <= 96; i++) {
    const t = (i / 96) * Math.PI * 2;
    const p = project(r * Math.cos(t), r * Math.sin(t), z);
    const side = p.depth > 0 ? 'far' : 'near';
    const list = side === 'near' ? near : far;
    list.push(`${side === prev ? 'L' : 'M'}${f(p.x)} ${f(p.y)}`);
    prev = side;
  }
  return { near: near.join(''), far: far.join('') };
}

// Silhouette edge of a surface of revolution between two heights: the
// outline at the left and right extremes of each circle.
function sides(profile: [number, number][]) {
  const left = profile.map(([r, z]) => {
    const p = project(0, 0, z);
    return `${f(p.x - r * s)} ${f(p.y)}`;
  });
  const right = profile.map(([r, z]) => {
    const p = project(0, 0, z);
    return `${f(p.x + r * s)} ${f(p.y)}`;
  });
  return `M${left.join('L')}M${right.join('L')}`;
}

// Housing profile, radius by height (mm).
const pad = { r: 62.5, z0: 0, z1: 12 };
const skirt = { r: 60, z0: 16, z1: 44 };
const bodyProfile: [number, number][] = Array.from({ length: 13 }, (_, i) => {
  const z = 44 + (i / 12) * 52; // 44 → 96
  const r = 60 - 13 * Math.pow(i / 12, 1.6);
  return [r, z];
});
// The dome's outline: the upper envelope of its circles in this view.
const domeCircles = Array.from({ length: 40 }, (_, i) => {
  const a = (i / 39) * (Math.PI / 2);
  return { r: 47 * Math.cos(a), z: 96 + 29 * Math.sin(a) };
});
const domeOutline = (() => {
  const pts: string[] = [];
  const c = project(0, 0, 0);
  for (let i = 0; i <= 60; i++) {
    const X = -47 + (i / 60) * 94; // screen offset in mm
    let top = Infinity;
    for (const { r, z } of domeCircles) {
      if (Math.abs(X) > r) continue;
      // The ellipse of this circle: center height and half-height in mm.
      const cy = -z * Math.cos(el);
      const ry = r * Math.sin(el);
      const y = cy - ry * Math.sqrt(1 - (X / r) ** 2);
      top = Math.min(top, y);
    }
    if (top === Infinity) continue;
    pts.push(`${f(c.x + X * s)} ${f(c.y + top * s)}`);
  }
  return `M${pts.join('L')}`;
})();

const rings = [
  ring(pad.r, pad.z0),
  ring(pad.r, pad.z1),
  ring(skirt.r, skirt.z0),
  ring(skirt.r, skirt.z1),
  ring(47, 96),
];
const padSides = sides([
  [pad.r, pad.z0],
  [pad.r, pad.z1],
]);
const skirtSides = sides([
  [skirt.r, skirt.z0],
  [skirt.r, skirt.z1],
]);
const bodySides = sides(bodyProfile);

// Dust port: a short tube along the housing's -x axis at 31 mm.
const portRing = (x: number) => {
  const pts = Array.from({ length: 49 }, (_, i) => {
    const t = (i / 48) * Math.PI * 2;
    const p = project(x, 11 * Math.cos(t), 31 + 11 * Math.sin(t));
    return `${f(p.x)} ${f(p.y)}`;
  });
  return `M${pts.join('L')}`;
};
const portEnd = portRing(-96);
const portLines = [
  [0, 11],
  [0, -11],
  [11, 0],
  [-11, 0],
]
  .map(([dy, dz]) => {
    const a = project(-58, dy, 31 + dz);
    const b = project(-96, dy, 31 + dz);
    return `M${f(a.x)} ${f(a.y)}L${f(b.x)} ${f(b.y)}`;
  })
  .join('');

// Three vents on the near side of the tapered body, as short arcs on its surface.
const bodyRadius = (z: number) => 60 - 13 * Math.pow((z - 44) / 52, 1.6);
const vents = [62, 68, 74]
  .map((z) => {
    const pts = Array.from({ length: 13 }, (_, i) => {
      const t = ((188 + i * 2.5) * Math.PI) / 180;
      const r = bodyRadius(z);
      const p = project(r * Math.cos(t), r * Math.sin(t), z);
      return `${f(p.x)} ${f(p.y)}`;
    });
    return `M${pts.join('L')}`;
  })
  .join('');

// Ground grid on the XY plane, 30 mm squares, as a CAD viewport shows it.
const ground = [-90, -60, -30, 0, 30, 60, 90]
  .map((v) => {
    const a1 = project(v, -90, 0);
    const b1 = project(v, 90, 0);
    const a2 = project(-90, v, 0);
    const b2 = project(90, v, 0);
    return `M${f(a1.x)} ${f(a1.y)}L${f(b1.x)} ${f(b1.y)}M${f(a2.x)} ${f(a2.y)}L${f(b2.x)} ${f(b2.y)}`;
  })
  .join('');

const axisBase = project(0, 0, 0);
const up = project(0, 0, 150);

// Axis triad in the viewport corner.
const triad = { x: 48, y: 432, len: 24 };
const axisDir = (x: number, y: number, z: number) => {
  const p = project(x, y, z);
  const o = project(0, 0, 0);
  const dx = p.x - o.x;
  const dy = p.y - o.y;
  const n = Math.hypot(dx, dy);
  return { x: (dx / n) * triad.len, y: (dy / n) * triad.len };
};
const axes = [
  { name: 'X', d: axisDir(1, 0, 0) },
  { name: 'Y', d: axisDir(0, 1, 0) },
  { name: 'Z', d: axisDir(0, 0, 1) },
];

// The Trace panel's log, newest first.
const log = [
  { t: '10:26', what: 'Hole 3', change: 'Ø8 → Ø9' },
  { t: '10:24', what: 'Pattern 1', change: '6 → 8' },
  { t: '10:20', what: 'Housing', change: 'PC-ABS' },
  { t: '10:02', what: 'Motor bracket', change: 'added' },
  { t: '09:31', what: 'Fillet 7', change: 'R2' },
  { t: '09:12', what: 'Sketch 4', change: '2.5 mm' },
];
const tools = Array.from({ length: 9 }, (_, i) => 16 + i * 30);
---

<svg class="app" viewBox={`0 0 ${W} ${H}`} role="img" aria-labelledby="app-title">
  <title id="app-title">
    A CAD window with the sander housing open, and the Trace panel docked beside it, logging each
    change.
  </title>

  <!-- Window -->
  <rect class="frame" x="0.75" y="0.75" width={W - 1.5} height={H - 1.5} rx="4"></rect>
  <path class="rule" d={`M0 30H${W}M0 62H${dock}`}></path>
  <g class="dots">
    <circle cx="18" cy="15.5" r="4"></circle>
    <circle cx="32" cy="15.5" r="4"></circle>
    <circle cx="46" cy="15.5" r="4"></circle>
  </g>
  <text class="small" x={W / 2} y="20" text-anchor="middle">
    orbital-sander · housing
  </text>

  <!-- Toolbar -->
  {tools.map((x) => (
    <rect class="tool" x={x} y="39" width="16" height="16" rx="2" />
  ))}

  <!-- Viewport -->
  <path class="ground" d={ground}></path>
  <path class="grid" d={`M${f(axisBase.x)} ${f(axisBase.y + 24)}V${f(up.y)}`}></path>
  <g class="hidden">
    {rings.map((r) => (
      <path d={r.far} />
    ))}
  </g>
  <g class="wire">
    {rings.map((r) => (
      <path d={r.near} />
    ))}
    <path d={padSides}></path>
    <path d={skirtSides}></path>
    <path d={bodySides}></path>
    <path d={domeOutline}></path>
    <path d={portEnd}></path>
    <path d={portLines}></path>
    <path d={vents}></path>
  </g>

  <g class="triad" transform={`translate(${triad.x} ${triad.y})`}>
    {axes.map((a) => (
      <>
        <path d={`M0 0L${f(a.d.x)} ${f(a.d.y)}`} />
        <text class="small" x={f(a.d.x * 1.45)} y={f(a.d.y * 1.45 + 4)} text-anchor="middle">
          {a.name}
        </text>
      </>
    ))}
  </g>

  <!-- Trace panel -->
  <path class="rule rule--strong" d={`M${dock} 30V${H}`}></path>
  <rect class="logo" x={dock + 18} y="46" width="14" height="14" rx="1"></rect>
  <text class="panel-title" x={dock + 40} y="58">
    Trace
  </text>
  <circle class="live" cx={W - 76} cy="53.5" r="3"></circle>
  <text class="small" x={W - 66} y="58">
    Logging
  </text>
  <path class="rule" d={`M${dock} 74H${W}`}></path>
  <text class="small muted" x={dock + 18} y="96">
    Latest changes
  </text>
  {log.map((row, i) => (
    <g transform={`translate(${dock + 18} ${120 + i * 36})`}>
      <text class="small muted" x="0" y="0">
        {row.t}
      </text>
      <text class="row" x="46" y="0">
        {row.what}
      </text>
      <text class="small" x={W - dock - 36} y="0" text-anchor="end">
        {row.change}
      </text>
      <path class="rule rule--soft" d={`M0 14H${W - dock - 36}`} />
    </g>
  ))}
  <rect class="button" x={dock + 18} y={H - 62} width={W - dock - 36} height="40" rx="2"></rect>
  <text class="button-label" x={dock + (W - dock) / 2} y={H - 37} text-anchor="middle">
    Write design document
  </text>
</svg>

<style>
  .app {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .app :global(*) {
    vector-effect: non-scaling-stroke;
  }

  /* The window is opaque, so the sheet's grid stops at its frame. */
  .frame {
    fill: var(--bg);
    stroke: var(--text-strong);
    stroke-width: 1.5;
  }

  .rule {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .rule--strong {
    stroke: var(--text-strong);
  }

  .rule--soft {
    stroke: var(--line);
  }

  .dots circle,
  .tool {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
  }

  .grid {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 0.75;
    stroke-dasharray: 18 4 3 4;
  }

  .ground {
    fill: none;
    stroke: var(--line);
    stroke-width: 0.75;
  }

  .wire path {
    fill: none;
    stroke: var(--text-strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
    stroke-linecap: round;
  }

  .hidden path {
    fill: none;
    stroke: var(--line-strong);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }

  .triad path {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.25;
  }

  .small,
  .row,
  .panel-title,
  .button-label {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text);
  }

  .muted {
    fill: var(--text-muted);
  }

  .row {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    fill: var(--text-strong);
  }

  .panel-title {
    font-family: var(--font-body);
    font-size: 15px;
    font-weight: 600;
    fill: var(--text-strong);
  }

  .logo,
  .live {
    fill: var(--text-strong);
  }

  .button {
    fill: none;
    stroke: var(--text-strong);
    stroke-width: 1.25;
  }

  .button-label {
    font-family: var(--font-body);
    font-size: 14px;
    font-weight: 600;
    fill: var(--text-strong);
  }
</style>
