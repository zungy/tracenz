---
/**
 * View B: the sanding pad from below. The new pattern of eight Ø9 holes is
 * drawn solid; the old pattern of six Ø8 holes stays as hidden lines. Drawn
 * in ink only, like WallSection.
 */
const cx = 118;
const cy = 110;
const mm = 1.5;
const pad = 62.5 * mm;
const pitch = 42 * mm;

const ring = (count: number, offsetDeg: number, r: number) =>
  Array.from({ length: count }, (_, i) => {
    const a = ((offsetDeg + (i * 360) / count) * Math.PI) / 180;
    return { x: cx + pitch * Math.cos(a), y: cy + pitch * Math.sin(a), r };
  });

const newHoles = ring(8, 22.5, 4.5 * mm);
const oldHoles = ring(6, 0, 4 * mm);
const called = newHoles[7]; // upper right
const f = (n: number) => n.toFixed(1);
const tip = { x: called.x + 4.5 * mm * 0.7, y: called.y - 4.5 * mm * 0.7 };

interface Props {
  /** Id prefix, so the drawing can appear twice on a page. */
  id?: string;
}

const { id = 'holes' } = Astro.props;
---

<svg class="drawing" viewBox="0 0 320 220" role="img" aria-labelledby={`${id}-title`}>
  <title id={`${id}-title`}>
    Pad seen from below: eight 9 millimetre dust holes, equally spaced, replacing six 8
    millimetre holes.
  </title>

  <path
    class="chain"
    d={`M${f(cx - pad - 12)} ${cy}H${f(cx + pad + 12)}M${cx} ${f(cy - pad - 12)}V${f(cy + pad + 12)}`}
  ></path>
  <circle class="chain" cx={cx} cy={cy} r={f(pitch)}></circle>
  <circle class="visible" cx={cx} cy={cy} r={f(pad)}></circle>

  {oldHoles.map((h) => (
    <circle class="hidden" cx={f(h.x)} cy={f(h.y)} r={f(h.r)} />
  ))}
  {newHoles.map((h) => (
    <circle class="visible" cx={f(h.x)} cy={f(h.y)} r={f(h.r)} />
  ))}

  <path class="leader" d={`M${f(tip.x)} ${f(tip.y)} L226 36 H236`}></path>
  <circle class="dot" cx={f(tip.x)} cy={f(tip.y)} r="2"></circle>

  <g transform="translate(236 18)">
    <text class="old" x="0" y="0">
      6× Ø8
    </text>
    <path class="strike" d="M-1 -4.5H44"></path>
    <rect class="chip" x="-2" y="8" width="72" height="20" rx="1"></rect>
    <text class="new" x="34" y="22.5" text-anchor="middle">
      8× Ø9
    </text>
    <text class="note" x="0" y="44">
      EQ SP
    </text>
    <path class="tag" d="M60 34l10.5 18h-21z"></path>
    <text class="tag-letter" x="60" y="49" text-anchor="middle">
      B
    </text>
  </g>

  <text class="callout" x={cx - pad} y="214">
    PCD Ø84
  </text>
</svg>

<style>
  .drawing {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .drawing :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .visible {
    fill: none;
    stroke: var(--text-strong);
    stroke-width: 2;
  }

  .hidden {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1;
    stroke-dasharray: 3 2.5;
  }

  .chain {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1;
    stroke-dasharray: 16 4 2.5 4;
  }

  .leader {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1;
  }

  .dot {
    fill: var(--text-muted);
  }

  .old,
  .note {
    font-family: var(--font-mono);
    font-size: 13px;
    fill: var(--text-faint);
  }

  .note {
    font-size: 12px;
    letter-spacing: 0.06em;
    fill: var(--text-muted);
  }

  .strike {
    stroke: var(--text-muted);
    stroke-width: 1;
  }

  .chip,
  .tag {
    fill: none;
    stroke: var(--text-strong);
    stroke-width: 1.25;
    stroke-linejoin: round;
  }

  .new {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 600;
    fill: var(--text-strong);
  }

  .tag-letter {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 600;
    fill: var(--text-strong);
  }

  .callout {
    font-family: var(--font-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.06em;
    fill: var(--text-muted);
  }
</style>
