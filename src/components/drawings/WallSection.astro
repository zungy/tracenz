---
/**
 * Section A–A, enlarged: the motor-mount rib where it meets the housing wall.
 * The rib's old top edge (2.0 mm) is a hidden line under the new one (2.5 mm).
 */
const s = 8; // SVG units per millimetre
const wallX = 236; // inner face of the housing wall
const ribBottom = 132;
const ribTop = ribBottom - 2.5 * s; // 112
const oldTop = ribBottom - 2.0 * s; // 116
const bossX = 44;
const dimX = 150;
---

<svg class="drawing" viewBox="0 0 320 220" role="img" aria-labelledby="wall-title">
  <title id="wall-title">
    Section through the motor mount rib: the rib is now 2.5 millimetres thick, up from 2.0.
  </title>
  <defs>
    <pattern
      id="wall-hatch"
      width="7"
      height="7"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line x1="0" y1="0" x2="0" y2="7" class="hatch"></line>
    </pattern>
  </defs>

  <!-- Housing wall, cut top and bottom with break lines -->
  <path
    class="cut"
    fill="url(#wall-hatch)"
    d={`M${wallX} 18 L${wallX + 20} 18 L${wallX + 20} 202 L${wallX} 202 Z`}
  ></path>
  <path class="break" d={`M${wallX - 6} 18 l6 -5 l10 10 l10 -10 l6 5`}></path>
  <path class="break" d={`M${wallX - 6} 202 l6 -5 l10 10 l10 -10 l6 5`}></path>

  <!-- Rib and boss, with fillets into the wall -->
  <path
    class="cut"
    fill="url(#wall-hatch)"
    d={`M${bossX} ${ribTop} H${wallX - 10} Q${wallX} ${ribTop} ${wallX} ${ribTop - 10} V${ribBottom + 10} Q${wallX} ${ribBottom} ${wallX - 10} ${ribBottom} H${bossX + 20} V196 H${bossX} Z`}
  ></path>
  <path class="break" d={`M${bossX - 6} 196 l6 -5 l10 10 l10 -10 l6 5`}></path>

  <!-- Old top edge of the rib: 2.0 mm -->
  <path class="hidden" d={`M${bossX + 20} ${oldTop} H${wallX - 8}`}></path>

  <!-- Thickness dimension, arrows from outside -->
  <path class="thin" d={`M${dimX} ${ribTop - 30} V${ribTop - 1}`}></path>
  <path class="thin" d={`M${dimX} ${ribBottom + 1} V${ribBottom + 30}`}></path>
  <path
    class="arrow"
    d={`M${dimX} ${ribTop} l-3.2 -10 h6.4z M${dimX} ${ribBottom} l-3.2 10 h6.4z`}
  ></path>

  <g transform={`translate(${dimX + 12} ${ribTop - 42})`}>
    <text class="old" x="0" y="14">
      2.0
    </text>
    <path class="strike" d="M-1 9.5H24"></path>
    <rect class="chip" x="30" y="-1" width="36" height="20" rx="1"></rect>
    <text class="new" x="48" y="14" text-anchor="middle">
      2.5
    </text>
    <path class="tag" d="M82 -1.5l10.5 18h-21z"></path>
    <text class="tag-letter" x="82" y="13.5" text-anchor="middle">
      B
    </text>
  </g>

  <!-- Section label on the cut face -->
  <text class="callout" x={bossX} y="46">
    RIB
  </text>
  <path class="thin" d={`M${bossX + 22} 42 L${bossX + 60} ${ribTop + 6}`}></path>
  <circle class="dot" cx={bossX + 60} cy={ribTop + 6} r="2"></circle>
</svg>

<style>
  .drawing {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .drawing :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .cut {
    stroke: var(--text-strong);
    stroke-width: 2;
    stroke-linejoin: round;
  }

  .hatch {
    stroke: var(--text-muted);
    stroke-width: 0.6;
  }

  .break,
  .thin {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1;
    stroke-linejoin: round;
  }

  .hidden {
    fill: none;
    stroke: var(--change);
    stroke-width: 1.25;
    stroke-dasharray: 5 3;
  }

  .arrow,
  .dot {
    fill: var(--text-muted);
  }

  .old {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--text-faint);
  }

  .strike {
    stroke: var(--change);
    stroke-width: 1.5;
  }

  .chip,
  .tag {
    fill: var(--change);
  }

  .new {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    fill: var(--on-change);
  }

  .tag-letter {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    fill: var(--on-change);
  }

  .callout {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    fill: var(--text-muted);
  }
</style>
