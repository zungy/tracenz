---
/**
 * Orbital sander housing, front elevation in half section: exterior on the
 * left, section on the right showing the wall and the motor-mount rib, whose
 * thickness changed in revision B. Coordinates are in millimetres (y up from
 * the underside of the pad) and mapped to SVG units below.
 */
interface Props {
  /** Id prefix so two drawings can share a page. */
  id?: string;
}

const { id = 'elev' } = Astro.props;

const k = 2.2; // SVG units per millimetre
const cx = 232; // centerline
const base = 336; // underside of the pad
const X = (mm: number) => +(cx + mm * k).toFixed(1);
const Y = (mm: number) => +(base - mm * k).toFixed(1);
const P = (x: number, y: number) => `${X(x)} ${Y(y)}`;

// Housing profile: skirt, tapered body, dome. Wall thickness t.
const t = 2.5;
const outerLeft = `M${P(0, 125)} A${47 * k} ${29 * k} 0 0 0 ${P(-47, 96)} Q${P(-58.5, 80)} ${P(-60, 44)} L${P(-60, 16)}`;
const sectionWall =
  `M${P(0, 125)} A${47 * k} ${29 * k} 0 0 1 ${P(47, 96)} Q${P(58.5, 80)} ${P(60, 44)} L${P(60, 16)} ` +
  `L${P(60 - t, 16)} L${P(60 - t, 44)} Q${P(58.5 - t, 80)} ${P(47 - t, 96)} ` +
  `A${(47 - t) * k} ${(29 - t) * k} 0 0 0 ${P(0, 125 - t)} Z`;
const rib = `M${P(12, 60)} H${X(54)} V${Y(60 + t)} H${X(12)} Z`;
const boss = `M${P(12, 44)} H${X(12 + t)} V${Y(60)} H${X(12)} Z`;

// Callout for the changed wall, placed to the right of the housing.
const ribTarget = { x: X(34), y: Y(60 + t) };
const note = { x: 382, y: 44 };
const leaderStart = { x: note.x - 6, y: note.y + 26 };

// Filled arrowhead with its tip on `to`, aligned with the line from `from`.
function arrowhead(from: { x: number; y: number }, to: { x: number; y: number }) {
  const len = Math.hypot(to.x - from.x, to.y - from.y);
  const ux = (to.x - from.x) / len;
  const uy = (to.y - from.y) / len;
  const bx = to.x - ux * 10;
  const by = to.y - uy * 10;
  const f = (n: number) => n.toFixed(1);
  return `M${f(to.x)} ${f(to.y)}L${f(bx - uy * 3.2)} ${f(by + ux * 3.2)}L${f(bx + uy * 3.2)} ${f(by - ux * 3.2)}Z`;
}
const leaderEnd = (() => {
  const len = Math.hypot(ribTarget.x - leaderStart.x, ribTarget.y - leaderStart.y);
  return {
    x: ribTarget.x - ((ribTarget.x - leaderStart.x) / len) * 9,
    y: ribTarget.y - ((ribTarget.y - leaderStart.y) / len) * 9,
  };
})();
---

<svg class="elev" viewBox="0 0 520 400" role="img" aria-labelledby={`${id}-title ${id}-desc`}>
  <title id={`${id}-title`}>Orbital sander housing, front elevation in half section</title>
  <desc id={`${id}-desc`}>
    The right half is cut away to show the housing wall and the motor mount rib, whose wall was
    thickened from 2.0 to 2.5 millimetres in revision B. The pad is 125 millimetres across.
  </desc>
  <defs>
    <pattern
      id={`${id}-hatch`}
      width="6"
      height="6"
      patternUnits="userSpaceOnUse"
      patternTransform="rotate(45)"
    >
      <line x1="0" y1="0" x2="0" y2="6" class="hatch"></line>
    </pattern>
  </defs>

  <!-- Centerline -->
  <path class="chain" d={`M${X(0)} ${Y(-8)}V${Y(133)}`}></path>

  <!-- Pad and hub (not sectioned) -->
  <path
    class="visible"
    d={`M${X(-62.5)} ${Y(12)} V${Y(1.5)} Q${P(-62.5, 0)} ${P(-61, 0)} H${X(61)} Q${P(62.5, 0)} ${P(62.5, 1.5)} V${Y(12)} Z`}
  ></path>
  <path class="thin" d={`M${P(-62.5, 3.5)} H${X(62.5)}`}></path>
  <path class="visible" d={`M${P(-18, 12)} V${Y(16)} M${P(18, 12)} V${Y(16)}`}></path>

  <!-- Exterior half (left) -->
  <path class="visible" d={outerLeft}></path>
  <path class="visible" d={`M${P(-60, 16)} H${X(0)}`}></path>
  <path class="thin" d={`M${P(-47, 96)} H${X(0)}`}></path>
  <rect class="thin" x={X(-36)} y={Y(88)} width={14 * k} height={6 * k} rx="3"></rect>
  <path
    class="thin"
    d={`M${P(-49, 64)} H${X(-37)} M${P(-49, 69)} H${X(-37)} M${P(-49, 74)} H${X(-37)}`}
  ></path>

  <!-- Dust port (left) with its own centerline -->
  <path
    class="visible"
    d={`M${P(-59.5, 22)} H${X(-88)} V${Y(20)} H${X(-92)} V${Y(42)} H${X(-88)} V${Y(40)} H${X(-59.8)}`}
  ></path>
  <path class="chain" d={`M${P(-98, 31)} H${X(-52)}`}></path>

  <!-- Section half (right): wall, rib and boss, hatched -->
  <path class="section" d={sectionWall} fill={`url(#${id}-hatch)`}></path>
  <path class="section" d={rib} fill={`url(#${id}-hatch)`}></path>
  <path class="section" d={boss} fill={`url(#${id}-hatch)`}></path>
  <path class="visible" d={`M${P(0, 16)} H${X(60)}`}></path>

  <!-- Pad diameter -->
  <path class="thin" d={`M${P(-62.5, -1)} V${Y(-12)} M${P(62.5, -1)} V${Y(-12)}`}></path>
  <path class="thin" d={`M${X(-62.5) + 9} ${Y(-9)} H${X(62.5) - 9}`}></path>
  <path class="arrow" d={`M${X(-62.5)} ${Y(-9)} l9 -3v6z M${X(62.5)} ${Y(-9)} l-9 -3v6z`}></path>
  <text class="dim" x={X(0) + 8} y={Y(-9) - 6}>
    Ø125
  </text>

  <!-- Change callout: leader, note, revision tag -->
  <path
    class="leader"
    d={`M${leaderStart.x} ${leaderStart.y} L${leaderEnd.x.toFixed(1)} ${leaderEnd.y.toFixed(1)}`}
  ></path>
  <path class="arrow arrow--change" d={arrowhead(leaderStart, ribTarget)}></path>
  <g class="note" transform={`translate(${note.x} ${note.y})`}>
    <text class="note__label" x="0" y="0">
      MOTOR MOUNT WALL
    </text>
    <text class="note__old" x="0" y="26">
      2.0
    </text>
    <path class="note__strike" d="M-1 21.5H24"></path>
    <path class="note__arrow" d="M31 22H45M41 18.5l4 3.5l-4 3.5"></path>
    <rect class="note__chip" x="51" y="10" width="36" height="21" rx="1"></rect>
    <text class="note__new" x="69" y="25.5" text-anchor="middle">
      2.5
    </text>
    <path class="note__tag" d="M103 8.5l10.5 18h-21z"></path>
    <text class="note__tag-letter" x="103" y="24" text-anchor="middle">
      B
    </text>
    <rect x="51" y="8" width="64" height="23" fill="none" data-trace="source"></rect>
  </g>
</svg>

<style>
  .elev {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .elev :global(*) {
    vector-effect: non-scaling-stroke;
  }

  .visible {
    fill: none;
    stroke: var(--text-strong);
    stroke-width: 1.75;
    stroke-linejoin: round;
  }

  /* Cut faces take the hatch pattern from their fill attribute. */
  .section {
    stroke: var(--text-strong);
    stroke-width: 1.5;
    stroke-linejoin: round;
  }

  .thin,
  .leader {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1;
  }

  .leader {
    stroke: var(--change);
  }

  .chain {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1;
    stroke-dasharray: 18 4 3 4;
  }

  .hidden {
    fill: none;
    stroke: var(--text-faint);
    stroke-width: 1;
    stroke-dasharray: 4 3;
  }

  .hatch {
    stroke: var(--text-muted);
    stroke-width: 0.8;
  }

  .arrow {
    fill: var(--text-muted);
  }

  .arrow--change {
    fill: var(--change);
  }

  .dim {
    font-family: var(--font-mono);
    font-size: 13px;
    font-weight: 500;
    fill: var(--text-strong);
  }

  .note__label {
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    letter-spacing: 0.06em;
    fill: var(--text-muted);
  }

  .note__old {
    font-family: var(--font-mono);
    font-size: 15px;
    fill: var(--text-faint);
  }

  .note__strike {
    stroke: var(--text-faint);
    stroke-width: 1.25;
  }

  .note__arrow {
    fill: none;
    stroke: var(--text-muted);
    stroke-width: 1.25;
  }

  .note__chip {
    fill: var(--change);
  }

  .note__new {
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 600;
    fill: var(--on-change);
  }

  .note__tag {
    fill: var(--change);
  }

  .note__tag-letter {
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 600;
    fill: var(--on-change);
  }
</style>
