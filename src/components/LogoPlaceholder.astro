---
/**
 * Placeholder for the Trace logo until the real artwork is supplied: a plain
 * solid mark that holds the logo's place without pretending to be one.
 * Replace this component's output with the real logo.
 */
interface Props {
  size?: number;
  /** Accessible name. Pass an empty string when surrounding text names it. */
  label?: string;
  class?: string;
}

const { size = 24, label = 'Logo placeholder', class: className } = Astro.props;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const };
---

<svg
  class:list={['logo-placeholder', className]}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  {...a11y}
>
  <rect width="24" height="24" rx="2" fill="currentColor"></rect>
</svg>

<style>
  .logo-placeholder {
    flex: none;
    color: var(--text-strong);
  }
</style>
