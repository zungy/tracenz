---
/**
 * Placeholder for a logo that hasn't been supplied yet. Drawn with the
 * hidden-line dash of a technical drawing so it reads as "to be added".
 * Replace usages with the real artwork when it exists.
 */
interface Props {
  size?: number;
  /** Width-to-height ratio, for wordmark-shaped slots. */
  ratio?: number;
  /** Accessible name. Pass an empty string when surrounding text names it. */
  label?: string;
  class?: string;
}

const { size = 28, ratio = 1, label = 'Logo placeholder', class: className } = Astro.props;
const w = Math.round(size * ratio);
const h = size;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const };
---

<svg
  class:list={['logo-placeholder', className]}
  width={w}
  height={h}
  viewBox={`0 0 ${w} ${h}`}
  {...a11y}
>
  <rect
    x="0.75"
    y="0.75"
    width={w - 1.5}
    height={h - 1.5}
    rx="2"
    fill="none"
    stroke="currentColor"
    stroke-width="1.5"
    stroke-dasharray="4 3"
  ></rect>
  <path
    d={`M0.75 0.75 L${w - 0.75} ${h - 0.75} M${w - 0.75} 0.75 L0.75 ${h - 0.75}`}
    stroke="currentColor"
    stroke-width="1"
    opacity="0.55"
  ></path>
</svg>

<style>
  .logo-placeholder {
    flex: none;
    color: var(--line-strong);
  }
</style>
