---
/** Trace's square/grid/diagonal mark, shared with the desktop app. */
interface Props {
  size?: number;
  /** Accessible name. Pass an empty string when surrounding text names it. */
  label?: string;
  class?: string;
}

const { size = 24, label = 'Trace', class: className } = Astro.props;
const a11y = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const };
---

<svg
  class:list={['trace-mark', className]}
  width={size}
  height={size}
  viewBox="0 0 28 28"
  {...a11y}
>
  <path
    d="M4 4h20v20H4zM4 14h20M14 4v20M4 24 24 4"
    fill="none"
    stroke="currentColor"
    stroke-width="1.3"
  ></path>
</svg>

<style>
  .trace-mark {
    flex: none;
    color: var(--text-strong);
  }
</style>
