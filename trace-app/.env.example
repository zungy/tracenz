# Local mode is restricted to loopback and has no cloud dependencies.
TRACE_MODE=local
PORT=4318
HOST=127.0.0.1
TRACE_DATA_DIR=.data
TRACE_AI=deterministic

# Hosted backend: set TRACE_MODE=supabase, TRACE_AI=openai and HOST=0.0.0.0.
# Serve behind HTTPS. Create users through Supabase Auth, then sign in in Trace.
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
# OPENAI_API_KEY=
# OPENAI_MODEL=your-vision-and-structured-output-model
# TRACE_PUBLIC_ORIGIN=https://trace-api.example.com

# Desktop: defaults to bundled tracenz cloud and always starts the local Fusion receiver.
# TRACE_API_URL=https://sbupyqgysoznucelwsij.supabase.co/functions/v1/trace
